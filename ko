-- ║  🃏 Row (การ์ด)                                            ║
-- ╚══════════════════════════════════════════════════════════╝
local function Row(win, page, height, clip)
    local f = New("Frame", {
        Size = UDim2.new(1, 0, 0, height or 36),
        BorderSizePixel = 0, ClipsDescendants = clip == true, Parent = page,
    }, {Corner(9)})
    Bind(win, f, "BackgroundColor3", "Element")
    local stroke = New("UIStroke", {Thickness = 1, Transparency = 0.35, Parent = f})
    Bind(win, stroke, "Color", "Stroke")

    local hl = New("Frame", {
        Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.94, BorderSizePixel = 0, Parent = f, ZIndex = 0,
    }, {Corner(9)})
    New("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = hl,
    })

    if win._rows then table.insert(win._rows, f) end
    -- ถ้ามีพื้นหลังรูปอยู่แล้ว ให้การ์ดใหม่โปร่งแบบ glass ทันที
    if win.BgImage and win.BgImage.Visible then
        f.BackgroundTransparency = HelloHub.Glass.Card
    end
    return f, stroke
end

