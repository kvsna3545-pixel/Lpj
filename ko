local function ResolveThemeName(n)
    if n == "Auto" then
        local ok, d = pcall(os.date, "*t")
        if ok and type(d) == "table" and d.month == 10 and d.day >= 6 and d.day <= 30 then
            return "Halloween"
        end
        return "Hello"
    end
    if type(n) == "string" and HelloHub.Themes[n] then return n end
    return nil
end

