HELLO.Effects = {}

--=========================================================
-- GLOW
--=========================================================
function HELLO.Effects:Glow(Object, Color)
    if not Object or not Object.Parent then return end
    Color = Color or HELLO.Theme.Primary

    local Stroke = Object:FindFirstChild("HELLO_Glow")
    if not Stroke then
        Stroke = Instance.new("UIStroke")
        Stroke.Name         = "HELLO_Glow"
        Stroke.Thickness    = 1
        Stroke.Transparency = 0.8
        Stroke.Color        = Color
        Stroke.Parent       = Object
    end

    PlayTween(Stroke, 0.25, { Transparency = 0.12, Thickness = 2 })
    return Stroke
end

--=========================================================
-- PULSE
--=========================================================
function HELLO.Effects:Pulse(Object)
    if not Object then return end
    local Scale = Object:FindFirstChild("HELLO_PulseScale")
    if not Scale then
        Scale = Instance.new("UIScale")
        Scale.Name   = "HELLO_PulseScale"
        Scale.Scale  = 1
        Scale.Parent = Object
    end

    task.spawn(function()
        while Object.Parent do
            local Tween1 = PlayTween(Scale, 0.7, { Scale = 1.025 },
                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            Tween1.Completed:Wait()
            if not Object.Parent then break end
            local Tween2 = PlayTween(Scale, 0.7, { Scale = 1 },
                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            Tween2.Completed:Wait()
        end
    end)
end

--=========================================================
-- SHAKE
--=========================================================
function HELLO.Effects:Shake(Object, Strength)
    if not Object then return end
    Strength = Strength or 4
    local Original = Object.Position
    task.spawn(function()
        for i = 1, 8 do
            if not Object.Parent then return end
            local X = math.random(-Strength, Strength)
            local Y = math.random(-Strength, Strength)
            Object.Position = UDim2.new(
                Original.X.Scale, Original.X.Offset + X,
                Original.Y.Scale, Original.Y.Offset + Y
            )
            task.wait(0.035)
        end
        if Object.Parent then Object.Position = Original end
    end)
end

--=========================================================
-- RAINBOW
--=========================================================
function HELLO.Effects:Rainbow(Object)
    if not Object then return end
    local Gradient = Object:FindFirstChild("HELLO_Rainbow")
    if not Gradient then
        Gradient = Instance.new("UIGradient")
        Gradient.Name = "HELLO_Rainbow"
        Gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 70, 70)),
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 210, 70)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 120)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 180, 255)),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 90, 255)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(255, 80, 180)),
        })
        Gradient.Parent = Object
    end
    task.spawn(function()
        while Object.Parent do
            Gradient.Rotation = (Gradient.Rotation + 2) % 360
            task.wait(0.03)
        end
    end)
    return Gradient
end

--=========================================================
-- FIRE / EMBER
--=========================================================
function HELLO.Effects:Fire(Container)
    if not Container then return end
    local Holder = Container:FindFirstChild("HELLO_Fire")
    if Holder then return Holder end

    Holder = Create("Frame", {
        Name = "HELLO_Fire",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 5,
    })
    Holder.Parent = Container

    task.spawn(function()
        while Holder.Parent do
            local Ember = Create("Frame", {
                Size = UDim2.fromOffset(
                    math.random(3, 7), math.random(3, 7)
                ),
                Position = UDim2.new(
                    math.random(5, 95) / 100, 0, 1, 0
                ),
                BackgroundColor3 = Color3.fromRGB(
                    255, math.random(80, 190), math.random(20, 70)
                ),
                BackgroundTransparency = 0.15,
                BorderSizePixel = 0,
                ZIndex = 6,
            })
            Ember.Parent = Holder
            AddCorner(Ember, 20)

            local Rise = PlayTween(Ember,
                math.random(12, 22) / 10,
                {
                    Position = UDim2.new(Ember.Position.X.Scale, 0, -0.15, 0),
                    BackgroundTransparency = 1,
                    Size = UDim2.fromOffset(1, 1),
                },
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            )
            Rise.Completed:Connect(function()
                if Ember then Ember:Destroy() end
            end)
            task.wait(math.random(10, 24) / 100)
        end
    end)
    return Holder
end

