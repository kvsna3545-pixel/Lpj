    if HELLO.SpaceEffect ~= false then
        HELLO.BuildSpaceEffect(FloatButton, Window)
    end

    -- FLOAT DRAG
    local floatDragging = false
    local floatDragStart
    local floatStartPosition
    local floatMoved = false

    FloatButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            floatDragging      = true
            floatMoved         = false
            floatDragStart     = input.Position
            floatStartPosition = FloatButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    floatDragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not floatDragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - floatDragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                floatMoved = true
            end
            FloatButton.Position = UDim2.new(
                floatStartPosition.X.Scale,
                floatStartPosition.X.Offset + delta.X,
                floatStartPosition.Y.Scale,
                floatStartPosition.Y.Offset + delta.Y
            )
        end
    end)

    -- FLOAT CLICK
    FloatButton.Activated:Connect(function()
        if floatMoved then return end
        if Window.Destroyed then return end
        local down = PlayTween(FloatScale, 0.08, { Scale = 0.86 })
        down.Completed:Wait()
        PlayTween(FloatScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
        Window:ToggleVisibility()
    end)

