    teleport = "map-pin",
    farm     = "sprout",
}

HELLO.IconAliases["triangle-alert"] = "alert-triangle"

local LucideModule = nil
local LucideTried  = false

local function GetLucide()
    if LucideTried then return LucideModule end
    LucideTried = true
    if not HELLO.UseLucide then return nil end

    local ok, result = pcall(function()
        return loadstring(game:HttpGet(HELLO.LucideUrl))()
    end)

    if ok and type(result) == "table" and result.GetAsset then
        LucideModule = result
    else
        warn("[Hello Hub] โหลด Lucide ไม่ได้ ใช้สัญลักษณ์สำรองแทน")
    end
    return LucideModule
end

local function GetLucideIcon(name)
    local lucide = GetLucide()
    if not lucide then return nil end
    local candidates = { name, HELLO.IconAliases[name] }
    for _, candidate in ipairs(candidates) do
        local ok, asset = pcall(lucide.GetAsset, candidate)
        if ok and asset and asset.Url then
            return {
                Image           = asset.Url,
                ImageRectOffset = asset.ImageRectOffset,
                ImageRectSize   = asset.ImageRectSize,
            }
        end
    end
    return nil
end

-- คืนค่า: "image", ตาราง หรือ "glyph", ข้อความ
local function ResolveIcon(icon)
    if icon == nil or icon == "" then return nil end

    if type(icon) == "number" then
        return "image", { Image = "rbxassetid://" .. tostring(icon) }
    end

    if type(icon) == "table" then
        return "image", icon
    end

    icon = tostring(icon)

    if icon:find("rbxassetid://", 1, true)
        or icon:find("rbxthumb://", 1, true)
        or icon:find("rbxasset://", 1, true)
        or icon:match("^https?://") then
        return "image", { Image = icon }
    end

    if icon:match("^%d+$") then
        return "image", { Image = "rbxassetid://" .. icon }
    end

    local key = string.lower(icon)
    key = key:gsub("^lucide:", "")

    local registered = HELLO.Icons[key]
    if registered then
        if type(registered) == "table" then
            return "image", registered
        end
        return "image", { Image = tostring(registered) }
    end

    local lucideIcon = GetLucideIcon(key)
    if lucideIcon then return "image", lucideIcon end

    return "glyph", HELLO.IconGlyphs[key] or "\u{25C8}"
end

