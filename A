            local Button = Create("TextButton", {
                Size = UDim2.new(1, -20, 0, 48),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = "Selected: 0  \u{25BC}",
                TextColor3 = HELLO.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            })
            Button.Parent = Frame

            local OptionButtons = {}
            local function Refresh()
                local count = 0
                for _, state in pairs(selected) do
                    if state then count += 1 end
                end
                Button.Text = "Selected: " .. count .. "  "
                    .. (open and "\u{25B2}" or "\u{25BC}")
            end

            for index, option in ipairs(options) do
                local Option = Create("TextButton", {
                    Name = "Multi_" .. index,
                    Size = UDim2.new(1, -20, 0, 30),
                    Position = UDim2.fromOffset(10, 48 + (index - 1) * 34),
                    BackgroundColor3 = HELLO.Theme.Background,
                    Text = tostring(option),
                    TextColor3 = HELLO.Theme.SubText,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                    Visible = false,
                })
                Option.Parent = Frame
                AddCorner(Option, HELLO.Corners.Inner)
                OptionButtons[index] = Option

                Option.Activated:Connect(function()
                    selected[option] = not selected[option]
                    Option.Text = selected[option]
                        and ("\u{2713} " .. tostring(option))
                        or  tostring(option)
                    Refresh()

                    if config.Callback then
                        local result = {}
                        for value, state in pairs(selected) do
                            if state then table.insert(result, value) end
                        end
                        task.spawn(config.Callback, result)
                    end
                end)
            end

            Button.Activated:Connect(function()
                open = not open
                for _, item in ipairs(OptionButtons) do
                    item.Visible = open
                end
                local height = open and (48 + #options * 34) or 48
                PlayTween(Frame, 0.2, { Size = UDim2.new(1, 0, 0, height) })
                Refresh()
            end)

            Refresh()

            return {
                Get = function()
                    local result = {}
                    for value, state in pairs(selected) do
                        if state then table.insert(result, value) end
                    end
                    return result
                end,
            }
        end

