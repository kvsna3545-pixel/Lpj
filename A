        ImageTransparency = HELLO.Background.Transparency
    })
    PlayTween(HideScale, 0.45, { Scale = 1 },
        Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    PlayTween(Main, 0.45, {
        Size = UDim2.fromOffset(Window.Size.X, Window.Size.Y),
        Position = UDim2.new(
            0.5, -Window.Size.X / 2,
            0.5, -Window.Size.Y / 2
        ),
        BackgroundTransparency = HELLO.Glass.Main,
    }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- WELCOME
    task.delay(0.5, function()
        if not Window.Destroyed then
            Window:Notify({
                Title = "Hello Hub v" .. HELLO.Version,
                Content = "Library Loaded Successfully \u{1F525}",
                Duration = 3,
            })
        end
    end)

    return Window
