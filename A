        Position    = UDim2.fromScale(0.5, 0.54),
        Size        = UDim2.fromOffset(0, 2),
        BackgroundColor3 = Theme.Stroke2,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ZIndex = 204,
