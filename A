-- HELLO.CreateIcon("ghost", { Size, Position, AnchorPoint, Color, ZIndex })
-- คืนค่า: object, kind ("image" = ไอคอนจริง, "glyph" = สัญลักษณ์สำรอง)
--=========================================================
function HELLO.CreateIcon(icon, props)
    props = props or {}
    local kind, data = ResolveIcon(icon)
    if not kind then return nil end

    local object
    if kind == "image" then
        object = Create("ImageLabel", {
            Name                 = props.Name or "Icon",
            AnchorPoint          = props.AnchorPoint,
            Position             = props.Position,
            Size                 = props.Size or UDim2.fromOffset(18, 18),
            BackgroundTransparency = 1,
            Image                = data.Image or "",
            ImageRectOffset      = data.ImageRectOffset or Vector2.zero,
            ImageRectSize        = data.ImageRectSize or Vector2.zero,
            ImageColor3          = props.Color or HELLO.Theme.Text,
            ImageTransparency    = props.Transparency or 0,
            ScaleType            = Enum.ScaleType.Fit,
            ZIndex               = props.ZIndex or 1,
        })
    else
        object = Create("TextLabel", {
            Name                 = props.Name or "Icon",
            AnchorPoint          = props.AnchorPoint,
            Position             = props.Position,
            Size                 = props.Size or UDim2.fromOffset(18, 18),
            BackgroundTransparency = 1,
            Text                 = data,
            TextColor3           = props.Color or HELLO.Theme.Text,
            TextTransparency     = props.Transparency or 0,
            TextSize             = props.TextSize or 16,
            Font                 = Enum.Font.GothamBold,
            ZIndex               = props.ZIndex or 1,
        })
    end
    return object, kind
end

--=========================================================
-- HALLOWEEN FX (เอฟเฟกต์ธีม Halloween)
-- ปิดบางอัน: HELLO.HalloweenFX.Embers = false (ตั้งก่อน CreateWindow)
--=========================================================
HELLO.HalloweenFX = {
    Tint         = true,   -- ไล่สีม่วง/ส้มพื้นหลัง (บนม่วง ล่างส้ม)
    Web          = true,   -- ใยแมงมุมมุมขวาบน
    HeaderLine   = true,   -- เส้นไฟวิ่งใต้แถบหัว
    TitleShine   = true,   -- ชื่อหัวไล่เฉดวับๆ
    Embers       = true,   -- ประกายไฟลอยขึ้น
    Ghosts       = true,   -- ผีลอยผ่านหน้าต่างนานๆ ครั้ง
    Moon         = true,   -- พระจันทร์เรืองแสงมุมขวาบน
    Fog          = true,   -- หมอกลอยช้าๆ ด้านล่าง
    Lightning    = true,   -- ฟ้าแลบวาบจางๆ นานๆ ครั้ง
    BorderPulse  = true,   -- ขอบหน้าต่างหายใจ
    Intro        = false,  -- ฉากเปิดตัวในหน้าต่างหลัก (ปิดไว้ เปิดได้)
    ScreenIntro  = true,   -- อนิเมชันเต็มจอตอนรับ
    ScreenIntroOnce = true,
    ScreenIntroTitle = true,
    -- HowlSoundId = "rbxassetid://<SOUND_ID>",  -- เสียงหอน (ไม่บังคับ)
}

function HELLO.BuildScreenIntro(ScreenGui, TitleText, SubtitleText)
    local Theme = HELLO.Theme
    local FX    = HELLO.HalloweenFX
    if not ScreenGui then return end
    if FX.ScreenIntroOnce and HELLO.ScreenIntroPlayed then return end
    HELLO.ScreenIntroPlayed = true

    local TweenService = game:GetService("TweenService")

    local function Tw(object, time, props, style, direction)
        TweenService:Create(object, TweenInfo.new(
            time, style or Enum.EasingStyle.Quad,
            direction or Enum.EasingDirection.Out
        ), props):Play()
    end

    local function Round(object)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = object
    end

    local Root = Create("Frame", {
        Name = "HalloweenScreenIntro",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 200,
    })
    Root.Parent = ScreenGui

    local function Alive() return Root:IsDescendantOf(game) end

    local function ScreenSize()
        local size = Root.AbsoluteSize
        if size.X < 10 or size.Y < 10 then
            local camera = workspace.CurrentCamera
            return camera and camera.ViewportSize or Vector2.new(800, 450)
        end
        return size
    end

    task.delay(12, function()
        if Root.Parent then Root:Destroy() end
    end)

    -- DIM (ทำจอืดลง) + ขอบจอ 4 ด้าน
    local Dim = Create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(6, 2, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 0,
    })
    Dim.Parent = Root

    local Edges = {}

    local function Edge(anchor, position, size, rotation)
        local Frame = Create("Frame", {
            AnchorPoint = anchor,
            Position    = position,
            Size        = size,
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 1,
        })
        Frame.Parent = Root

        local Grad = Instance.new("UIGradient")
        Grad.Rotation = rotation
        Grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Theme.Primary),
            ColorSequenceKeypoint.new(0.14, Theme.Stroke1),
            ColorSequenceKeypoint.new(1,    Color3.fromRGB(10, 5, 16)),
        })
        Grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    0.3),
            NumberSequenceKeypoint.new(0.22, 0.6),
            NumberSequenceKeypoint.new(1,    1),
        })
        Grad.Parent = Frame
        table.insert(Edges, Frame)
    end

    Edge(Vector2.new(0, 0), UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.3, 0), 90)
    Edge(Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.new(1, 0, 0.3, 0), 270)
    Edge(Vector2.new(0, 0), UDim2.new(0, 0, 0, 0), UDim2.new(0.2, 0, 1, 0), 0)
    Edge(Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.new(0.2, 0, 1, 0), 180)

    -- MOON (พระจันทร์ดวงใหญ่ตรงกลางบน)
    local MoonSize = math.clamp(
        math.floor(math.min(ScreenSize().X, ScreenSize().Y) * 0.34),
        110, 200
    )

    local Moon = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position    = UDim2.new(0.5, 0, 0.34, 0),
        Size        = UDim2.fromOffset(0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        ZIndex = 2,
    })
    Moon.Parent = Root
    Round(Moon)

    local MoonGrad = Instance.new("UIGradient")
    MoonGrad.Rotation = 90
    MoonGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.FxLight),
        ColorSequenceKeypoint.new(1, Theme.FxSilver),
    })
    MoonGrad.Parent = Moon

    local Halo = AddStroke(Moon, Theme.FxLight, 0.78, 20)

    for _, Crater in ipairs({
        { 0.2,  0.25, 0.2 },
        { 0.55, 0.5,  0.15 },
        { 0.3,  0.65, 0.12 },
    }) do
        local Hole = Create("Frame", {
            Position = UDim2.fromScale(Crater[1], Crater[2]),
            Size     = UDim2.fromScale(Crater[3], Crater[3]),
            BackgroundColor3 = Theme.FxDark,
            BackgroundTransparency = 0.8,
            BorderSizePixel = 0,
            ZIndex = 3,
        })
        Hole.Parent = Moon
        Round(Hole)
    end

    -- LIGHTNING (ฟ้าแลบ: แสงวาบ + สายฟ้าซิกแซก)
    local Flash = Create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(240, 230, 255),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 6,
    })
    Flash.Parent = Root

    local function Lightning()
        local Size = ScreenSize()
        local Bolt = Create("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ZIndex = 5,
        })
        Bolt.Parent = Root

        local Previous = Vector2.new(
            Size.X * (0.3 + math.random() * 0.4), 0
        )
        local Segments = 8
        local Pieces   = {}

        for _ = 1, Segments do
            local NextPoint = Vector2.new(
                Previous.X + math.random(-45, 45),
                Previous.Y + Size.Y * 0.62 / Segments
            )
            local Delta  = NextPoint - Previous
            local Middle = (Previous + NextPoint) / 2

            local Piece = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position    = UDim2.fromOffset(Middle.X, Middle.Y),
                Size        = UDim2.fromOffset(Delta.Magnitude + 2, 3),
                Rotation    = math.deg(math.atan2(Delta.Y, Delta.X)),
                BackgroundColor3 = Color3.fromRGB(245, 235, 255),
                BorderSizePixel = 0,
            })
            Piece.Parent = Bolt

            table.insert(Pieces, {
                Piece, AddStroke(Piece, Theme.FxMid, 0.45, 4),
            })
            Previous = NextPoint
        end

        Flash.BackgroundTransparency = 0.3
        task.wait(0.06)
        Tw(Flash, 0.15, { BackgroundTransparency = 1 })
        task.wait(0.12)
        Flash.BackgroundTransparency = 0.55
        task.wait(0.04)
        Tw(Flash, 0.3, { BackgroundTransparency = 1 })

        for _, Item in ipairs(Pieces) do
            Tw(Item[1], 0.35, { BackgroundTransparency = 1 })
            Tw(Item[2], 0.35, { Transparency = 1 })
        end
        task.wait(0.4)
        Bolt:Destroy()
    end

    -- CROWS (ฝูงกาบินผ่านพระจันทร์)
    local function Crow(delay, y, size, duration)
        task.delay(delay, function()
            if not Alive() then return end
            local Bird = HELLO.CreateIcon(
                HELLO.DecoIcons.Crow or "bird",
                {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(-0.08, 0, y, 0),
                    Size        = UDim2.fromOffset(size, size),
                    Color       = Theme.Text,
                    Transparency = 0.15,
                    TextSize    = math.floor(size * 0.8),
                    ZIndex      = 3,
                }
            )
            if not Bird then return end
            Bird.Parent = Root

            local Start  = os.clock()
            local Conn
            Conn = RunService.Heartbeat:Connect(function()
                if not Alive() then Conn:Disconnect() return end
                local Progress = (os.clock() - Start) / duration
                if Progress >= 1 then
                    Conn:Disconnect()
                    Bird:Destroy()
                    return
                end
                Bird.Position = UDim2.new(
                    -0.08 + 1.2 * Progress, 0,
                    y + math.sin(Progress * math.pi * 4) * 0.02, 0
                )
                Bird.Rotation = math.sin(Progress * math.pi * 8) * 10
            end)
        end)
    end

    -- EYES (ตาเรืองแสงในความมืด)
    local function EyePair(x, y, delay)
        task.delay(delay, function()
            if not Alive() then return end
            local Pair = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position    = UDim2.new(x, 0, y, 0),
                Size        = UDim2.fromOffset(40, 12),
                BackgroundTransparency = 1,
                ZIndex = 4,
            })
            Pair.Parent = Root

            local Eyes = {}
            for Index, Offset in ipairs({ -12, 12 }) do
                local Eye = Create("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(0.5, Offset, 0.5, 0),
                    Size        = UDim2.fromOffset(12, 4),
                    Rotation    = Index == 1 and 14 or -14,
                    BackgroundColor3 = Color3.fromRGB(255, 170, 40),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                })
                Eye.Parent = Pair
                AddCorner(Eye, 2)
                local Glow = AddStroke(Eye, Color3.fromRGB(255, 120, 20), 1, 3)
                Tw(Eye, 0.3, { BackgroundTransparency = 0 })
                Tw(Glow, 0.3, { Transparency = 0.5 })
                table.insert(Eyes, { Eye, Glow })
            end

            task.wait(0.9)
            for _, Item in ipairs(Eyes) do
                Item[1].Size = UDim2.fromOffset(12, 1)
            end
            task.wait(0.12)
            for _, Item in ipairs(Eyes) do
                Item[1].Size = UDim2.fromOffset(12, 4)
            end
            task.wait(0.6)
            for _, Item in ipairs(Eyes) do
                Tw(Item[1], 0.4, { BackgroundTransparency = 1 })
                Tw(Item[2], 0.4, { Transparency = 1 })
            end
            task.wait(0.45)
            Pair:Destroy()
        end)
    end

    -- HOWL SOUND (ไม่บังคับ: FX.HowlSoundId)
    local Howl
    if FX.HowlSoundId then
        Howl = Instance.new("Sound")
        local Id = tostring(FX.HowlSoundId)
        Howl.SoundId = tonumber(Id) and ("rbxassetid://" .. Id) or Id
        Howl.Volume  = 0.6
        Howl.Parent  = Root
    end

    -- TITLE (พิมพ์ชื่อทีละตัวอักษร + กระพริบ)
    local TitleObjects = {}

    local function ShowTitle()
        if FX.ScreenIntroTitle == false then return end
        task.spawn(function()
            pcall(function()
                local Text = tostring(TitleText or "HELLO")
                local Label = Create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(0.5, 0, 0.62, 0),
                    Size        = UDim2.new(1, 0, 0, 56),
                    BackgroundTransparency = 1,
                    Text        = "",
                    TextColor3  = Theme.Text,
                    TextSize    = 44,
                    Font        = Enum.Font.GothamBlack,
                    ZIndex      = 8,
                })
                Label.Parent = Root

                local LabelStroke = Instance.new("UIStroke")
                LabelStroke.Color        = Theme.Primary
                LabelStroke.Thickness    = 2.5
                LabelStroke.Transparency = 0.45
                LabelStroke.Parent       = Label

                local Sub = Create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(0.5, 0, 0.62, 40),
                    Size        = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text        = tostring(SubtitleText or ""),
                    TextColor3  = Theme.Primary,
                    TextSize    = 15,
                    Font        = Enum.Font.GothamBold,
                    TextTransparency = 1,
                    ZIndex      = 8,
                })
                Sub.Parent = Root

                TitleObjects = { Label, LabelStroke, Sub }

                local Count = utf8.len(Text) or #Text
                for Index = 1, Count do
                    if not Alive() then return end
                    local Cut = utf8.offset(Text, Index + 1)
                    Label.Text = Cut and string.sub(Text, 1, Cut - 1) or Text
                    task.wait(0.07)
                end

                Tw(Sub, 0.4, { TextTransparency = 0 })

                for _ = 1, 2 do
                    Label.TextTransparency = 0.6
                    task.wait(0.05)
                    Label.TextTransparency = 0
                    task.wait(0.07)
                end
            end)
        end)
    end

    -- WOLF (วิ่ง -> กระโดดข้ามพระจันทร์ -> วิ่งต่อ)
    local function SpawnTrail(x, y, onGround)
        if onGround then
            local Paw, PawKind = HELLO.CreateIcon(
                HELLO.DecoIcons.Paw or "paw-print",
                {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(x, -34, y, -6),
                    Size        = UDim2.fromOffset(16, 16),
                    Color       = Theme.Primary,
                    Transparency = 0.2,
                    TextSize    = 14,
                    ZIndex      = 4,
                }
            )
            if Paw then
                Paw.Rotation = 90
                Paw.Parent   = Root
                Tw(Paw, 1.2, {
                    [PawKind == "image" and "ImageTransparency" or "TextTransparency"] = 1,
                })
                task.delay(1.3, function() Paw:Destroy() end)
            end
        else
            local Ember = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position    = UDim2.new(
                    x, math.random(-12, 12),
                    y, -40 + math.random(-10, 10)
                ),
                Size        = UDim2.fromOffset(4, 4),
                BackgroundColor3 = Theme.Primary,
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                ZIndex = 6,
            })
            Ember.Parent = Root
            Round(Ember)
            Tw(Ember, 0.7, {
                BackgroundTransparency = 1,
                Position = UDim2.new(x, math.random(-20, 20), y, -70),
            })
            task.delay(0.75, function() Ember:Destroy() end)
        end
    end

    local function WolfRun()
        local Wolf = HELLO.CreateIcon(
            HELLO.DecoIcons.Wolf or "dog",
            {
                AnchorPoint = Vector2.new(0.5, 1),
                Position    = UDim2.new(-0.12, 0, 0.94, 0),
                Size        = UDim2.fromOffset(96, 96),
                Color       = Theme.FxWhite,
                TextSize    = 72,
                ZIndex      = 7,
            }
        )
        if Wolf then Wolf.Parent = Root end

        local RunIn, Leap, RunOut = 1.1, 1.0, 0.8
        local Total     = RunIn + Leap + RunOut
        local Elapsed   = 0
        local Trail     = 0
        local Finished  = false
        local Pulsed    = false
        local Titled    = false
        local Conn

        Conn = RunService.Heartbeat:Connect(function(dt)
            if not Alive() then
                Conn:Disconnect()
                Finished = true
                return
            end
            Elapsed = Elapsed + dt
            Trail   = Trail   + dt

            local X, Y, Rot, OnGround

            if Elapsed < RunIn then
                local U = Elapsed / RunIn
                X = -0.12 + 0.46 * U
                Y = 0.94 - math.abs(math.sin(U * math.pi * 5)) * 0.025
                Rot = math.sin(U * math.pi * 5) * 6
                OnGround = true
            elseif Elapsed < RunIn + Leap then
                local U = (Elapsed - RunIn) / Leap
                X = 0.34 + 0.34 * U
                Y = 0.94 - 0.62 * math.sin(U * math.pi)
                Rot = -32 + 64 * U
                OnGround = false

                if U > 0.45 and not Pulsed then
                    Pulsed = true
                    Tw(Halo, 0.25, { Transparency = 0.4 })
                    Tw(Moon, 0.25, { BackgroundTransparency = 0 })
                    task.delay(0.3, function()
                        Tw(Halo, 0.5, { Transparency = 0.78 })
                        Tw(Moon, 0.5, { BackgroundTransparency = 0.12 })
                    end)
                    if Howl then pcall(function() Howl:Play() end) end
                end
            else
                local U = math.min((Elapsed - RunIn - Leap) / RunOut, 1)
                X = 0.68 + 0.46 * U
                Y = 0.94 - math.abs(math.sin(U * math.pi * 4)) * 0.025
                Rot = math.sin(U * math.pi * 4) * 6
                OnGround = true
            end

            if Wolf then
                Wolf.Position = UDim2.new(X, 0, Y, 0)
                Wolf.Rotation = Rot
            end

            if Elapsed > RunIn + Leap and not Titled then
                Titled = true
                ShowTitle()
            end

            if Trail >= (OnGround and 0.14 or 0.05) then
                Trail = 0
                SpawnTrail(X, Y, OnGround)
            end

            if Elapsed >= Total then
                Conn:Disconnect()
                Finished = true
            end
        end)

        while not Finished and Alive() do
            task.wait()
        end
        if Wolf then Wolf:Destroy() end
    end

    -- TIMELINE
    task.spawn(function()
        pcall(function()
            Tw(Dim, 0.5, { BackgroundTransparency = 0.45 })
            for _, Frame in ipairs(Edges) do
                Tw(Frame, 0.6, { BackgroundTransparency = 0 })
            end
            task.wait(0.55)

            task.spawn(Lightning)
            task.wait(0.15)

            Tw(Moon, 0.9, {
                Size = UDim2.fromOffset(MoonSize, MoonSize)
            }, Enum.EasingStyle.Back)

            Crow(0.0,  0.22, 26, 3.2)
            Crow(0.25, 0.30, 20, 3.4)
            Crow(0.45, 0.18, 22, 3.0)
            Crow(0.7,  0.38, 16, 3.6)
            Crow(0.9,  0.26, 18, 3.2)

            EyePair(0.06, 0.45, 0.5)
            EyePair(0.95, 0.6,  1.1)
            EyePair(0.08, 0.78, 1.7)

            task.wait(0.9)
            WolfRun()

            -- ฉากโชว์ชื่อ เสร็จแล้วค่อยๆ จางหายทั้งหมด
            task.wait(1.1)
            for _, Frame in ipairs(Edges) do
                Tw(Frame, 0.8, { BackgroundTransparency = 1 })
            end
            Tw(Dim, 0.8, { BackgroundTransparency = 1 })
            Tw(Moon, 0.7, {
                Size = UDim2.fromOffset(0, 0)
            }, Enum.EasingStyle.Back, Enum.EasingDirection.In)

            if TitleObjects[1] then
                Tw(TitleObjects[1], 0.6, { TextTransparency = 1 })
                Tw(TitleObjects[2], 0.6, { Transparency = 1 })
                Tw(TitleObjects[3], 0.6, { TextTransparency = 1 })
            end
            task.wait(0.9)
        end)

        if Root.Parent then Root:Destroy() end
    end)
end

