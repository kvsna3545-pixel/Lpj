local function Create(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        pcall(function() object[property] = value end)
    end

    -- ทำให้พื้นหลัง/ของที่กำหนดสีเป็น Card โปร่งใสอัตโนมัติ
    if properties
        and properties.BackgroundTransparency == nil
        and properties.Name ~= "Main"
        and object:IsA("GuiObject") then
        local color = properties.BackgroundColor3
        if color == HELLO.Theme.Card then
            object.BackgroundTransparency = HELLO.Glass.Card
        elseif color == HELLO.Theme.Background then
            object.BackgroundTransparency = HELLO.Glass.Inner
        end
    end
    return object
end

