                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                    Visible = false,
                })
                Option.Parent = Frame
                AddCorner(Option, HELLO.Corners.Inner)
                OptionButtons[index] = Option

                Option.Activated:Connect(function()
                    selected = option
                    open = false
                    for _, item in ipairs(OptionButtons) do
                        item.Visible = false
                    end
                    PlayTween(Frame, 0.2, { Size = UDim2.new(1, 0, 0, 48) })
                    Refresh()
                    if config.Callback then
                        task.spawn(config.Callback, selected)
                    end
                end)
            end

            Button.Activated:Connect(function()
                open = not open
                for _, item in ipairs(OptionButtons) do
                    item.Visible = open
                end
                local height = open and (48 + #options * 34) or 48
                PlayTween(Frame, 0.2, { Size = UDim2.new(1, 0, 0, height) })
                Refresh()
            end)

            return {
                Set = function(_, value)
                    selected = value
                    Refresh()
                end,
                Get = function() return selected end,
            }
        end

        -- MULTI DROPDOWN
        function Tab:CreateMultiDropdown(config)
            config = config or {}
            local options  = config.Options or {}
            local selected = {}
            for _, value in ipairs(config.Default or {}) do
                selected[value] = true
            end
            local open = false

            local Frame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 48),
                BackgroundColor3 = HELLO.Theme.Card,
                ClipsDescendants = true,
