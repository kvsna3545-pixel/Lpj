        AddCorner(TabButton, 8)

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 12)
        padding.Parent = TabButton

        -- TAB ICON
        local IconObject
        local iconKind, iconData = ResolveIcon(Tab.Icon)
        if iconKind then
            padding.PaddingLeft = UDim.new(0, 38)
            if iconKind == "image" then
                IconObject = Create("ImageLabel", {
                    Size = UDim2.fromOffset(18, 18),
                    Position = UDim2.new(0, -26, 0.5, -9),
                    BackgroundTransparency = 1,
