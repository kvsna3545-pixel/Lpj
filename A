        -- SELECT
        function Tab:Select()
            for _, other in ipairs(Window.Tabs) do
                if other.Button then
                    PlayTween(other.Button, 0.15, {
                        BackgroundTransparency = 1,
                        TextColor3 = HELLO.Theme.SubText,
                    })
                end
                SetIconColor(other, HELLO.Theme.SubText)
                if other.Accent then
                    PlayTween(other.Accent, 0.15,
                        { BackgroundTransparency = 1 })
                end
                if other.Glow then
                    PlayTween(other.Glow, 0.15, { Transparency = 1 })
                end
                if other.Page then
                    other.Page.Visible = false
                end
            end

            SetIconColor(Tab, HELLO.Theme.Text)
            if Tab.Accent then
                PlayTween(Tab.Accent, 0.2,
                    { BackgroundTransparency = 0 })
            end
            if Tab.Glow then
                PlayTween(Tab.Glow, 0.2, { Transparency = 0.55 })
            end
            PlayTween(TabButton, 0.15, {
                BackgroundColor3 = HELLO.Theme.PrimaryDark,
                BackgroundTransparency = 0.15,
                TextColor3 = HELLO.Theme.Text,
            })
            Page.Visible = true
        end

        TabButton.Activated:Connect(function() Tab:Select() end)

