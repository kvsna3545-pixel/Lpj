    if HELLO.Theme.IsHalloween then
        HELLO.BuildHalloweenFX(Window, Main, Header, Title)
        return
    end

    local Theme = HELLO.Theme
    local mode  = Theme.Animation

    local Root = Create("Frame", {
        Name = "SeasonScreenIntro",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        ZIndex = 200,
