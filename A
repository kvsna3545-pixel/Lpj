function HELLO.BuildHalloweenFX(Window, Main, Header, Title)
    local Theme = HELLO.Theme
    local FX    = HELLO.HalloweenFX
    if not Theme.IsHalloween then return end

    -- อนิเมชันเต็มจอตอนรับ (ขอบจอ + พระจันทร์ + หมาป่า)
    if FX.ScreenIntro then
        HELLO.BuildScreenIntro(Main.Parent, Window.Title, Window.Subtitle)
    end

    -- ชั้นเอฟเฟกต์
    local Layer = Create("Frame", {
        Name = "HalloweenFX",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 25,
    })
    Layer.Parent = Main

    -- TINT (เฉดสีซ้อนพื้นหลัง)
    if FX.Tint then
        local Tint = Create("Frame", {
            Name = "HalloweenTint",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            ZIndex = 0,
        })
        Tint.Parent = Main
        AddCorner(Tint, 16)

        local Grad = Instance.new("UIGradient")
        Grad.Rotation = 90
        Grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Theme.Stroke1),
            ColorSequenceKeypoint.new(0.55, Theme.Background),
            ColorSequenceKeypoint.new(1,    Theme.Stroke2),
        })
        Grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    0.84),
            NumberSequenceKeypoint.new(0.55, 1),
            NumberSequenceKeypoint.new(1,    0.82),
        })
        Grad.Parent = Tint
    end

    -- COBWEB (ใยแมงมุมมุมขวาบน)
    if FX.Web then
        local Size = 58
        local Web = Create("Frame", {
            Name = "Cobweb",
            Size = UDim2.fromOffset(Size, Size),
            BackgroundTransparency = 1,
            ClipsDescendants = true,
            ZIndex = 3,
        })
        Web.Parent = Layer

        local Length = Size * 1.5
        for _, Angle in ipairs({ 0, 22.5, 45, 67.5, 90 }) do
            local Rad = math.rad(Angle)
            local Line = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset(
                    math.cos(Rad) * Length / 2,
                    math.sin(Rad) * Length / 2
                ),
                Size = UDim2.fromOffset(Length, 1),
                Rotation = Angle,
                BackgroundColor3 = Theme.Text,
                BackgroundTransparency = 0.78,
                BorderSizePixel = 0,
            })
            Line.Parent = Web
        end
        for _, Fraction in ipairs({ 0.32, 0.6, 0.9 }) do
            local Radius = Size * Fraction
            local Ring = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position    = UDim2.fromOffset(0, 0),
                Size        = UDim2.fromOffset(Radius * 2, Radius * 2),
                BackgroundTransparency = 1,
            })
            Ring.Parent = Web
            AddCorner(Ring, Radius)
            AddStroke(Ring, Theme.Text, 0.8, 1)
        end
    end

    -- HEADER LINE (เส้นไฟวิ่งใต้แถบหัว)
    local HeaderGrad
    if FX.HeaderLine then
        local Line = Create("Frame", {
            Name = "HeaderLine",
            AnchorPoint = Vector2.new(0, 1),
            Position    = UDim2.new(0, 0, 1, 0),
            Size        = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 4,
        })
        Line.Parent = Header

        HeaderGrad = Instance.new("UIGradient")
        HeaderGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Theme.Stroke1),
            ColorSequenceKeypoint.new(0.5, Theme.Stroke2),
            ColorSequenceKeypoint.new(1,   Theme.Stroke1),
        })
        HeaderGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,   0.88),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(1,   0.88),
        })
        HeaderGrad.Parent = Line
    end

    -- TITLE SHINE (ชื่อหัวไล่เฉดวับๆ)
    local TitleGrad
    if FX.TitleShine and Title then
        TitleGrad = Instance.new("UIGradient")
        TitleGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Theme.Primary),
            ColorSequenceKeypoint.new(0.5, Theme.Text),
            ColorSequenceKeypoint.new(1,   Theme.Primary),
        })
        TitleGrad.Parent = Title
    end

    -- EMBERS (ประกายไฟลอยขึ้น)
    local Embers = {}
    if FX.Embers then
        local Colors = { Theme.Primary, Theme.FxLight, Theme.FxMid, Theme.FxWhite }
        for _ = 1, 12 do
            local Dot = math.random(2, 3)
            local Frame = Create("Frame", {
                Size = UDim2.fromOffset(Dot, Dot),
                BackgroundColor3 = Colors[math.random(#Colors)],
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 1,
            })
            Frame.Parent = Layer
            AddCorner(Frame, 3)
            table.insert(Embers, {
                Frame    = Frame,
                X        = 0.06 + math.random() * 0.88,
                Speed    = 0.04 + math.random() * 0.06,
                Offset   = math.random(),
                Sway     = 3 + math.random() * 6,
                SwayRate = 0.8 + math.random() * 1.4,
                Phase    = math.random() * math.pi * 2,
            })
        end
    end

    -- PRO FX: MOON / FOG / LIGHTNING / BORDER PULSE / INTRO
    local function Tw(object, time, props, style)
        game:GetService("TweenService"):Create(
            object,
            TweenInfo.new(
                time,
                style or Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            props
        ):Play()
    end

    -- พระจันทร์ (อยู่หลังเนื้อหา มองผ่านช่องว่าง)
    local MoonStroke
    if FX.Moon then
        local Moon = Create("Frame", {
            Name = "HalloweenMoon",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position    = UDim2.new(1, -78, 0, 34),
            Size        = UDim2.fromOffset(86, 86),
            BackgroundColor3 = Theme.FxLight,
            BackgroundTransparency = 0.86,
            BorderSizePixel = 0,
            ZIndex = 0,
        })
        Moon.Parent = Main
        AddCorner(Moon, 43)
        MoonStroke = AddStroke(Moon, Theme.FxLight, 0.8, 6)

        for _, Crater in ipairs({
            { 18, 20, 16 },
            { 48, 40, 12 },
            { 30, 56, 9 },
        }) do
            local Hole = Create("Frame", {
                Position = UDim2.fromOffset(Crater[1], Crater[2]),
                Size     = UDim2.fromOffset(Crater[3], Crater[3]),
                BackgroundColor3 = Theme.FxDark,
                BackgroundTransparency = 0.82,
                BorderSizePixel = 0,
                ZIndex = 0,
            })
            Hole.Parent = Moon
            AddCorner(Hole, Crater[3])
        end
    end

    -- หมอกลอยช้าๆ ด้านล่าง
    local Fog = {}
    if FX.Fog then
        for _ = 1, 5 do
            local Width  = math.random(170, 240)
            local Height = math.random(46, 70)
            local Blob = Create("Frame", {
                AnchorPoint = Vector2.new(0, 1),
                Size        = UDim2.fromOffset(Width, Height),
                BackgroundColor3 = Theme.FxWhite,
                BackgroundTransparency = 0.93 + math.random() * 0.04,
                BorderSizePixel = 0,
                ZIndex = 0,
            })
            Blob.Parent = Main
            AddCorner(Blob, math.floor(Height / 2))
            table.insert(Fog, {
                Frame  = Blob,
                Speed  = 0.012 + math.random() * 0.02,
                Offset = math.random(),
                Y      = -math.random() * 14,
            })
        end
    end

    -- ขอบหน้าต่างหายใจ
    local MainStroke = FX.BorderPulse
        and Main:FindFirstChildOfClass("UIStroke") or nil

    -- ฟ้าแลบ (วาบจางๆ 2-3 ครั้ง ทุก 20-40 วิ)
    if FX.Lightning then
        local Flash = Create("Frame", {
            Name = "HalloweenFlash",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(235, 220, 255),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 40,
        })
        Flash.Parent = Layer
        AddCorner(Flash, 16)

        task.spawn(function()
            task.wait(12 + math.random() * 10)
            while not Window.Destroyed do
                for _, Strength in ipairs({ 0.84, 0.93, 0.8 }) do
                    Flash.BackgroundTransparency = Strength
                    task.wait(0.05)
                    Tw(Flash, 0.12, { BackgroundTransparency = 1 })
                    task.wait(0.1)
                end
                task.wait(20 + math.random() * 20)
            end
        end)
    end

    -- ฉากเปิดตัว (ไอคอน + ชื่อ แล้วจางหาย)
    if FX.Intro then
        task.spawn(function()
            pcall(function()
                local Intro = Create("Frame", {
                    Name = "HalloweenIntro",
                    Size = UDim2.fromScale(1, 1),
                    BackgroundColor3 = Theme.Sidebar,
                    BackgroundTransparency = 0,
                    BorderSizePixel = 0,
                    ZIndex = 90,
                })
                Intro.Parent = Layer
                AddCorner(Intro, 16)

                local Icon, Kind = HELLO.CreateIcon(
                    HELLO.DecoIcons.Corner or "skull",
                    {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position    = UDim2.new(0.5, 0, 0.5, -14),
                        Size        = UDim2.fromOffset(52, 52),
                        Color       = Theme.Primary,
                        TextSize    = 44,
                        ZIndex      = 91,
                    }
                )
                local IconScale = Instance.new("UIScale")
                IconScale.Scale = 0.4
                if Icon then
                    Icon.Parent = Intro
                    IconScale.Parent = Icon
                end

                local Name = Create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position    = UDim2.new(0.5, 0, 0.5, 34),
                    Size        = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = tostring(Window.Title or "HELLO"),
                    TextColor3 = Theme.Text,
                    TextSize = 15,
                    Font = Enum.Font.GothamBold,
                    TextTransparency = 1,
                    ZIndex = 91,
                })
                Name.Parent = Intro

                Tw(IconScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
                Tw(Name, 0.3, { TextTransparency = 0 })
                task.wait(0.85)

                Tw(Intro, 0.4, { BackgroundTransparency = 1 })
                Tw(Name, 0.3, { TextTransparency = 1 })
                if Icon then
                    Tw(Icon, 0.3, {
                        [Kind == "image" and "ImageTransparency" or "TextTransparency"] = 1,
                    })
                end
                task.wait(0.45)
                Intro:Destroy()
            end)
        end)

        -- กันค้าง: ถ้ามีอะไรพัง ฉากเปิดตัวจะถูกเคลียร์ใน 3 วิ
        task.delay(3, function()
            local Stuck = Layer:FindFirstChild("HalloweenIntro")
            if Stuck then Stuck:Destroy() end
        end)
    end

    -- ANIMATION LOOP
    local Clock     = 0
    local NextGhost = 5 + math.random() * 5
    local Ghosts    = {}
    local Conn

    Conn = RunService.Heartbeat:Connect(function(dt)
        if Window.Destroyed then Conn:Disconnect() return end
        Clock = Clock + dt

        if HeaderGrad then
            HeaderGrad.Offset = Vector2.new((Clock * 0.35) % 2 - 1, 0)
        end
        if TitleGrad then
            TitleGrad.Offset = Vector2.new((Clock * 0.5) % 2 - 1, 0)
        end
        if MainStroke then
            MainStroke.Thickness = 1.7 + 0.9 * (0.5 + 0.5 * math.sin(Clock * 1.8))
        end
        if MoonStroke then
            MoonStroke.Transparency = 0.8 + 0.12 * math.sin(Clock * 1.2)
        end

        for _, Cloud in ipairs(Fog) do
            local Progress = (Clock * Cloud.Speed + Cloud.Offset) % 1
            Cloud.Frame.Position = UDim2.new(
                -0.25 + 1.5 * Progress, 0,
                1, Cloud.Y
            )
        end

        for _, Ember in ipairs(Embers) do
            local Fraction = (Clock * Ember.Speed + Ember.Offset) % 1
            Ember.Frame.Position = UDim2.new(
                Ember.X,
                math.sin(Clock * Ember.SwayRate + Ember.Phase) * Ember.Sway,
                1 - Fraction,
                0
            )
            Ember.Frame.BackgroundTransparency =
                0.5 + 0.45 * math.abs(Fraction * 2 - 1)
        end

        -- ผีลอยผ่านนานๆ ครั้ง
        if FX.Ghosts and Clock >= NextGhost then
            NextGhost = Clock + 9 + math.random() * 7
            local Icon, Kind = HELLO.CreateIcon(
                HELLO.DecoIcons.Wisp or "ghost",
                {
                    Name        = "Wisp",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size        = UDim2.fromOffset(22, 22),
                    Color       = Theme.Text,
                    Transparency = 1,
                    TextSize    = 18,
                    ZIndex      = 2,
                }
            )
            if Icon then
                Icon.Parent = Layer
                table.insert(Ghosts, {
                    Object   = Icon,
                    Kind     = Kind,
                    Born     = Clock,
                    Duration = 8 + math.random() * 3,
                    Direction = math.random() < 0.5 and 1 or -1,
                    Y        = 0.25 + math.random() * 0.5,
                })
            end
        end

        for i = #Ghosts, 1, -1 do
            local Ghost = Ghosts[i]
            local Progress = (Clock - Ghost.Born) / Ghost.Duration
            if Progress >= 1 then
                Ghost.Object:Destroy()
                table.remove(Ghosts, i)
            else
                local X = Ghost.Direction == 1
                    and (-0.05 + Progress * 1.1)
                    or  (1.05 - Progress * 1.1)
                Ghost.Object.Position = UDim2.new(
                    X, 0,
                    Ghost.Y, math.sin(Progress * 12) * 8
                )
                Ghost.Object.Rotation = math.sin(Progress * 9) * 8
                local Fade = 1 - 0.45 * math.sin(Progress * math.pi)
                if Ghost.Kind == "image" then
                    Ghost.Object.ImageTransparency = Fade
                else
                    Ghost.Object.TextTransparency = Fade
                end
            end
        end
    end)
end

--=========================================================
-- TWEEN
--=========================================================
local function PlayTween(object, time, properties, style, direction)
    local tween = TweenService:Create(
        object,
        TweenInfo.new(
            time or 0.25,
            style or Enum.EasingStyle.Quad,
            direction or Enum.EasingDirection.Out
        ),
        properties
    )
    tween:Play()
    return tween
end

--=========================================================
-- SPACE EFFECT (เอฟเฟกต์อวกาศรอบปุ่มลอย)
-- ปิดได้ด้วย HELLO.SpaceEffect = false ก่อนสร้าง Window
--=========================================================
HELLO.SpaceEffect = true

function HELLO.BuildSpaceEffect(FloatButton, Window)
    local function Alive()
        return FloatButton.Parent ~= nil and not Window.Destroyed
    end

    local Dark   = HELLO.Theme.FxDark
    local Silver = HELLO.Theme.FxSilver
    local Light  = HELLO.Theme.FxLight
    local Mid    = HELLO.Theme.FxMid
    local White  = HELLO.Theme.FxWhite

    local FX = Create("Frame", {
        Name = "SpaceFX",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 5,
    })
    FX.Parent = FloatButton

    -- NEBULA RING (วงเนบิวลาหมุน)
    local function NebulaRing(pad, thickness, transparency, speed, reverse)
        local Ring = Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position    = UDim2.fromScale(0.5, 0.5),
            Size        = UDim2.new(1, pad, 1, pad),
            BackgroundTransparency = 1,
            ZIndex = 4,
        })
        Ring.Parent = FX
        AddCorner(Ring, 12 + pad / 2)

        local Stroke = AddStroke(Ring, White, transparency, thickness)
        local Grad = Instance.new("UIGradient")
        Grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Dark),
            ColorSequenceKeypoint.new(0.35, Light),
            ColorSequenceKeypoint.new(0.7,  Silver),
            ColorSequenceKeypoint.new(1,    Dark),
        })
        Grad.Parent = Stroke

        task.spawn(function()
            while Alive() do
                Grad.Rotation = reverse and 360 or 0
                local Spin = TweenService:Create(
                    Grad,
                    TweenInfo.new(speed, Enum.EasingStyle.Linear),
                    { Rotation = reverse and 0 or 360 }
                )
                Spin:Play()
                task.wait(speed)
            end
        end)
        return Stroke
    end

    local Glow = NebulaRing(16, 6, 0.8, 7, false)
    NebulaRing(9, 1.5, 0.25, 5, true)

    task.spawn(function()
        while Alive() do
            PlayTween(Glow, 1.6, { Transparency = 0.55 },
                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.6)
            PlayTween(Glow, 1.6, { Transparency = 0.88 },
                Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.6)
        end
    end)

    -- TWINKLING STARS (ดาวกะพริบ)
    local StarColors = { White, Silver, Mid, White }
    for _ = 1, 14 do
        local Angle  = math.random() * math.pi * 2
        local Radius = math.random(46, 62)
        local Size   = math.random(2, 3)
        local Star = Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position    = UDim2.new(
                0.5, math.cos(Angle) * Radius,
                0.5, math.sin(Angle) * Radius
            ),
            Size = UDim2.fromOffset(Size, Size),
            BackgroundColor3 = StarColors[math.random(#StarColors)],
            BackgroundTransparency = 0.9,
            BorderSizePixel = 0,
            ZIndex = 6,
        })
        Star.Parent = FX
        AddCorner(Star, 3)

        task.spawn(function()
            task.wait(math.random() * 2)
            while Alive() do
                local D = 0.6 + math.random() * 1.2
                PlayTween(Star, D, { BackgroundTransparency = 0.05 },
                    Enum.EasingStyle.Sine)
                task.wait(D)
                PlayTween(Star, D, { BackgroundTransparency = 0.92 },
                    Enum.EasingStyle.Sine)
                task.wait(D)
            end
        end)
    end

    -- ORBITING PLANETS (ดาวเคราะห์โคจร + หางจาง)
    local Orbiters = {
        { Radius = 46, Size = 7, Speed = 1.1,  Phase = 0,   Color = Light  },
        { Radius = 54, Size = 5, Speed = -0.75, Phase = 2.1, Color = Silver },
        { Radius = 62, Size = 4, Speed = 0.5,  Phase = 4.2, Color = Mid    },
    }
    local Tilt = math.rad(-20)

    for _, Orbiter in ipairs(Orbiters) do
        Orbiter.Dots = {}
        for k = 1, 4 do
            local Dot = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(
                    Orbiter.Size * (1 - (k - 1) * 0.2),
                    Orbiter.Size * (1 - (k - 1) * 0.2)
                ),
                BackgroundColor3 = Orbiter.Color,
                BackgroundTransparency = (k - 1) * 0.22,
                BorderSizePixel = 0,
                ZIndex = 7,
            })
            Dot.Parent = FX
            AddCorner(Dot, 10)
            if k == 1 then
                AddStroke(Dot, Orbiter.Color, 0.55, 2)
            end
            Orbiter.Dots[k] = Dot
        end
    end

    local Clock = 0
    local Conn
    Conn = RunService.Heartbeat:Connect(function(dt)
        if not Alive() then Conn:Disconnect() return end
        Clock = Clock + dt

        for _, Orbiter in ipairs(Orbiters) do
            local Dir = Orbiter.Speed > 0 and 1 or -1
            for k, Dot in ipairs(Orbiter.Dots) do
                local A = Orbiter.Phase + Clock * Orbiter.Speed
                    - (k - 1) * 0.16 * Dir
                local X = math.cos(A) * Orbiter.Radius
                local Y = math.sin(A) * Orbiter.Radius * 0.8
                local RX = X * math.cos(Tilt) - Y * math.sin(Tilt)
                local RY = X * math.sin(Tilt) + Y * math.cos(Tilt)
                Dot.Position = UDim2.new(0.5, RX, 0.5, RY)
                local Depth = 1 + 0.25 * math.sin(A)
                local S = Orbiter.Size * (1 - (k - 1) * 0.2) * Depth
                Dot.Size = UDim2.fromOffset(S, S)
            end
        end
    end)

    -- SHOOTING STAR (ดาวตกเฉียดขอบปุ่ม)
    task.spawn(function()
        while Alive() do
            task.wait(math.random(3, 6))
            if not Alive() then break end
            local YOffset = math.random(-6, 6)

            if HELLO.Theme.IsHalloween then
                -- ค้างคาวบินผ่านแทนดาวตก
                local Bat = Create("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size        = UDim2.fromOffset(20, 20),
                    Position    = UDim2.new(0.5, 72, 0.5, -54 + YOffset),
                    BackgroundTransparency = 1,
                    Text        = "\u{1F987}",
                    TextSize    = 16,
                    TextColor3  = White,
                    ZIndex      = 8,
                })
                Bat.Parent = FX
                PlayTween(Bat, 1.3, {
                    Position = UDim2.new(0.5, -72, 0.5, -38 + YOffset),
                    TextTransparency = 1,
                }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                task.delay(1.35, function() Bat:Destroy() end)
                continue
            end

            local Streak = Create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size        = UDim2.fromOffset(28, 2),
                Position    = UDim2.new(0.5, 72, 0.5, -62 + YOffset),
                Rotation    = -9,
                BackgroundColor3 = White,
                BackgroundTransparency = 0,
                BorderSizePixel = 0,
                ZIndex = 8,
            })
            Streak.Parent = FX

            local Grad = Instance.new("UIGradient")
            Grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            })
            Grad.Parent = Streak

            PlayTween(Streak, 0.8, {
                Position = UDim2.new(0.5, -72, 0.5, -40 + YOffset),
                BackgroundTransparency = 1,
            }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.85, function() Streak:Destroy() end)
        end
    end)
end

