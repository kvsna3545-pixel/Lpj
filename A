            local obj = tab.IconObject
            if not obj then return end
            if obj:IsA("ImageLabel") then
                PlayTween(obj, 0.15, { ImageColor3 = color })
            else
                PlayTween(obj, 0.15, { TextColor3 = color })
            end
        end
        Tab.IconObject = IconObject

        -- HALLOWEEN TAB ACCENT (แถบส้ม + ขอบเรืองแสงของแท็บที่เลือก)
