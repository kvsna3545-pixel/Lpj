                    ImageColor3 = HELLO.Theme.SubText,
                    ScaleType   = Enum.ScaleType.Fit,
                })
            else
                IconObject = Create("TextLabel", {
                    Size = UDim2.fromOffset(18, 18),
                    Position = UDim2.new(0, -26, 0.5, -9),
                    BackgroundTransparency = 1,
                    Text = iconData,
                    TextColor3 = HELLO.Theme.SubText,
                    TextSize   = 16,
                    Font       = Enum.Font.GothamBold,
                })
            end
            IconObject.Parent = TabButton
