function HELLO:CreateFloatingButton(Config)
    Config = Config or {}
    local Name = Config.Name or "ปุ่ม"
    local Mode = Config.Mode or "Toggle"
    local Callback = Config.Callback or function() end

    local W = Config.Width or 156
    local H = Config.Height or 60
    local CornerRadius = Config.Corner or 28

    local IS_HALLOWEEN = HELLO.Theme.ThemeId == "halloween" or HELLO.Theme.IsHalloween
    local C = IS_HALLOWEEN and HELLO.Themes.Halloween or HELLO.Themes.Grey

    local GUI_NAME = "KRYVEX_FloatingButtons_" .. Name
    local Gui = GetParent()
    
    local old = Gui:FindFirstChild(GUI_NAME)
    if old then old:Destroy() end

    local FloatingGui = Create("ScreenGui", {
        Name = GUI_NAME,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    FloatingGui.Parent = Gui

    local Dead = false
    local Connections = {}
    local function Track(con) table.insert(Connections, con) return con end

    local Camera = workspace.CurrentCamera or workspace:WaitForChild("Camera")

    local function ClampPos(pos)
        local view = Camera.ViewportSize
        local margin = 4
        return Vector2.new(
            math.clamp(pos.X, margin, math.max(margin, view.X - W - margin)),
            math.clamp(pos.Y, margin, math.max(margin, view.Y - H - margin))
        )
    end

    local Pos = ClampPos(Vector2.new(60, Camera.ViewportSize.Y / 2 - H / 2))
    local Target = Pos

    local Holder = Create("Frame", {
        Name = "Holder",
        Size = UDim2.fromOffset(W, H),
        Position = UDim2.fromOffset(Pos.X, Pos.Y),
        BackgroundTransparency = 1,
    })
    Holder.Parent = FloatingGui

    local Button = Create("TextButton", {
        Name = "SpaceButton",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = C.White,
        AutoButtonColor = false,
        Text = "",
    })
    Button.Parent = Holder
    AddCorner(Button, CornerRadius)

    Create("UIGradient", {
        Rotation = 45,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.BgTop),
            ColorSequenceKeypoint.new(1, C.BgBottom),
        }),
    }, Button)

    local Scale = Create("UIScale", { Scale = 1 }, Button)
    local EdgeStroke = AddStroke(Button, C.White, 0, 2)

    local EdgeGrad = Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C.Dark),
            ColorSequenceKeypoint.new(0.35, C.Light),
            ColorSequenceKeypoint.new(0.7, C.Silver),
            ColorSequenceKeypoint.new(1, C.Dark),
        }),
    }, EdgeStroke)

    local Inner = Create("Frame", {
        Name = "Inner",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
    }, Button)
    AddCorner(Inner, CornerRadius)

    local TitleLabel = Create("TextLabel", {
        Name = "Title",
        Position = UDim2.new(0, 60, 0.5, -17),
        Size = UDim2.new(1, -72, 0, 16),
        BackgroundTransparency = 1,
        Text = Name,
        TextColor3 = C.TitleOff,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 8,
    }, Inner)

    local StatusDot = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 64, 0.5, 9),
        Size = UDim2.fromOffset(7, 7),
        BackgroundColor3 = C.Dark,
        BorderSizePixel = 0,
        ZIndex = 8,
    }, Inner)
    AddCorner(StatusDot, 7)
    local DotGlow = AddStroke(StatusDot, C.On, 1, 2)

    local StatusLabel = Create("TextLabel", {
        Name = "Status",
        Position = UDim2.new(0, 73, 0.5, 1),
        Size = UDim2.new(1, -85, 0, 16),
        BackgroundTransparency = 1,
        Text = Mode == "Button" and "กดเพื่อใช้" or "ปิด",
        TextColor3 = C.Off,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 8,
    }, Inner)

    local Active = false
    local Busy = false

    local function SetState(on)
        StatusLabel.Text = on and (Config.OnText or "เปิด") or (Config.OffText or "ปิด")
        PlayTween(StatusLabel, 0.2, { TextColor3 = on and C.On or C.Off })
        PlayTween(StatusDot, 0.25, { BackgroundColor3 = on and C.On or C.Dark })
        PlayTween(DotGlow, 0.25, { Transparency = on and 0.45 or 1 })
        PlayTween(TitleLabel, 0.25, { TextColor3 = on and C.TitleOn or C.TitleOff })
    end

    Track(RunService.Heartbeat:Connect(function(Dt)
        if Dead or not Holder.Parent then return end
        if Pos ~= Target then
            Pos = Pos:Lerp(Target, 1 - math.exp(-Dt * 28))
            Holder.Position = UDim2.fromOffset(math.round(Pos.X), math.round(Pos.Y))
        end
        EdgeGrad.Rotation = (os.clock() * 60) % 360
    end))

    local Hovering, Dragging, Moved = false, false, false
    local DragInput, DragOrigin, DragStartPos

    Track(Button.MouseEnter:Connect(function()
        Hovering = true
        if not Dragging then
            PlayTween(Scale, 0.18, { Scale = 1.08 })
            PlayTween(EdgeStroke, 0.18, { Thickness = 2.5 })
        end
    end))

    Track(Button.MouseLeave:Connect(function()
        Hovering = false
        if not Dragging then
            PlayTween(Scale, 0.18, { Scale = 1 })
            PlayTween(EdgeStroke, 0.18, { Thickness = 2 })
        end
    end))

    Track(Button.InputBegan:Connect(function(Input)
        if Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging, Moved = true, false
            DragInput, DragOrigin, DragStartPos = Input, Input.Position, Target
        end
    end))

    Track(UserInputService.InputChanged:Connect(function(Input)
        if not Dragging or not DragInput then return end
        local delta = Vector2.new(Input.Position.X - DragOrigin.X, Input.Position.Y - DragOrigin.Y)
        if not Moved then
            if delta.Magnitude < 6 then return end
            Moved = true
            DragOrigin, DragStartPos = Input.Position, Target
            PlayTween(Scale, 0.15, { Scale = 0.94 })
            return
        end
        Target = ClampPos(DragStartPos + delta)
    end))

    Track(UserInputService.InputEnded:Connect(function(Input)
        if not Dragging then return end
        if Input == DragInput or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
            if Moved then
                PlayTween(Scale, 0.22, { Scale = Hovering and 1.08 or 1 }, Enum.EasingStyle.Back)
            end
            DragInput = nil
        end
    end))

    Track(Button.Activated:Connect(function()
        if Moved then return end
        PlayTween(Scale, 0.08, { Scale = 0.86 })
        task.delay(0.09, function()
            if not Dead then
                PlayTween(Scale, 0.25, { Scale = Hovering and 1.08 or 1 }, Enum.EasingStyle.Back)
            end
        end)

        if Mode == "Button" then
            if Busy then return end
            Busy = true
            task.spawn(function()
                pcall(Callback)
                StatusLabel.Text = "พร้อม"
                task.wait(0.3)
                Busy = false
            end)
            return
        end

        Active = not Active
        SetState(Active)
        task.spawn(function() pcall(Callback, Active) end)
    end))

    local Handle = {}
    function Handle:Destroy()
        if Dead then return end
        Dead = true
        for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
        pcall(function() FloatingGui:Destroy() end)
    end
    return Handle
end

