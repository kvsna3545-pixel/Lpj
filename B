    Window.ScreenGui = ScreenGui

    local Main = Create("Frame", {
        Size = UDim2.fromOffset(700, 440),
        Position = UDim2.new(0.5, -350, 0.5, -220),
        BackgroundColor3 = HELLO.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    Main.Parent = ScreenGui
    AddCorner(Main, 16)

    -- HEADER
    local Header = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundTransparency = 1,
        Active = true,
    })
    Header.Parent = Main

    local Title = Create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 24),
        Position = UDim2.fromOffset(18, 17),
        BackgroundTransparency = 1,
        Text = Window.Title,
        TextColor3 = HELLO.Theme.Text,
        TextSize = 17,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    Title.Parent = Header

    -- SIDEBAR
    local Sidebar = Create("Frame", {
        Size = UDim2.new(0, 190, 1, -58),
        Position = UDim2.fromOffset(0, 58),
        BackgroundColor3 = HELLO.Theme.Sidebar,
        BackgroundTransparency = HELLO.Glass.Sidebar,
        BorderSizePixel = 0,
    })
    Sidebar.Parent = Main

    local TabHolder = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.fromOffset(10, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    TabHolder.Parent = Sidebar

    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Padding = UDim.new(0, 5)
    TabLayout.Parent  = TabHolder

    -- CONTENT
    local Content = Create("Frame", {
        Size = UDim2.new(1, -190, 1, -58),
        Position = UDim2.new(0, 190, 0, 58),
        BackgroundTransparency = 1,
    })
    Content.Parent = Main

    function Window:CreateTab(name)
        local Tab = {}
        local Page = Create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        })
        Page.Parent = Content

        local PagePadding = Instance.new("UIPadding")
        PagePadding.PaddingTop = UDim.new(0, 12)
        PagePadding.PaddingBottom = UDim.new(0, 12)
        PagePadding.PaddingLeft = UDim.new(0, 12)
        PagePadding.PaddingRight = UDim.new(0, 12)
        PagePadding.Parent = Page

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.Parent  = Page

        local TabButton = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = HELLO.Theme.SubText,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
        })
        TabButton.Parent = TabHolder
        AddCorner(TabButton, 8)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 12)
        pad.Parent = TabButton

        function Tab:Select()
            for _, t in ipairs(Window.Tabs) do
                PlayTween(t.Button, 0.15, { BackgroundTransparency = 1, TextColor3 = HELLO.Theme.SubText })
                t.Page.Visible = false
            end
            PlayTween(TabButton, 0.15, { BackgroundColor3 = HELLO.Theme.PrimaryDark, BackgroundTransparency = 0.15, TextColor3 = HELLO.Theme.Text })
            Page.Visible = true
        end

        TabButton.Activated:Connect(function() Tab:Select() end)
        if #Window.Tabs == 0 then Tab:Select() end
        table.insert(Window.Tabs, Tab)
        Tab.Button = TabButton
        Tab.Page = Page

        -- CREATE BUTTON
        function Tab:CreateButton(config)
            config = config or {}
            local ButtonFrame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = HELLO.Theme.Card,
            })
            ButtonFrame.Parent = Page
            AddCorner(ButtonFrame, 8)

            local Button = Create("TextButton", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = tostring(config.Name or "Button"),
                TextColor3 = HELLO.Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamSemibold,
            })
            Button.Parent = ButtonFrame

            Button.Activated:Connect(function()
                if config.Callback then task.spawn(config.Callback) end
            end)
            return ButtonFrame
        end

        -- CREATE TOGGLE
        function Tab:CreateToggle(config)
            config = config or {}
            local state = config.Default or false

            local Frame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = HELLO.Theme.Card,
            })
            Frame.Parent = Page
            AddCorner(Frame, 8)

            local Label = Create("TextLabel", {
                Size = UDim2.new(1, -70, 1, 0),
                Position = UDim2.fromOffset(14, 0),
                BackgroundTransparency = 1,
                Text = tostring(config.Name or "Toggle"),
                TextColor3 = HELLO.Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamSemibold,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            Label.Parent = Frame

            local Toggle = Create("TextButton", {
                Size = UDim2.fromOffset(44, 24),
                Position = UDim2.new(1, -14, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = state and HELLO.Theme.Primary or HELLO.Theme.ToggleOff,
                Text = "",
                AutoButtonColor = false,
            })
            Toggle.Parent = Frame
            AddCorner(Toggle, 12)

            local Circle = Create("Frame", {
                Size = UDim2.fromOffset(18, 18),
                Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = Color3.new(1, 1, 1),
            })
            Circle.Parent = Toggle
            AddCorner(Circle, 20)

            local function Update()
                PlayTween(Toggle, 0.18, { BackgroundColor3 = state and HELLO.Theme.Primary or HELLO.Theme.ToggleOff })
                PlayTween(Circle, 0.18, { Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) })
                if config.Callback then task.spawn(config.Callback, state) end
            end

            Toggle.Activated:Connect(function()
                state = not state
                Update()
            end)

            return { Set = function(_, v) state = v Update() end, Get = function() return state end }
        end

        return Tab
    end

    return Window
end

return HELLO
