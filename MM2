local function GetNearestCoin(root)
    local near, dist = nil, math.huge
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o.Name == "Coin_Server" and o:IsA("BasePart")
        and o:FindFirstChild("TouchInterest") and o:FindFirstChild("CoinVisual")
        and not CollectedCoins[o] and not o:GetAttribute("Collected") then
            local d = (root.Position - o.Position).Magnitude
            if d < dist then near, dist = o, d end
        end
    end
    return near
end

local function FlyToCoin(coin)
    local r, h = getRoot(), getHum()
    if not r or not h then return end
    h.PlatformStand = true
    local start = tick()
    while CoinFarmEnabled and coin and coin.Parent and r.Parent do
        if tick() - start > 10 then break end
        if coin:GetAttribute("Collected") then break end
        local target = coin.Position
        if FlyMode == "นอนคว่ำ" then target = target - Vector3.new(0,2.5,0) end
        local diff = target - r.Position
        if diff.Magnitude <= 2 then break end
        r.AssemblyLinearVelocity = diff.Unit * FlySpeedFarm
        if FlyMode == "นอนคว่ำ" then
            r.CFrame = CFrame.new(r.Position, coin.Position) * CFrame.Angles(math.rad(90),0,0)
        else
            r.CFrame = CFrame.new(r.Position, coin.Position)
        end
        SetFarmNoclip(true)
        RunService.Heartbeat:Wait()
    end
    if coin then CollectedCoins[coin] = true end
    StartedCollecting = true
    if r and r.Parent then r.AssemblyLinearVelocity = Vector3.zero end
end

local function StartCoinFarm()
    if CoinFarmRunning then return end
    CoinFarmRunning = true
    task.spawn(function()
        while CoinFarmEnabled do
            pcall(function()
                local r = getRoot()
                if not r then task.wait(1) return end
                SetFarmNoclip(true)
                local coin = GetNearestCoin(r)
                if coin then
                    FlyToCoin(coin)
                elseif AutoReset and StartedCollecting then
                    CollectedCoins = {}
                    StartedCollecting = false
                    local h = getHum() if h then h.Health = 0 end
                    task.wait(2)
                else
                    task.wait(0.2)
                end
            end)
            task.wait(0.05)
        end
        CoinFarmRunning = false
    end)
end

