-- FOV Aimlock
local Camera = Workspace.CurrentCamera
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(150,150,150)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.7
FOVCircle.NumSides = 64

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOVCircle.Position = center
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimLockEnabled

    if AimLockEnabled then
        local M = FindMurderer()
        if M and M.Character then
            local T = M.Character:FindFirstChild("Head") or M.Character:FindFirstChild("HumanoidRootPart")
            if T then
                local sp, on = Camera:WorldToViewportPoint(T.Position)
                if on and (Vector2.new(sp.X,sp.Y) - center).Magnitude <= FOVRadius then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, T.Position)
                end
            end
        end
    end
end)

