--============================================================
local function GetRole(P)
    if P.Character then
        local r = P.Character:FindFirstChild("Role")
        if r and r:IsA("StringValue") then return r.Value end
    end
    local bp = P:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun")   then return "Sheriff"  end
    end
    if P.Character then
        if P.Character:FindFirstChild("Knife") then return "Murderer" end
        if P.Character:FindFirstChild("Gun")   then return "Sheriff"  end
    end
    return "Innocent"
end
local function RemoveESP(P)
    if ESPObjects[P] then ESPObjects[P]:Destroy() ESPObjects[P] = nil end
end
local function CreateESP(P)
    if P == LocalPlayer or not P.Character then return end
    local role = GetRole(P)
    local enabled = (role=="Murderer" and State.MurdererESP)
                 or (role=="Sheriff"  and State.SheriffESP)
                 or (role=="Innocent" and State.InnocentESP)
    if not enabled then RemoveESP(P) return end
    RemoveESP(P)
    local h = Instance.new("Highlight")
    h.Adornee = P.Character
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    if role == "Murderer" then
        h.FillColor = Color3.fromRGB(255,60,60) h.OutlineColor = Color3.fromRGB(255,0,0)
    elseif role == "Sheriff" then
        h.FillColor = Color3.fromRGB(60,140,255) h.OutlineColor = Color3.fromRGB(0,100,255)
    else
        h.FillColor = Color3.fromRGB(80,255,120) h.OutlineColor = Color3.fromRGB(0,255,80)
    end
    h.Parent = P.Character
    ESPObjects[P] = h
end
local function UpdateAllESP()
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer then CreateESP(P) end
    end
end
