local function RemoveShootMarker()
    if ShootMarker then ShootMarker:Destroy() ShootMarker = nil end
end

local function UpdateShootMarker()
    if not State.ShowShootMarker then RemoveShootMarker() return end
    local M = FindMurderer()
    if not M or not M.Character then RemoveShootMarker() return end
    local Target = GetTargetPart(M.Character, State.TargetPart)
    if not Target then RemoveShootMarker() return end

    if not ShootMarker then
        ShootMarker = Instance.new("Part")
        ShootMarker.Name         = "KRYVEX_ShootPosition"
        ShootMarker.Shape        = Enum.PartType.Ball
        ShootMarker.Size         = Vector3.new(0.7, 0.7, 0.7)
        ShootMarker.Material     = Enum.Material.Neon
        ShootMarker.Color        = Color3.fromRGB(255, 70, 70)
        ShootMarker.Transparency = 0.2
        ShootMarker.Anchored     = true
        ShootMarker.CanCollide   = false
        ShootMarker.CanTouch     = false
        ShootMarker.CanQuery     = false
        ShootMarker.CastShadow   = false
        ShootMarker.Parent       = Workspace
    end

    ShootMarker.Position = CalcOrigin(
        Target, Target.Position, State.OriginMode,
        math.max(State.ShootDistance, 1.5)
    )
end

task.spawn(function()
    while task.wait(0.1) do
        if State.ShowShootMarker then UpdateShootMarker() end
    end
end)

local function ShootMurderer()
    if tick() - shootDebounce < 0.35 then return end
    shootDebounce = tick()

    local Char = getChar()
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    local HRP = Char:FindFirstChild("HumanoidRootPart")
    if not Hum or not HRP or Hum.Health <= 0 then
        Window:Notify({Title="นายอำเภอ", Content="คุณตายแล้ว", Duration=2})
        return
    end

    local Gun = Char:FindFirstChild("Gun")
    if not Gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        Gun = bp and bp:FindFirstChild("Gun")
    end
    if not Gun then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบปืน (คุณไม่ใช่นายอำเภอ?)", Duration=3})
        return
    end

    if Gun.Parent ~= Char then
        pcall(function() Hum:EquipTool(Gun) end)
        for _ = 1, 20 do
            task.wait(0.05)
            if Char:FindFirstChild("Gun") then break end
        end
        Gun = Char:FindFirstChild("Gun") or Gun
    end

    local M = FindMurderer()
    if not M or not M.Character then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบฆาตกร", Duration=2})
        return
    end
    local MHum = M.Character:FindFirstChildOfClass("Humanoid")
    if MHum and MHum.Health <= 0 then
        Window:Notify({Title="นายอำเภอ", Content="ฆาตกรตายแล้ว", Duration=2})
        return
    end

    local MTarget = GetTargetPart(M.Character, State.TargetPart)
    if not MTarget then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบส่วน "..State.TargetPart, Duration=2})
        return
    end

    local Shoot = FindShootRemote(Gun)
    if not Shoot then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบ Shoot Remote", Duration=4})
        return
    end

    local targetPos = MTarget.Position
    local dist = math.max(State.ShootDistance, 1.5)

    if State.OriginMode == "วาร์ปแล้วยิง" then
        HRP.CFrame = CFrame.new(targetPos + Vector3.new(0, 0, 5))
        task.wait(0.1)
    end

    local originPos = CalcOrigin(MTarget, targetPos, State.OriginMode, dist)
    local OriginCF  = CFrame.new(originPos, targetPos)
    local TargetCF  = CFrame.new(targetPos)

    local success, lastErr = false, nil
    for _ = 1, 3 do
        local ok, err = pcall(function() Shoot:FireServer(OriginCF, TargetCF) end)
        if ok then success = true break end
        lastErr = err
        task.wait(0.1)
    end

    if success then
        Window:Notify({
            Title = "นายอำเภอ",
            Content = ("ยิง %s [%s/%s]"):format(M.Name, State.TargetPart, State.OriginMode),
            Duration = 2,
        })
    else
        Window:Notify({
            Title = "นายอำเภอ",
            Content = "ยิงไม่สำเร็จ: " .. tostring(lastErr),
            Duration = 3,
        })
    end
end

