local function ActivateKillAura()
    if IsAuraActive then return end
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    IsAuraActive = true
    Window:Notify({Title="ฆาตกร", Content="ดึงผู้เล่นมาไว้ตรงหน้า (2 วินาที)!", Duration=2})
    local start = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if tick() - start >= 2 then conn:Disconnect() IsAuraActive = false return end
        local front = hrp.CFrame * CFrame.new(0,0,-3.5)
        for _, P in ipairs(Players:GetPlayers()) do
            if P ~= LocalPlayer and P.Character then
                local thrp = P.Character:FindFirstChild("HumanoidRootPart")
                local th = P.Character:FindFirstChildOfClass("Humanoid")
                if thrp and th and th.Health > 0 then thrp.CFrame = front end
            end
        end
    end)
end
