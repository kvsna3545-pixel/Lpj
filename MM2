local function getChar() return LocalPlayer.Character end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function FindMurderer()
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer then
            local c, bp = P.Character, P:FindFirstChild("Backpack")
            if (c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then
                return P
            end
        end
    end
    return nil
end

-- หา BasePart ตามจุดเล็ง
local function GetTargetPart(character, partName)
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if partName == "หัว" then
        return character:FindFirstChild("Head") or hrp
    elseif partName == "ตัว" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso") or hrp
    elseif partName == "ลำตัวล่าง" then
        return character:FindFirstChild("LowerTorso")
            or character:FindFirstChild("Torso") or hrp
    elseif partName == "เท้า" then
        return character:FindFirstChild("LeftFoot")
            or character:FindFirstChild("RightFoot")
            or character:FindFirstChild("LeftLeg")
            or character:FindFirstChild("RightLeg") or hrp
    elseif partName == "แขน" then
        return character:FindFirstChild("LeftHand")
            or character:FindFirstChild("RightHand")
            or character:FindFirstChild("LeftLowerArm")
            or character:FindFirstChild("RightLowerArm") or hrp
    elseif partName == "ขา" then
        return character:FindFirstChild("LeftUpperLeg")
            or character:FindFirstChild("RightUpperLeg")
            or character:FindFirstChild("LeftLeg")
            or character:FindFirstChild("RightLeg") or hrp
    end
    return hrp
end

local function FindShootRemote(gun)
    if not gun then return nil end
    local s = gun:FindFirstChild("Shoot")
    if s and s:IsA("RemoteEvent") then return s end
    for _, c in ipairs(gun:GetDescendants()) do
        if c:IsA("RemoteEvent") and c.Name:lower():find("shoot") then return c end
    end
    if getnilinstances then
        for _, o in ipairs(getnilinstances()) do
            if o:IsA("RemoteEvent") and o.Name == "Shoot" then return o end
        end
    end
    for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
        if o:IsA("RemoteEvent") and o.Name == "Shoot" then return o end
    end
    return nil
end

-- คำนวณ Origin ตำแหน่ง Ray เริ่ม
local function CalcOrigin(targetPart, targetPos, mode, dist)
    if mode == "เหนือหัว" then
        return targetPos + Vector3.new(0, dist, 0)
    elseif mode == "หน้า" then
        local hrp = getRoot()
        if hrp then
            local dir = (targetPos - hrp.Position)
            if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
            return targetPos - dir.Unit * dist
        end
        return targetPos + Vector3.new(0, dist, 0)
    elseif mode == "หลัง" then
        return targetPos + targetPart.CFrame.LookVector * dist
    elseif mode == "ข้างขวา" then
        return targetPos + targetPart.CFrame.RightVector * dist
    elseif mode == "ข้างซ้าย" then
        return targetPos - targetPart.CFrame.RightVector * dist
    elseif mode == "ใกล้ตัว" then
        return targetPos + Vector3.new(0, 1, 0)
    else -- "วาร์ปแล้วยิง"
        return targetPos + Vector3.new(0, 1.5, 0)
    end
end

