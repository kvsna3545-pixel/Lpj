local function FindTrollPlayerWithTool(name)
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer then
            local c, bp = P.Character, P:FindFirstChild("Backpack")
            if (c and c:FindFirstChild(name)) or (bp and bp:FindFirstChild(name)) then return P end
        end
    end
    return nil
end

local function FlingPlayer(Target)
    if not Target or Target == LocalPlayer or not Target.Parent then return end
    if FlingRunning[Target] then return end
    local c = LocalPlayer.Character if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart") if not r then return end
    local tc = Target.Character if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart") if not tr then return end
    FlingRunning[Target] = true
    local oldCF, oldPos = r.CFrame, r.Position
    local forceConn = nil
    local running = true
    forceConn = RunService.Heartbeat:Connect(function()
        if not running or not r or not r.Parent then return end
        r.AssemblyLinearVelocity = r.AssemblyLinearVelocity * 8000 + Vector3.new(0, 8000, 0)
    end)
    local start = tick()
    while tick() - start < 1.5 do
        if not running or not r.Parent or not tr.Parent then break end
        r.CFrame = tr.CFrame
        local d = tr.Position - r.Position
        if d.Magnitude > 0 then r.AssemblyLinearVelocity = d.Unit * 150 end
        RunService.Heartbeat:Wait()
    end
    running = false
    if forceConn then forceConn:Disconnect() end
    if r and r.Parent then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
        r.CFrame = oldCF
        task.wait()
        if (r.Position - oldPos).Magnitude > 10 then r.CFrame = oldCF end
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    FlingRunning[Target] = nil
end

