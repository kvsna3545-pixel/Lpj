local function RemoveShootMarker()
    if ShootMarker then ShootMarker:Destroy() ShootMarker = nil end
end

local function UpdateShootMarker()
    if not ShowShootMarker then RemoveShootMarker() return end
    local M = FindMurderer()
    if not M or not M.Character then RemoveShootMarker() return end
    local T = M.Character:FindFirstChild("Head") or M.Character:FindFirstChild("HumanoidRootPart")
    if not T then RemoveShootMarker() return end
    if not ShootMarker then
        ShootMarker = Instance.new("Part")
        ShootMarker.Name = "KRYVEX_ShootPosition"
        ShootMarker.Shape = Enum.PartType.Ball
        ShootMarker.Size = Vector3.new(0.7,0.7,0.7)
        ShootMarker.Material = Enum.Material.Neon
        ShootMarker.Color = Color3.fromRGB(255,70,70)
        ShootMarker.Transparency = 0.2
        ShootMarker.Anchored = true
        ShootMarker.CanCollide = false
        ShootMarker.CanTouch = false
        ShootMarker.CanQuery = false
        ShootMarker.CastShadow = false
        ShootMarker.Parent = Workspace
    end
    ShootMarker.Position = T.Position + T.CFrame.LookVector * ShootDistance
end

task.spawn(function()
    while task.wait() do
        if ShowShootMarker then UpdateShootMarker() end
    end
end)

local function ShootMurderer()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    if not Hum then return end
    local Gun = Char:FindFirstChild("Gun")
    if not Gun then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then Gun = bp:FindFirstChild("Gun") end
    end
    if not Gun then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบ Gun", Duration=3})
        return
    end
    if Gun.Parent ~= Char then Hum:EquipTool(Gun) task.wait(0.05) end
    Char = LocalPlayer.Character
    if not Char then return end
    Gun = Char:FindFirstChild("Gun")
    if not Gun then return end
    local Shoot = Gun:FindFirstChild("Shoot") or getNilInstance("Shoot","RemoteEvent")
    if not Shoot then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบ Shoot Remote", Duration=3})
        return
    end
    local M = FindMurderer()
    if not M or not M.Character then
        Window:Notify({Title="นายอำเภอ", Content="ไม่พบฆาตกร", Duration=3})
        return
    end
    local T = M.Character:FindFirstChild("Head") or M.Character:FindFirstChild("HumanoidRootPart")
    if not T then return end
    local TP = T.Position
    local SP = TP + T.CFrame.LookVector * ShootDistance
    Shoot:FireServer(CFrame.new(SP, TP), CFrame.new(TP))
    Window:Notify({Title="นายอำเภอ", Content="ยิงฆาตกรแล้ว • ระยะ "..string.format("%.1f",ShootDistance).." studs", Duration=3})
end

