local function GetPlayerNames()
    local L = {}
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer then table.insert(L, P.Name) end
    end
    table.sort(L)
    if #L == 0 then table.insert(L, "ไม่มีผู้เล่น") end
    return L
end

local function TeleportToPlayer(P)
    local myR = getRoot()
    local tR = P and P.Character and P.Character:FindFirstChild("HumanoidRootPart")
    if not myR then Window:Notify({Title="วาร์ป", Content="ไม่พบตัวละครคุณ", Duration=2}) return end
    if not tR then Window:Notify({Title="วาร์ป", Content="ไม่พบตัวละครเป้าหมาย", Duration=2}) return end
    myR.CFrame = tR.CFrame * CFrame.new(0, 0, 3)
    Window:Notify({Title="วาร์ป", Content="วาร์ปไปหา "..P.Name.." แล้ว", Duration=2})
end

local function FindRole(RoleName)
    for _, P in ipairs(Players:GetPlayers()) do
        if P ~= LocalPlayer then
            local c, bp = P.Character, P:FindFirstChild("Backpack")
            if RoleName == "Murderer" then
                if (c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return P end
            elseif RoleName == "Sheriff" then
                if (c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return P end
            end
        end
    end
    return nil
end

local function TeleportToRole(Role)
    local T = FindRole(Role)
    if not T then Window:Notify({Title="วาร์ป", Content="ไม่พบบทบาทนี้", Duration=2}) return end
    TeleportToPlayer(T)
end

