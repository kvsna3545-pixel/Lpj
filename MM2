local function GetCF(o)
    if o:IsA("BasePart") then return o.CFrame end
    if o:IsA("Model") then
        if o.PrimaryPart then return o.PrimaryPart.CFrame end
        local p = o:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.CFrame end
    end
    return nil
end
