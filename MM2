-- Anti-fling
local function SetAntiFling(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if OriginalCollision[p] == nil then OriginalCollision[p] = p.CanCollide end
            p.CanCollide = false
        end
    end
end
local function RestoreCol()
    for p, v in pairs(OriginalCollision) do
        if p and p.Parent then p.CanCollide = v end
    end
    table.clear(OriginalCollision)
end
TrollTab:AddSection("ระบบป้องกัน")
TrollTab:AddToggle({
    Name="กันฟลิง", Default=false,
    Callback=function(v)
        State.AntiFlingEnabled = v
        if AntiFlingConn then AntiFlingConn:Disconnect() AntiFlingConn = nil end
        if not v then RestoreCol() return end
        if LocalPlayer.Character then SetAntiFling(LocalPlayer.Character) end
        AntiFlingConn = RunService.Heartbeat:Connect(function()
            if not State.AntiFlingEnabled then return end
            local c = LocalPlayer.Character
            if c then SetAntiFling(c) end
        end)
    end,
})
LocalPlayer.CharacterAdded:Connect(function(c)
