-- Knockback physics
local function StartKnockback()
    if KnockbackConnection then KnockbackConnection:Disconnect() KnockbackConnection = nil end
    local r = getRoot() if not r then return end
    KnockbackConnection = r.Touched:Connect(function(hit)
        if not KnockbackEnabled or KnockbackCooldown then return end
        if not hit or not hit:IsA("BasePart") then return end
        if hit:IsDescendantOf(LocalPlayer.Character) then return end
        KnockbackCooldown = true
        local d = r.Position - hit.Position
        if d.Magnitude < 0.1 then d = Vector3.new(math.random(-1,1),0,math.random(-1,1)) end
        d = d.Unit
        r.AssemblyLinearVelocity = d * 90 + Vector3.new(0,70,0)
        local spin = Instance.new("BodyAngularVelocity", r)
        spin.MaxTorque = Vector3.new(9e5,9e5,9e5)
        spin.AngularVelocity = Vector3.new(60,60,60)
        task.delay(1.2, function() if spin and spin.Parent then spin:Destroy() end end)
        task.delay(0.15, function() KnockbackCooldown = false end)
    end)
end
