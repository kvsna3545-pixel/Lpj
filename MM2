-- Fly
local FlyVelocity, FlyGyro, FlyConn = nil, nil, nil
local function StopFly()
    FlyEnabled = false
    if FlyConn then FlyConn:Disconnect() FlyConn = nil end
    if FlyVelocity then FlyVelocity:Destroy() FlyVelocity = nil end
    if FlyGyro then FlyGyro:Destroy() FlyGyro = nil end
    local h = getHum()
    if h then h.PlatformStand = false h.AutoRotate = true end
end
local function StartFly()
    StopFly()
    local c = getChar() if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    FlyEnabled = true
    FlyVelocity = Instance.new("BodyVelocity", r)
    FlyVelocity.Name = "KRYVEX_Fly"
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.P = 1000
    FlyVelocity.MaxForce = Vector3.new(1e5,1e5,1e5)
    FlyGyro = Instance.new("BodyGyro", r)
    FlyGyro.Name = "KRYVEX_FlyGyro"
    FlyGyro.P = 10000
    FlyGyro.MaxTorque = Vector3.new(1e6,1e6,1e6)
    FlyGyro.CFrame = r.CFrame
    h.PlatformStand = true
    h.AutoRotate = false
    h:ChangeState(Enum.HumanoidStateType.Freefall)
    FlyConn = RunService.Heartbeat:Connect(function()
        if not FlyEnabled then return end
        if not r.Parent or not h.Parent then StopFly() return end
        local cam = Workspace.CurrentCamera
        local md = h.MoveDirection
        local hd = Vector3.new(md.X, 0, md.Z)
        local vd = 0
        if cam.CFrame.LookVector.Y > 0.35 then vd = cam.CFrame.LookVector.Y
        elseif cam.CFrame.LookVector.Y < -0.35 then vd = cam.CFrame.LookVector.Y end
        local vel = Vector3.zero
        if hd.Magnitude > 0 then vel = hd.Unit * FlySpeedPlayer * 50 end
        vel = vel + Vector3.new(0, vd * FlySpeedPlayer * 50, 0)
        FlyVelocity.Velocity = vel
        FlyGyro.CFrame = cam.CFrame
    end)
end
