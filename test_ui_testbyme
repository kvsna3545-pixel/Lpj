local Theme = table.clone(CONFIG.Themes.Hello)

local function create(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, obj)
end

local function addStroke(obj, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or Theme.Stroke,
        Transparency = transparency == nil and 0.5 or transparency,
        Thickness = thickness or 1
    }, obj)
end

local function addPadding(obj, left, right, top, bottom)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0)
    }, obj)
end

local function isAlive(obj)
    return obj ~= nil and obj.Parent ~= nil
end

local function tween(obj, duration, props, style, direction)
    if not isAlive(obj) then return nil end
    local info = TweenInfo.new(
        duration or CONFIG.Anim.Normal,
        style or CONFIG.Anim.Smooth,
        direction or Enum.EasingDirection.Out
    )
    local animation = TweenService:Create(obj, info, props)
    animation:Play()
    return animation
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then return end
    local args = table.pack(...)
    local ok, err = xpcall(function()
        callback(table.unpack(args, 1, args.n))
    end, debug.traceback)
    if not ok then
        warn("[HelloHub] Callback error:\n" .. tostring(err))
    end
end

local function addConnection(owner, connection)
    owner.Connections = owner.Connections or {}
    table.insert(owner.Connections, connection)
    return connection
end

local function disconnectAll(connections)
    for _, connection in ipairs(connections or {}) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(connections or {})
end

local function setRole(instance, property, role)
    if instance then
        instance:SetAttribute("HHThemeProperty", property)
        instance:SetAttribute("HHThemeRole", role)
    end
end

local function themed(className, props, parent, roleMap)
    local obj = create(className, props, parent)
    for property, role in pairs(roleMap or {}) do
        setRole(obj, property, role)
    end
    return obj
end

function Effects.Glow(target, color, speed)
    if not isAlive(target) then return nil end
    local glow = addStroke(target, color or Theme.Accent, 0.5, 2)
    local alive = true
    target.Destroying:Connect(function() alive = false end)
    task.spawn(function()
        while alive and isAlive(target) and isAlive(glow) do
            tween(glow, speed or 1, {Transparency = 0.8}, Enum.EasingStyle.Sine)
            task.wait(speed or 1)
            if not alive or not isAlive(glow) then break end
            tween(glow, speed or 1, {Transparency = 0.2}, Enum.EasingStyle.Sine)
            task.wait(speed or 1)
        end
    end)
    return glow
end

local function particleBurst(parent, color)
    if not isAlive(parent) then return end
    for _ = 1, 8 do
        local particle = create("Frame", {
            Size = UDim2.fromOffset(math.random(3, 6), math.random(3, 6)),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundColor3 = color or Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 100
        }, parent)
        corner(particle, 100)
        local angle = math.rad(math.random(0, 359))
        local distance = math.random(20, 40)
        tween(particle, 0.4, {
            Position = UDim2.new(0.5, math.cos(angle) * distance, 0.5, math.sin(angle) * distance),
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(0, 0)
        })
        task.delay(0.45, function()
            if isAlive(particle) then particle:Destroy() end
        end)
    end
end

local function spawnAmbient(container, effectName, theme)
    if not isAlive(container) then return end
    local x = math.random()
    local item
    if effectName == "Stars" or effectName == "Sparkles" then
        item = create("TextLabel", {
            Size = UDim2.fromOffset(14, 14),
            Position = UDim2.fromScale(x, math.random()),
            BackgroundTransparency = 1,
            Text = effectName == "Stars" and "✦" or "✧",
            TextColor3 = theme.Accent2,
            TextTransparency = 0.25,
            TextSize = math.random(10, 16),
            ZIndex = 2
        }, container)
        tween(item, 2, {TextTransparency = 1, Rotation = math.random(-160, 160)})
        task.delay(2.1, function()
            if isAlive(item) then item:Destroy() end
        end)
        return
    end
    local symbols = {
        Leaves = {"🍁", "🍂"},
        Hearts = {"♥"},
        Pumpkins = {"🎃"},
        Matrix = {"0", "1", "◇"}
    }
    if symbols[effectName] then
        local list = symbols[effectName]
        item = create("TextLabel", {
            Size = UDim2.fromOffset(20, 20),
            Position = UDim2.new(x, 0, -0.08, 0),
            BackgroundTransparency = 1,
            Text = list[math.random(1, #list)],
            TextColor3 = theme.Accent2,
            TextSize = 16,
            Font = Enum.Font.GothamBold,
            ZIndex = 2
        }, container)
    else
        item = create("Frame", {
            Size = UDim2.fromOffset(effectName == "Bubbles" and 14 or 6, effectName == "Bubbles" and 14 or 6),
            Position = UDim2.new(x, 0, 1.08, 0),
            BackgroundColor3 = effectName == "Snow" and Color3.new(1,1,1) or theme.Accent2,
            BackgroundTransparency = 0.25,
            BorderSizePixel = 0,
            ZIndex = 2
        }, container)
        corner(item, 100)
        if effectName == "Bubbles" then addStroke(item, theme.Accent2, 0.25, 1) end
    end
    local duration = math.random(4, 7)
    local targetY = (effectName == "Bubbles") and -0.1 or 1.08
    local target = {
        Position = UDim2.new(math.clamp(x + math.random(-10, 10) / 100, 0, 1), 0, targetY, 0),
        Rotation = math.random(-180, 180)
    }
    if item:IsA("TextLabel") then
        target.TextTransparency = 1
    else
        target.BackgroundTransparency = 1
    end
    local animation = tween(item, duration, target, Enum.EasingStyle.Linear)
    if animation then
        animation.Completed:Connect(function()
            if isAlive(item) then item:Destroy() end
        end)
    end
end

