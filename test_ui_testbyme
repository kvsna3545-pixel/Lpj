-- ============ Helpers ============
local function create(className, props, parent)
    local o = Instance.new(className)
    for k,v in pairs(props or {}) do o[k]=v end
    o.Parent = parent
    return o
end
local function corner(o,r) return create("UICorner",{CornerRadius=UDim.new(0,r or 14)},o) end
local function stroke(o,c,t,th) return create("UIStroke",{Color=c or Color3.fromRGB(255,140,0),Transparency=t==nil and 0.5 or t,Thickness=th or 1.2},o) end
local function alive(o) return o~=nil and o.Parent~=nil end
local function tween(o,d,props,style,dir)
    if not alive(o) then return nil end
    local tw = TweenService:Create(o,TweenInfo.new(d or 0.25,style or Enum.EasingStyle.Quint,dir or Enum.EasingDirection.Out),props)
    tw:Play(); return tw
end
local function safeCall(fn,...)
    if type(fn)~="function" then return end
    local a = table.pack(...)
    local ok,err = xpcall(function() fn(table.unpack(a,1,a.n)) end, debug.traceback)
    if not ok then warn("[YinYang] "..tostring(err)) end
end
local function formatTime(sec)
    local h = math.floor(sec/3600); local m = math.floor((sec%3600)/60); local s = math.floor(sec%60)
    return string.format("%02d:%02d:%02d",h,m,s)
end

-- ============ Real Stats Engine ============
local StatsEngine = {}
StatsEngine.StartTime = os.clock()
StatsEngine.FPS = 60
StatsEngine.Ping = 0
StatsEngine.PlayerCount = 0
StatsEngine.Region = "TH"
StatsEngine.ServerId = game.JobId ~= "" and game.JobId or "Studio"
StatsEngine.Listeners = {}

local _frameCount = 0
local _lastFpsTime = os.clock()
RunService.RenderStepped:Connect(function()
    _frameCount += 1
    local now = os.clock()
    if now - _lastFpsTime >= 0.5 then
        StatsEngine.FPS = math.floor(_frameCount / (now - _lastFpsTime) + 0.5)
        _frameCount = 0; _lastFpsTime = now
    end
end)
task.spawn(function()
    local plr = Players.LocalPlayer
    if plr then
        local ok, region = pcall(function() return LocalizationService:GetCountryRegionForPlayerAsync(plr) end)
        if ok and region and region ~= "" then StatsEngine.Region = region end
    end
    while true do
        StatsEngine.PlayerCount = #Players:GetPlayers()
        local p = Players.LocalPlayer
        if p then
            local ok, ping = pcall(function() return p:GetNetworkPing() end)
            if ok and ping then StatsEngine.Ping = math.floor(ping * 1000) end
        end
        -- แจ้งทุก StatCard ที่ผูกไว้ให้อัปเดต
        for _, fn in ipairs(StatsEngine.Listeners) do pcall(fn) end
        task.wait(0.5)
    end
end)
function StatsEngine.GetTime() return formatTime(os.clock() - StatsEngine.StartTime) end
function StatsEngine.GetStatus()
    if StatsEngine.FPS < 20 or StatsEngine.Ping > 400 then return "Laggy", "High ping / Low FPS" end
    if StatsEngine.FPS < 35 or StatsEngine.Ping > 250 then return "Warning", "Might lag a bit" end
    return "Healthy", "All systems operational"
end

