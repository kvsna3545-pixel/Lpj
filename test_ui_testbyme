function HelloHub.AddSystemTest(window)
    assert(window, "[HelloHub] Window is required")
    assert(not window.Destroyed, "[HelloHub] Window is destroyed")
    local tab = window:CreateTab({
        Name = "System Test",
        Icon = "🧪"
    })
    local status = tab:AddLabel("SYSTEM TESTER | Ready")
    local report = tab:AddLabel("No tests have been run.")
    local results = {}
    local passed = 0
    local failed = 0
    local function log(name, ok, detail)
        table.insert(results, {
            Name = name,
            Passed = ok,
            Detail = tostring(detail or "")
        })
        if ok then
            passed += 1
        else
            failed += 1
        end
        local resultText = ok and "PASS" or "FAIL"
        status:Set("[" .. resultText .. "] " .. name)
        report:Set(
            "Passed: " .. passed ..
            " | Failed: " .. failed ..
            " | Last: " .. name
        )
        if not ok then
            warn("[HelloHub Test] " .. name .. ": " .. tostring(detail))
        end
    end
    local function test(name, callback)
        local ok, result = pcall(callback)
        log(name, ok, ok and "OK" or result)
        return ok
    end
    tab:AddSection("🧪", "Automatic Tests")
    local runButton = tab:AddButton({
        Name = "Run All Tests",
        Callback = function()
            passed = 0
            failed = 0
            table.clear(results)
            status:Set("SYSTEM TESTER | Running...")
            report:Set("Testing HelloHub components...")
            test("Theme Configuration", function()
                assert(type(HelloHub.Config.Themes) == "table")
                assert(#HelloHub.GetThemes() == 11)
            end)
            test("Window API", function()
                assert(type(window.CreateTab) == "function")
                assert(type(window.SetTheme) == "function")
                assert(type(window.Notify) == "function")
                assert(type(window.Destroy) == "function")
            end)
            test("Theme Switching", function()
                local original = window.ThemeName
                assert(window:SetTheme("Ocean") == true)
                assert(window.ThemeName == "Ocean")
