                    Flag = "HH_Internal_Test_Toggle",
                    Callback = function(value)
                        callbackValue = value
                    end
                })
                toggle:Set(true)
                assert(toggle:Get() == true)
                assert(callbackValue == true)
                toggle:Set(false)
