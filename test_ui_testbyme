function Tab:AddSlider(options)
    options = options or {}
    local minValue = tonumber(options.Min) or 0
    local maxValue = tonumber(options.Max) or 100
    if maxValue < minValue then minValue, maxValue = maxValue, minValue end
    local range = maxValue - minValue
    local value = math.clamp(tonumber(options.Default) or minValue, minValue, maxValue)
    local card = createCard(self, 58, options)
    local label = themed("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(12, 5),
        BackgroundTransparency = 1,
        Text = (options.Name or "Slider") .. " : " .. tostring(value),
        TextColor3 = self.Window.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card, {TextColor3 = "Text"})
    local bar = themed("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.fromOffset(12, 37),
        BackgroundColor3 = self.Window.Theme.Bg,
        BorderSizePixel = 0
    }, card, {BackgroundColor3 = "Bg"})
    corner(bar, 10)
    local function percent(v)
        return range <= 0 and 0 or math.clamp((v - minValue) / range, 0, 1)
    end
    local fill = themed("Frame", {
        Size = UDim2.new(percent(value), 0, 1, 0),
        BackgroundColor3 = self.Window.Theme.Accent,
        BorderSizePixel = 0
    }, bar, {BackgroundColor3 = "Accent"})
    corner(fill, 10)
    local thumb = create("Frame", {
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(percent(value), 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0
    }, bar)
    corner(thumb, 100)
    local thumbStroke = addStroke(thumb, self.Window.Theme.Accent, 0, 2)
    setRole(thumbStroke, "Color", "Accent")
    local hit = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.fromOffset(0, -9),
        BackgroundTransparency = 1,
        Text = ""
    }, bar)
    local dragging = false
    local function updateFromPercent(pct, invoke)
        pct = math.clamp(pct, 0, 1)
        value = math.floor((minValue + range * pct) + 0.5)
        if range <= 0 then value = minValue end
        local p = percent(value)
        fill.Size = UDim2.new(p, 0, 1, 0)
        thumb.Position = UDim2.new(p, 0, 0.5, 0)
        label.Text = (options.Name or "Slider") .. " : " .. tostring(value)
        if invoke ~= false then safeCallback(options.Callback, value) end
    end
    local function updateFromX(x, invoke)
        local width = bar.AbsoluteSize.X
        local pct = width > 0 and (x - bar.AbsolutePosition.X) / width or 0
        updateFromPercent(pct, invoke)
    end
    addConnection(self, hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X, true)
        end
    end))
    addConnection(self, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X, true)
        end
    end))
    addConnection(self, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return {
        Get = function() return value end,
        Set = function(_, newValue)
            newValue = math.clamp(tonumber(newValue) or minValue, minValue, maxValue)
            updateFromPercent(percent(newValue), true)
        end,
        Destroy = function() dragging = false; if isAlive(card) then card:Destroy() end end
    }
end

function Tab:AddDropdown(options)
    options = options or {}
    local choices = options.Options or {}
    local selected = options.Default
    if selected == nil then selected = choices[1] end
    local card = createCard(self, 40, options)
    local label = themed("TextLabel", {
        Size = UDim2.new(1, -48, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = tostring(selected == nil and "Select..." or selected),
        TextColor3 = self.Window.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card, {TextColor3 = "Text"})
    local arrow = themed("TextLabel", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -35, 0.5, -15),
        BackgroundTransparency = 1,
        Text = "⌄",
        TextColor3 = self.Window.Theme.Text,
        TextSize = 16,
        Font = Enum.Font.GothamBold
    }, card, {TextColor3 = "Text"})
    local hit = create("TextButton", {
        Size = UDim2.fromScale(1,1),
        BackgroundTransparency = 1,
        Text = ""
    }, card)
    local opened = false
    local overlay, menu
    local menuConnections = {}
    local function close()
        if not opened then return end
        opened = false
        disconnectAll(menuConnections)
        if menu and isAlive(menu) then menu:Destroy() end
        if overlay and isAlive(overlay) then overlay:Destroy() end
        menu, overlay = nil, nil
        arrow.Text = "⌄"
        if self.Window.OpenDropdown == close then self.Window.OpenDropdown = nil end
    end
    addConnection(self, hit.Activated:Connect(function()
        if opened then close(); return end
        if #choices == 0 or self.Window.Destroyed then return end
        self.Window:CloseDropdown()
        opened = true
        self.Window.OpenDropdown = close
        arrow.Text = "⌃"
        local screen = self.Window.Screen
        local viewport = screen.AbsoluteSize
        local itemHeight = 30
        local menuHeight = math.min(#choices * itemHeight, 180)
        local anchorPos, anchorSize = card.AbsolutePosition, card.AbsoluteSize
        local x = math.clamp(anchorPos.X, 4, math.max(4, viewport.X - anchorSize.X - 4))
        local y = anchorPos.Y + anchorSize.Y + 4
        if y + menuHeight > viewport.Y - 4 then
            y = anchorPos.Y - menuHeight - 4
        end
        y = math.clamp(y, 4, math.max(4, viewport.Y - menuHeight - 4))
        overlay = create("TextButton", {
            Name = "DropdownDismiss",
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 200
        }, screen)
        table.insert(menuConnections, overlay.Activated:Connect(close))
        menu = create("ScrollingFrame", {
            Name = "DropdownMenu",
            Size = UDim2.fromOffset(anchorSize.X, menuHeight),
            Position = UDim2.fromOffset(x, y),
            BackgroundColor3 = self.Window.Theme.Bg,
            BackgroundTransparency = 0.03,
            BorderSizePixel = 0,
            ZIndex = 205,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = self.Window.Theme.Accent,
            CanvasSize = UDim2.fromOffset(0, #choices * itemHeight)
        }, screen)
        corner(menu, 8)
        addStroke(menu, self.Window.Theme.Accent, 0.25, 1.5)
        for index, choice in ipairs(choices) do
            local optionButton = themed("TextButton", {
                Size = UDim2.new(1, -4, 0, itemHeight),
                Position = UDim2.fromOffset(0, (index - 1) * itemHeight),
                BackgroundColor3 = self.Window.Theme.Accent,
                BackgroundTransparency = 1,
                Text = tostring(choice),
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
                ZIndex = 206
            }, menu, {TextColor3 = "Text"})
            table.insert(menuConnections, optionButton.MouseEnter:Connect(function()
                tween(optionButton, 0.1, {BackgroundTransparency = 0.78})
            end))
            table.insert(menuConnections, optionButton.MouseLeave:Connect(function()
                tween(optionButton, 0.1, {BackgroundTransparency = 1})
            end))
            table.insert(menuConnections, optionButton.Activated:Connect(function()
                selected = choice
                label.Text = tostring(choice)
                close()
                safeCallback(options.Callback, choice)
            end))
        end
    end))
    return {
        Get = function() return selected end,
        Set = function(_, value)
            selected = value
            label.Text = tostring(value)
            safeCallback(options.Callback, value)
        end,
        Refresh = function(_, newOptions, keepSelection)
            close()
            choices = newOptions or {}
            if not keepSelection then
                selected = choices[1]
                label.Text = tostring(selected == nil and "Select..." or selected)
            end
        end,
        Destroy = function() close(); if isAlive(card) then card:Destroy() end end
    }
end

