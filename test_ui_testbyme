local function MakePill(y, text, color, onClick)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(112, 34)
    b.Position = UDim2.fromOffset(0, y)
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.TextSize = 13
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = false
    b.ZIndex = 401
    b.Parent = PillFrame
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 17) c.Parent = b
    local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(255,255,255) s.Transparency = 0.65 s.Thickness = 1 s.Parent = b
    -- ลากทั้งกลุ่ม + กดค้างซ่อน
    local dragging, startPos, startInput, moved = false, nil, nil, 0
    local hold = false
    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not S.LockedPill then dragging = true startInput = input.Position startPos = PillFrame.Position moved = 0 end
            hold = true
            task.delay(0.4, function() if hold and moved < 8 then PillFrame.Visible = false S.PillVisible = false Notify("Pills", "ซ่อนเม็ดยาแล้ว เปิดใน Misc") end end)
        end
    end)
    b.InputEnded:Connect(function(input) hold = false dragging = false end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput moved += math.abs(d.X)+math.abs(d.Y)
            local cam = Workspace.CurrentCamera local vs = cam and cam.ViewportSize or Vector2.new(1280,720)
            PillFrame.Position = UDim2.new(0, math.clamp(startPos.X.Offset + d.X, 0, vs.X - 112), 0, math.clamp(startPos.Y.Offset + d.Y, 0, vs.Y - 172))
        end
    end)
    b.Activated:Connect(function() if moved < 12 then onClick() end moved = 0 end)
    return b
end

