    local playerGui = player:WaitForChild("PlayerGui")
    local self = setmetatable({}, Window)
    self.Connections = {}
    self.Tabs = {}
    self.Flags = table.clone(options.Flags or {})
    self.ThemeName = options.Theme or "Hello"
    if not CONFIG.Themes[self.ThemeName] then self.ThemeName = "Hello" end
    self.Theme = table.clone(CONFIG.Themes[self.ThemeName])
    self.Destroyed = false
    self.Hidden = true
    self.Minimized = false
    self.NormalSize = UDim2.fromOffset(CONFIG.Window.Width, CONFIG.Window.Height)
