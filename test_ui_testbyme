function Tab:AddKeybind(options)
    options = options or {}
    local key = options.Default or "None"
    local card = createCard(self, 40, options)
    themed("TextLabel", {
        Size = UDim2.new(1, -85, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = options.Name or "Keybind",
        TextColor3 = self.Window.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card, {TextColor3 = "Text"})
    local button = themed("TextButton", {
        Size = UDim2.fromOffset(65, 24),
        Position = UDim2.new(1, -77, 0.5, -12),
        BackgroundColor3 = self.Window.Theme.Bg,
        BackgroundTransparency = 0.25,
        Text = tostring(key),
        TextColor3 = self.Window.Theme.Text,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, card, {BackgroundColor3 = "Bg", TextColor3 = "Text"})
    corner(button, 6)
    local outline = addStroke(button, self.Window.Theme.Stroke, 0.5)
    setRole(outline, "Color", "Stroke")
    local listening = false
    local listenConnection
    local function stopListening()
        listening = false
        if listenConnection then
            listenConnection:Disconnect()
            listenConnection = nil
        end
        if isAlive(button) then button.Text = tostring(key) end
    end
    addConnection(self, button.Activated:Connect(function()
        if listening then return end
        listening = true
        button.Text = "Press key"
        listenConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                stopListening()
                return
            end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode.Name
                stopListening()
                safeCallback(options.Callback, key)
            end
        end)
    end))
    return {
        Get = function() return key end,
        Set = function(_, value)
            key = tostring(value)
            stopListening()
            safeCallback(options.Callback, key)
        end,
        Destroy = function() stopListening(); if isAlive(card) then card:Destroy() end end
    }
end

function Window:SetTheme(name)
    if self.Destroyed or not CONFIG.Themes[name] then return false end
    self.ThemeName = name
    self.Theme = table.clone(CONFIG.Themes[name])
    Theme = self.Theme
    for _, object in ipairs(self.Screen:GetDescendants()) do
        local property = object:GetAttribute("HHThemeProperty")
        local role = object:GetAttribute("HHThemeRole")
        if property and role and self.Theme[role] ~= nil then
            pcall(function() object[property] = self.Theme[role] end)
        end
        if object:IsA("ScrollingFrame") then
            object.ScrollBarImageColor3 = self.Theme.Accent
        end
    end
    if self.AmbientContainer then
        for _, child in ipairs(self.AmbientContainer:GetChildren()) do child:Destroy() end
    end
    self:CloseDropdown()
    self:Notify({Title = "Theme Changed", Content = "Switched to " .. name, Duration = 2})
    return true
end

function Window:ConnectSearch()
    if self.SearchConnection then self.SearchConnection:Disconnect() end
    self.SearchConnection = self.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if self.Destroyed then return end
        local query = string.lower(self.SearchBox.Text)
        for _, tab in pairs(self.Tabs) do
            for _, component in ipairs(tab.Components) do
                if isAlive(component) then
                    local name = string.lower(component:GetAttribute("HelloHubSearchName") or component.Name)
                    component.Visible = query == "" or string.find(name, query, 1, true) ~= nil
                end
            end
        end
    end)
    addConnection(self, self.SearchConnection)
end

function Window:Notify(data)
    data = data or {}
    if self.Destroyed then return nil end
    local notification = themed("Frame", {
        Size = UDim2.fromOffset(270, 68),
        Position = UDim2.new(1, 290, 0, 20),
        BackgroundColor3 = self.Theme.Panel,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 300
    }, self.Screen, {BackgroundColor3 = "Panel"})
    corner(notification, 9)
    local outline = addStroke(notification, self.Theme.Accent, 0.2, 1.5)
    setRole(outline, "Color", "Accent")
    themed("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.fromOffset(10, 7),
        BackgroundTransparency = 1,
        Text = tostring(data.Title or "Notification"),
        TextColor3 = self.Theme.Accent,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 301
    }, notification, {TextColor3 = "Accent"})
    themed("TextLabel", {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.fromOffset(10, 30),
        BackgroundTransparency = 1,
        Text = tostring(data.Content or ""),
        TextColor3 = self.Theme.Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 301
    }, notification, {TextColor3 = "Text"})
    tween(notification, 0.35, {Position = UDim2.new(1, -285, 0, 20)}, Enum.EasingStyle.Back)
    task.delay(math.max(0.5, tonumber(data.Duration) or 3), function()
        if not isAlive(notification) then return end
        local animation = tween(notification, 0.25, {
            Position = UDim2.new(1, 290, 0, 20),
            BackgroundTransparency = 1
        })
        if animation then
            animation.Completed:Wait()
            if isAlive(notification) then notification:Destroy() end
        end
    end)
    return notification
end

function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self:CloseDropdown()
    disconnectAll(self.Connections)
    for _, tab in pairs(self.Tabs) do
        disconnectAll(tab.Connections)
    end
    if self.Screen then self.Screen:Destroy() end
end

