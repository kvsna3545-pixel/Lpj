    return n
end
function Window:Destroy() if self.Destroyed then return end; self.Destroyed=true; self:CloseDropdown(); for _,cn in ipairs(self.Connections) do pcall(function() cn:Disconnect() end) end; if self.Screen then self.Screen:Destroy() end end

ProjectNTIN.Config = CONFIG
ProjectNTIN.Version = CONFIG.Version
ProjectNTIN.Stats = StatsEngine
function ProjectNTIN.GetThemes() local n={}; for k in pairs(CONFIG.Themes) do table.insert(n,k) end; table.sort(n); return n end

-- ============ System Tester ============
function ProjectNTIN.AddSystemTest(window)
    local tab = window:CreateTab({Name="System Test", Icon="🧪"})
    local status = tab:AddLabel("SYSTEM TESTER | Ready")
    local report = tab:AddLabel("No tests have been run.")
    local results={}; local passed=0; local failed=0
    local function log(name,ok,detail) table.insert(results,{Name=name,Passed=ok,Detail=tostring(detail or "")}); if ok then passed+=1 else failed+=1 end; status:Set("["..(ok and "PASS" or "FAIL").."] "..name); report:Set("Passed: "..passed.." | Failed: "..failed.." | Last: "..name) end
    local function test(name,fn) local ok,res=pcall(fn); log(name,ok,ok and "OK" or res) end
    tab:AddSection("🧪","Automatic Tests")
    tab:AddButton({Name="Run All Tests", Callback=function() passed=0; failed=0; table.clear(results); status:Set("Running..."); report:Set("Testing...")
        test("Real Stats - Players",function() assert(type(StatsEngine.PlayerCount)=="number"); assert(StatsEngine.PlayerCount>=1) end)
        test("Real Stats - Ping",function() assert(type(StatsEngine.Ping)=="number"); assert(StatsEngine.Ping>=0) end)
        test("Real Stats - FPS",function() assert(type(StatsEngine.FPS)=="number"); assert(StatsEngine.FPS>0 and StatsEngine.FPS<=1000) end)
        test("Real Stats - Time",function() local t=StatsEngine.GetTime(); assert(string.match(t,"%d%d:%d%d:%d%d")~=nil) end)
        test("Real Stats - ServerId",function() assert(type(StatsEngine.ServerId)=="string" and #StatsEngine.ServerId>0) end)
        test("Real Stats - Region",function() assert(type(StatsEngine.Region)=="string" and #StatsEngine.Region>0) end)
        test("Toggle Get/Set",function() local cb; local t=tab:AddToggle({Name="T Test",Default=false,Flag="HH_T_Test",Callback=function(v) cb=v end}); t:Set(true); assert(t:Get()==true); assert(cb==true); t:Set(false); assert(t:Get()==false); t:Destroy() end)
        test("Toggle Orbit Stars 8",function() local t=tab:AddToggle({Name="Orbit",Default=true,Flag="HH_Orbit_Test"}); local orb=t.Instance:FindFirstChild("OrbitLayer"); assert(orb~=nil); local cnt=0; for _,ch in ipairs(orb:GetChildren()) do if string.find(ch.Name,"OrbitStar") then cnt+=1 end end; assert(cnt==8,"got "..cnt); t:Destroy() end)
        test("StatCard Live",function() local c=tab:AddStatCard({Title="FPS",Live="FPS",Column="Left"}); assert(c.Instance~=nil); c:Destroy() end)
        test("WelcomeCard",function() local c=tab:AddWelcomeCard(); assert(c.Instance~=nil); assert(c.Avatar~=nil); c:Destroy() end)
        test("Slider",function() local s=tab:AddSlider({Name="S",Min=0,Max=100,Default=25}); s:Set(75); assert(s:Get()==75); s:Set(500); assert(s:Get()==100); s:Destroy() end)
        test("Dropdown",function() local d=tab:AddDropdown({Name="D",Options={"A","B"},Default="A"}); d:Set("B"); assert(d:Get()=="B"); d:Destroy() end)
        test("Input",function() local i=tab:AddInput({Name="I",Default="Hello"}); i:Set("YinYang"); assert(i:Get()=="YinYang"); i:Destroy() end)
        test("Notification",function() local n=window:Notify({Title="Test",Content="OK",Duration=1}); assert(n~=nil) end)
        local total=passed+failed; status:Set(failed==0 and "ALL PASSED ✅" or "ERRORS FOUND ❌"); report:Set("Completed: "..total.." | PASS: "..passed.." | FAIL: "..failed); window:Notify({Title="Test Done",Content=passed.."/"..total.." passed",Duration=3})
        print("===== YIN YANG v10 TEST ====="); for _,r in ipairs(results) do print((r.Passed and "[PASS] " or "[FAIL] ")..r.Name.." | "..r.Detail) end; print("===========================")
    end})
    tab:AddButton({Name="Test Notification", Callback=function() window:Notify({Title="Yin Yang",Content="Notification OK!",Duration=3}) end})
    tab:AddButton({Name="Test Theme", Callback=function() local th=ProjectNTIN.GetThemes(); local i=table.find(th,window.ThemeName) or 0; window:SetTheme(th[(i % #th)+1]) end})
    tab:AddButton({Name="Clear Report", Callback=function() passed=0; failed=0; table.clear(results); status:Set("SYSTEM TESTER | Ready"); report:Set("Report cleared.") end})
    return tab
end

return ProjectNTIN
