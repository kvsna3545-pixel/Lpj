                BackgroundColor3 = self.Window.Theme.Accent,
                BackgroundTransparency = 1,
                Text = tostring(choice),
                TextColor3 = self.Window.Theme.Text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
                ZIndex = 206
            }, menu, {TextColor3 = "Text"})
            table.insert(menuConnections, optionButton.MouseEnter:Connect(function()
                tween(optionButton, 0.1, {BackgroundTransparency = 0.78})
            end))
            table.insert(menuConnections, optionButton.MouseLeave:Connect(function()
                tween(optionButton, 0.1, {BackgroundTransparency = 1})
            end))
            table.insert(menuConnections, optionButton.Activated:Connect(function()
                selected = choice
                label.Text = tostring(choice)
                close()
                safeCallback(options.Callback, choice)
            end))
        end
    end))
    return {
        Get = function() return selected end,
        Set = function(_, value)
            selected = value
            label.Text = tostring(value)
            safeCallback(options.Callback, value)
        end,
        Refresh = function(_, newOptions, keepSelection)
            close()
            choices = newOptions or {}
            if not keepSelection then
                selected = choices[1]
                label.Text = tostring(selected == nil and "Select..." or selected)
            end
        end,
        Destroy = function() close(); if isAlive(card) then card:Destroy() end end
    }
end

