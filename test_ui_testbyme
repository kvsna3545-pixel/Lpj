function Tab:AddToggle(options)
    options = options or {}
    local key = options.Flag or options.Name or "Toggle"
    local saved = self.Window.Flags[key]
    local state = saved ~= nil and saved == true or (saved == nil and options.Default == true)
    local card = createCard(self, 40, options)
    themed("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = options.Name or "Toggle",
        TextColor3 = self.Window.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, card, {TextColor3 = "Text"})
    local switch = themed("Frame", {
        Size = UDim2.fromOffset(36, 20),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -30, 0.5, 0),
        BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Stroke
    }, card, {BackgroundColor3 = state and "Accent" or "Stroke"})
    corner(switch, 20)
    local switchScale = create("UIScale", {Scale = 1}, switch)
    local glowStroke = addStroke(switch, self.Window.Theme.Accent, 1, 2)
    glowStroke.Name = "ToggleGlow"
    setRole(glowStroke, "Color", "Accent")
    local knob = create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = state and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0
    }, switch)
    corner(knob, 20)
    local cardStroke = card:FindFirstChildOfClass("UIStroke")
    local orbitLayer = create("Frame", {
        Name = "OrbitLayer",
        Size = UDim2.fromOffset(72, 54),
        Position = UDim2.new(1, -66, 0.5, -27),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        ZIndex = 5
    }, card)
    local ORBIT_CENTER = Vector2.new(36, 27)
    local STAR_COUNT = 8
    local stars = {}
    for i = 1, STAR_COUNT do
        local size = math.random(2, 5)
        local useAccent2 = math.random() > 0.5
        local star = create("Frame", {
            Name = "OrbitStar" .. tostring(i),
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.fromOffset(ORBIT_CENTER.X, ORBIT_CENTER.Y),
            BackgroundColor3 = useAccent2 and self.Window.Theme.Accent2 or self.Window.Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 6
        }, orbitLayer)
        corner(star, 100)
        setRole(star, "BackgroundColor3", useAccent2 and "Accent2" or "Accent")
        table.insert(stars, {
            Frame = star,
            Size = size,
            RadiusX = math.random(24, 33),
            RadiusY = math.random(15, 22),
            Speed = (math.random(80, 220) / 100) * (math.random() > 0.5 and 1 or -1),
            Phase = math.random() * math.pi * 2,
            TwinkleSpeed = math.random(150, 350) / 100,
            TwinklePhase = math.random() * math.pi * 2
        })
    end
    local hit = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 10
    }, card)
    local destroyed = false
    local fadeAlpha = 0
    local glowAlpha = 0
    local fadeTarget = state and 1 or 0
    local glowTarget = state and 1 or 0
    local elapsed = math.random() * 10
    local switchTween = nil
    local knobTween = nil
    local popTween = nil
    local squashTween = nil
    local cardFlashTween = nil
    local toggleConnections = {}
    local function addToggleConnection(conn)
        table.insert(toggleConnections, conn)
        return conn
    end
    local function cancelTween(tw)
        if tw then pcall(function() tw:Cancel() end) end
    end
    local function animatePress()
        if destroyed or not isAlive(switch) then return end
        cancelTween(popTween)
        popTween = tween(switchScale, 0.12, {Scale = 1.18}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        task.delay(0.12, function()
            if destroyed or not isAlive(switchScale) then return end
            popTween = tween(switchScale, 0.28, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
        cancelTween(squashTween)
        squashTween = tween(knob, 0.12, {Size = UDim2.fromOffset(13, 18)}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        task.delay(0.12, function()
            if destroyed or not isAlive(knob) then return end
            squashTween = tween(knob, 0.28, {Size = UDim2.fromOffset(16, 16)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
        if isAlive(cardStroke) then
            cancelTween(cardFlashTween)
            cardFlashTween = tween(cardStroke, 0.15, {Transparency = 0.05}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            task.delay(0.18, function()
                if destroyed or not isAlive(cardStroke) then return end
                cardFlashTween = tween(cardStroke, 0.3, {Transparency = 0.68}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end)
        end
    end
    local orbitConnection
    orbitConnection = RunService.RenderStepped:Connect(function(dt)
        if destroyed then return end
        if not isAlive(card) then return end
        if self.Window.Destroyed or self.Window.Hidden then return end
        dt = math.min(dt, 0.05)
        elapsed += dt
        local lerpFactor = 1 - math.exp(-6 * dt)
        fadeAlpha += (fadeTarget - fadeAlpha) * lerpFactor
        if math.abs(fadeTarget - fadeAlpha) < 0.01 then fadeAlpha = fadeTarget end
        glowAlpha += (glowTarget - glowAlpha) * lerpFactor
        if math.abs(glowTarget - glowAlpha) < 0.01 then glowAlpha = glowTarget end
        if isAlive(glowStroke) then
            if glowAlpha <= 0.01 then
                glowStroke.Transparency = 1
            else
                local pulse = 0.55 + 0.25 * math.sin(elapsed * 4.2)
                glowStroke.Transparency = math.clamp(1 - glowAlpha * pulse, 0, 1)
            end
        end
        if fadeAlpha <= 0.01 then
            orbitLayer.Visible = false
            for _, s in ipairs(stars) do
                if isAlive(s.Frame) then s.Frame.Visible = false end
            end
            return
        end
        orbitLayer.Visible = true
        for _, s in ipairs(stars) do
            local f = s.Frame
            if isAlive(f) then
                f.Visible = true
                local angle = s.Phase + elapsed * s.Speed
                local x = ORBIT_CENTER.X + math.cos(angle) * s.RadiusX
                local y = ORBIT_CENTER.Y + math.sin(angle) * s.RadiusY
                f.Position = UDim2.fromOffset(x - s.Size / 2, y - s.Size / 2)
                local twinkle = 0.55 + 0.45 * math.sin(elapsed * s.TwinkleSpeed + s.TwinklePhase)
                f.BackgroundTransparency = math.clamp(1 - fadeAlpha * (0.35 + 0.65 * twinkle), 0, 1)
            end
        end
    end)
    addToggleConnection(orbitConnection)
    addConnection(self, orbitConnection)
    local function set(value, invoke)
        if destroyed then return end
        state = value == true
        self.Window.Flags[key] = state
        fadeTarget = state and 1 or 0
        glowTarget = state and 1 or 0
        animatePress()
        setRole(switch, "BackgroundColor3", state and "Accent" or "Stroke")
        cancelTween(switchTween)
        cancelTween(knobTween)
        switchTween = tween(switch, 0.30, {
            BackgroundColor3 = state and self.Window.Theme.Accent or self.Window.Theme.Stroke
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        if state then
            knobTween = tween(knob, 0.35, {
                Position = UDim2.new(1, -10, 0.5, 0)
            }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        else
            knobTween = tween(knob, 0.30, {
                Position = UDim2.new(0, 10, 0.5, 0)
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end
        if invoke ~= false then safeCallback(options.Callback, state) end
    end
    local hitConnection = hit.Activated:Connect(function()
        set(not state)
    end)
    addToggleConnection(hitConnection)
    addConnection(self, hitConnection)
    self.Window.Flags[key] = state
    local function destroyToggle()
        if destroyed then return end
        destroyed = true
        fadeTarget = 0
        glowTarget = 0
        cancelTween(switchTween)
        cancelTween(knobTween)
        cancelTween(popTween)
        cancelTween(squashTween)
        cancelTween(cardFlashTween)
        switchTween = nil
        knobTween = nil
        popTween = nil
        squashTween = nil
        cardFlashTween = nil
        disconnectAll(toggleConnections)
        table.clear(stars)
        if isAlive(card) then card:Destroy() end
    end
    return {
        Get = function() return state end,
        Set = function(_, value) set(value, true) end,
