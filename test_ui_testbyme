        ZIndex = 50
    }, screen, {BackgroundColor3 = "Accent"})
    self.Launcher = launcher
    corner(launcher, 100)
    local launcherStroke = addStroke(launcher, Color3.new(1,1,1), 0.45, 2)
    local launcherDragging, launcherStart, launcherPosition, moved = false, nil, nil, 0
    addConnection(self, launcher.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            launcherDragging = true
            launcherStart = input.Position
            launcherPosition = launcher.Position
            moved = 0
        end
    end))
    addConnection(self, UserInputService.InputChanged:Connect(function(input)
        if launcherDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - launcherStart
            moved = moved + math.abs(delta.X) + math.abs(delta.Y)
            local size = viewport()
            launcher.Position = UDim2.new(
                0, math.clamp(launcherPosition.X.Offset + delta.X, 0, math.max(0, size.X - 50)),
                1, math.clamp(launcherPosition.Y.Offset + delta.Y, -size.Y + 50, -10)
            )
        end
    end))
    addConnection(self, UserInputService.InputEnded:Connect(function(input)
        if launcherDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            launcherDragging = false
            if moved < 10 then self:ToggleWindow(self.Hidden) end
        end
    end))
    function self:ToggleWindow(show)
        if self.Destroyed then return end
        show = show == true
        if self.Hidden == not show then return end
        self.Hidden = not show
        self:CloseDropdown()
        local scale = getScale()
        if show then
            main.Visible = true
            self.UIScale.Scale = scale * 0.92
            main.Position = self.NormalPos + UDim2.fromOffset(0, 16)
            main.BackgroundTransparency = 1
            tween(main, 0.35, {Position = self.NormalPos, BackgroundTransparency = 0.12}, Enum.EasingStyle.Quint)
            tween(self.UIScale, 0.35, {Scale = scale}, Enum.EasingStyle.Quint)
        else
            local animation = tween(main, 0.25, {
                Position = self.NormalPos + UDim2.fromOffset(0, 16),
                BackgroundTransparency = 1
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tween(self.UIScale, 0.25, {Scale = scale * 0.94}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            if animation then
                animation.Completed:Wait()
                if not self.Destroyed and self.Hidden then
                    main.Visible = false
                    main.Position = self.NormalPos
                    self.UIScale.Scale = scale
                end
            end
        end
    end
    addConnection(self, minButton.MouseEnter:Connect(function()
        tween(minButton, 0.1, {TextColor3 = self.Theme.Text})
    end))
    addConnection(self, closeButton.MouseEnter:Connect(function()
        tween(closeButton, 0.1, {TextColor3 = Color3.fromRGB(255, 100, 110)})
    end))
    addConnection(self, minButton.MouseLeave:Connect(function()
        tween(minButton, 0.1, {TextColor3 = self.Theme.SubText})
    end))
    addConnection(self, closeButton.MouseLeave:Connect(function()
        tween(closeButton, 0.1, {TextColor3 = self.Theme.SubText})
    end))
    local dragging, dragStart, windowStart = false, nil, nil
    addConnection(self, topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            windowStart = main.Position
        end
    end))
    addConnection(self, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = (input.Position - dragStart) / math.max(self.UIScale.Scale, 0.01)
            local size = viewport()
            local absoluteSize = main.AbsoluteSize
            local px = math.clamp(windowStart.X.Offset + delta.X, 0, math.max(0, size.X - absoluteSize.X))
            local py = math.clamp(windowStart.Y.Offset + delta.Y, 0, math.max(0, size.Y - absoluteSize.Y))
            self.NormalPos = UDim2.fromOffset(px, py)
            main.Position = self.NormalPos
        end
    end))
    addConnection(self, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    addConnection(self, UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == (options.ToggleKey or Enum.KeyCode.RightShift) then
            self:ToggleWindow(self.Hidden)
        end
    end))
    local function updateViewport()
        if self.Destroyed then return end
        local size = viewport()
        self.UIScale.Scale = getScale()
        if self.Hidden then return end
        local abs = main.AbsoluteSize
        local px = math.clamp(self.NormalPos.X.Offset, 0, math.max(0, size.X - abs.X))
        local py = math.clamp(self.NormalPos.Y.Offset, 0, math.max(0, size.Y - abs.Y))
        self.NormalPos = UDim2.fromOffset(px, py)
        if not dragging then main.Position = self.NormalPos end
    end
    local cameraConnection
    local function bindCamera()
        if cameraConnection then cameraConnection:Disconnect() end
        local camera = workspace.CurrentCamera
        if camera then
            cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewport)
            addConnection(self, cameraConnection)
        end
    end
    bindCamera()
    addConnection(self, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
    self:ConnectSearch()
    task.delay(0.35, function()
        if self.Destroyed then return end
        launcher.Size = UDim2.fromOffset(0, 0)
        tween(launcher, 0.45, {Size = UDim2.fromOffset(50, 50)}, Enum.EasingStyle.Back)
        task.delay(0.2, function()
            if not self.Destroyed then self:ToggleWindow(true) end
        end)
    end)
    return self
end

