function Window:SetTheme(name)
    if self.Destroyed or not CONFIG.Themes[name] then return false end
    self.ThemeName = name
    self.Theme = table.clone(CONFIG.Themes[name])
    Theme = self.Theme
    buildThemeDecor(self.Main, name, self.Theme)
    for _, object in ipairs(self.Screen:GetDescendants()) do
        local property = object:GetAttribute("HHThemeProperty")
        local role = object:GetAttribute("HHThemeRole")
        if property and role and self.Theme[role] ~= nil then
            pcall(function() object[property] = self.Theme[role] end)
        end
        if object:IsA("ScrollingFrame") then
            object.ScrollBarImageColor3 = self.Theme.Accent
        end
    end
    if self.AmbientContainer then
        for _, child in ipairs(self.AmbientContainer:GetChildren()) do child:Destroy() end
    end
    self:CloseDropdown()
    self:Notify({Title = "Theme Changed", Content = "Switched to " .. name, Duration = 2})
    return true
end

function Window:ConnectSearch()
    if self.SearchConnection then self.SearchConnection:Disconnect() end
    self.SearchConnection = self.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        if self.Destroyed then return end
        local query = string.lower(self.SearchBox.Text)
        for _, tab in pairs(self.Tabs) do
            for _, component in ipairs(tab.Components) do
                if isAlive(component) then
                    local name = string.lower(component:GetAttribute("HelloHubSearchName") or component.Name)
                    component.Visible = query == "" or string.find(name, query, 1, true) ~= nil
                end
            end
        end
    end)
    addConnection(self, self.SearchConnection)
end

