function Window:SelectTab(name)
    if self.Destroyed or not self.Tabs[name] then return end
    self:CloseDropdown(); self.ActiveTab=name
    for n,t in pairs(self.Tabs) do local act=n==name; t.Page.Visible=act; tween(t.Button,0.18,{BackgroundColor3=act and self.Theme.Accent or self.Theme.Panel,BackgroundTransparency=act and 0.25 or 0.85}); tween(t.Indicator,0.18,{BackgroundTransparency=act and 0 or 1}) end
end

