function Tab:AddSlider(options)
    options = options or {}
    local minimum, maximum = options.Min or 0, options.Max or 100
    local decimals = options.Decimals or 0
    local multiplier = 10 ^ decimals
    local value = math.clamp(options.Default or minimum, minimum, maximum)
    value = math.floor(value * multiplier + 0.5) / multiplier
    local card = self:CreateCard(options.Name or "Slider", 60, options)
    local label = create("TextLabel", { Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 2), BackgroundTransparency = 1, Text = (options.Name or "Slider") .. " : " .. tostring(value), TextColor3 = Theme.Text, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left }, card)
    local bar = create("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 42), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5 }, card)
    corner(bar, 10)
    local fill = create("Frame", { Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }, bar)
    corner(fill, 10)
    local hitbox = create("TextButton", { Size = UDim2.new(1, 0, 0, 25), Position = UDim2.fromOffset(0, -10), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, bar)
    local dragging = false
    local function setValue(x, silent)
        local pct = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        value = minimum + (maximum - minimum) * pct
        value = math.floor(value * multiplier + 0.5) / multiplier
        fill.Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0)
        label.Text = (options.Name or "Slider") .. " : " .. tostring(value)
        if not silent then safeCallback(options.Callback, value) end
    end
    connect(self, hitbox.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; setValue(input.Position.X) end end)
    connect(self, UserInputService.InputChanged, function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setValue(input.Position.X) end end)
    connect(self, UserInputService.InputEnded, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    return { Get = function() return value end, Set = function(_, v) setValue(bar.AbsolutePosition.X + (bar.AbsoluteSize.X * ((v - minimum) / (maximum - minimum)))) end }
end

function Tab:AddButton(options)
    options = options or {}
    local card = self:CreateCard(options.Name or "Button", options.Height or 42, options)
    local btn = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = options.Name or "Button", TextColor3 = Theme.Text, TextSize = 11, Font = Enum.Font.GothamMedium, AutoButtonColor = false }, card)
    connect(self, btn.MouseEnter, function() tween(card, 0.15, { BackgroundColor3 = Theme.Hover }) end)
    connect(self, btn.MouseLeave, function() tween(card, 0.15, { BackgroundColor3 = Theme.CardBg }) end)
    connect(self, btn.Activated, function() safeCallback(options.Callback) end)
    return { Instance = btn, SetText = function(_, v) btn.Text = tostring(v) end }
end

function Tab:SetSearch(query)
    query = string.lower(tostring(query or ""))
    for _, component in ipairs(self.Components) do
        if isAlive(component) then
            local name = string.lower(component:GetAttribute("HH_SearchName") or "")
            component.Visible = query == "" or string.find(name, query, 1, true) ~= nil
        end
    end
end

-- SYSTEM
function Window:Notify(options)
    if self.Destroyed then return end
    self.NotificationQueue[#self.NotificationQueue + 1] = options or {}
    if self.NotificationBusy then return end
    self.NotificationBusy = true
    task.spawn(function()
        local holder = self.Screen:FindFirstChild("Notifications")
        if not holder then
            holder = create("Frame", { Size = UDim2.fromOffset(280, 300), Position = UDim2.new(1, -295, 0, 18), BackgroundTransparency = 1 }, self.Screen)
            create("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }, holder)
        end
        while #self.NotificationQueue > 0 and not self.Destroyed do
            local data = table.remove(self.NotificationQueue, 1)
            local card = create("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = Theme.CardBg, BackgroundTransparency = 1 }, holder)
            corner(card, 12); stroke(card)
            create("TextLabel", { Size = UDim2.new(1, -20, 0, 23), Position = UDim2.fromOffset(10, 7), BackgroundTransparency = 1, Text = data.Title or "HelloHub", TextColor3 = Theme.Accent, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left }, card)
            create("TextLabel", { Size = UDim2.new(1, -20, 0, 25), Position = UDim2.fromOffset(10, 33), BackgroundTransparency = 1, Text = data.Content or "", TextColor3 = Theme.SubText, TextSize = 10, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true }, card)
            tween(card, 0.22, { BackgroundTransparency = Theme.CardTransparency })
            task.wait(tonumber(data.Duration) or 3)
            if isAlive(card) then local out = tween(card, 0.2, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) }); if out then out.Completed:Wait() end; card:Destroy() end
        end
        self.NotificationBusy = false
    end)
end

function Window:ConnectSearch()
    if self._searchConnection then self._searchConnection:Disconnect() end
    self._searchConnection = self.Search:GetPropertyChangedSignal("Text"):Connect(function()
        for _, tab in pairs(self.Tabs) do tab:SetSearch(self.Search.Text) end
    end)
    self.Connections[#self.Connections + 1] = self._searchConnection
end

function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    for _, tab in pairs(self.Tabs) do for _, c in ipairs(tab.Connections) do pcall(function() c:Disconnect() end) end end
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    if isAlive(self.Screen) then self.Screen:Destroy() end
end

