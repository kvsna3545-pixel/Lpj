local function targetCol(tab,opt)
    if opt and opt.Column=="Center" then return tab.CenterCol end
    if opt and opt.Column=="Right" then return tab.RightCol end
    return tab.LeftCol
end
local function reg(tab,frame,name)
    tab.Order+=1; frame.LayoutOrder=tab.Order; frame:SetAttribute("SearchName",tostring(name or "")); table.insert(tab.Components,frame); return frame
end
local function card(tab,h,opt)
    opt=opt or {}; local w=tab.Window
    local c=create("Frame",{Size=UDim2.new(1,0,0,h),BackgroundColor3=w.Theme.Panel,BackgroundTransparency=0.18,BorderSizePixel=0,Name=opt.Name or "Card"},targetCol(tab,opt))
    corner(c,14); stroke(c,w.Theme.Accent,0.55,1.2); reg(tab,c,opt.Name); return c
end

