-- HELPERS
local function create(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do obj[key] = value end
    obj.Parent = parent
    return obj
end
local function corner(obj, radius) return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, obj) end
local function stroke(obj, color, transparency, thickness) return create("UIStroke", { Color = color or Theme.Stroke, Thickness = thickness or 1, Transparency = transparency == nil and 0.6 or transparency }, obj) end
local function padding(obj, left, right, top, bottom) return create("UIPadding", { PaddingLeft = UDim.new(0, left or 0), PaddingRight = UDim.new(0, right or 0), PaddingTop = UDim.new(0, top or 0), PaddingBottom = UDim.new(0, bottom or 0) }, obj) end
local function tween(obj, duration, properties, style, direction)
    if not obj or not obj.Parent then return nil end
    local tw = TweenService:Create(obj, TweenInfo.new(duration or CONFIG.Animation.Normal, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), properties)
    tw:Play()
    return tw
end
local function safeCallback(callback, ...)
    if typeof(callback) ~= "function" then return true end
    local args = table.pack(...)
    local ok, result = xpcall(function() return callback(table.unpack(args, 1, args.n)) end, debug.traceback)
    if not ok then warn("[HelloHub] Callback error:\n" .. tostring(result)) end
    return ok, result
end
local function isAlive(obj) return obj ~= nil and obj.Parent ~= nil end
local function connect(owner, signal, callback)
    local connection = signal:Connect(callback)
    owner.Connections[#owner.Connections + 1] = connection
    return connection
end

-- STAR SYSTEM (Clipped to UI)
local function startStarSystem(container, isMainVisible)
    if not CONFIG.Effects.Stars then return end
    task.spawn(function()
        while isAlive(container) do
            if isMainVisible() then
                local size = math.random(4, 18)
                local star = create("TextLabel", {
                    Size = UDim2.fromOffset(size, size),
                    Position = UDim2.new(math.random(), 0, math.random(), 0),
                    BackgroundTransparency = 1,
                    Text = math.random(1, 2) == 1 and "✦" or "✧",
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    TextSize = size,
                    Font = Enum.Font.GothamBold,
                    TextTransparency = math.random(30, 80) / 100,
                    Rotation = math.random(0, 360),
                    ZIndex = 2, -- ต่ำกว่า UI หลักเพื่อไม่ให้ทับปุ่ม
                }, container)
                
                local twinkle = TweenService:Create(star, TweenInfo.new(math.random(10, 25)/10, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    TextTransparency = 1,
                    Rotation = star.Rotation + math.random(-90, 90)
                })
                twinkle:Play()
                
                task.delay(math.random(5, 15), function()
                    if isAlive(star) then
                        local fadeOut = tween(star, 1, { TextTransparency = 1 })
                        if fadeOut then fadeOut.Completed:Wait(); star:Destroy() end
                    end
                end)
            end
            task.wait(math.random(1, 3) / 10)
        end
    end)
end

-- EFFECTS ENGINE
function Effects.Glow(target, color, speed)
    local glowStroke = create("UIStroke", { Color = color or Theme.Accent, Thickness = 2, Transparency = 0.5 }, target)
    task.spawn(function() while isAlive(target) do tween(glowStroke, speed or 1, { Transparency = 0.8 }, Enum.EasingStyle.Sine); task.wait(speed or 1); tween(glowStroke, speed or 1, { Transparency = 0.2 }, Enum.EasingStyle.Sine); task.wait(speed or 1) end end)
    return glowStroke
end
function Effects.Pulse(target)
    task.spawn(function() while isAlive(target) do tween(target, 0.8, { Size = target.Size + UDim2.fromOffset(4, 4) }, Enum.EasingStyle.Sine); task.wait(0.8); tween(target, 0.8, { Size = target.Size - UDim2.fromOffset(4, 4) }, Enum.EasingStyle.Sine); task.wait(0.8) end end)
end
function Effects.Shake(target)
    local originalPos = target.Position
    task.spawn(function() for _ = 1, 5 do target.Position = originalPos + UDim2.fromOffset(math.random(-5, 5), math.random(-5, 5)); task.wait(0.05) end; target.Position = originalPos end)
end
function Effects.Rainbow(target, property, speed)
    property = property or "BackgroundColor3"
    task.spawn(function() while isAlive(target) do local hue = (tick() * (speed or 0.2)) % 1; local color = Color3.fromHSV(hue, 1, 1); if target[property] then target[property] = color end; RunService.RenderStepped:Wait() end end)
end
function Effects.Fire(target)
    task.spawn(function()
        while isAlive(target) do
            local ember = create("TextLabel", { Size = UDim2.fromOffset(6, 6), Position = UDim2.new(math.random(), 0, 1, 0), BackgroundTransparency = 1, Text = "•", TextColor3 = Color3.fromRGB(255, math.random(100, 200), 0), TextSize = 14, Font = Enum.Font.GothamBold, ZIndex = 10 }, target)
            local t = TweenService:Create(ember, TweenInfo.new(math.random(5, 10)/10, Enum.EasingStyle.Linear), { Position = UDim2.new(ember.Position.X.Scale + (math.random(-10, 10)/100), 0, 0, 0), TextTransparency = 1, TextColor3 = Color3.fromRGB(255, 0, 0) })
            t:Play()
            t.Completed:Connect(function() if isAlive(ember) then ember:Destroy() end end)
            task.wait(0.1)
        end
    end)
end

-- WINDOW CLASS
function HelloHub.new(options)
    options = options or {}
    local self = setmetatable({}, Window)
    self.Connections = {}
    self.Tabs = {}
    self.Flags = table.clone(options.Flags or {})
    self.Destroyed = false
    self._transitioning = false
    self.Hidden = true
    self.Minimized = false
    self.NotificationQueue = {}
    self.NotificationBusy = false
    self.NormalPosition = UDim2.fromOffset(CONFIG.Window.Margin, CONFIG.Window.Margin)
    self.NormalSize = UDim2.fromOffset(CONFIG.Window.Width, CONFIG.Window.Height)
    self.NormalAnchorPoint = Vector2.zero

    local screen = create("ScreenGui", { Name = "HelloHub_UI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, PlayerGui)
    self.Screen = screen

    create("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = "rbxassetid://13540752864", ImageTransparency = 0.5, ScaleType = Enum.ScaleType.Crop, ZIndex = 0 }, screen)
    
    -- Main Window (Strict Clipping)
    local main = create("Frame", { Name = "Main", AnchorPoint = Vector2.zero, Position = self.NormalPosition, Size = self.NormalSize, BackgroundColor3 = Theme.Background, BackgroundTransparency = CONFIG.Effects.GlassTransparency, BorderSizePixel = 0, ClipsDescendants = true, Visible = false }, screen)
    self.Main = main
    corner(main, 16)
    create("UIStroke", { Thickness = 1.2, Color = Theme.Stroke, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, main)
    self.UIScale = create("UIScale", { Scale = 1 }, main)

    -- RESIZE HANDLE
    local resizeHandle = create("TextButton", { Name = "ResizeHandle", Size = UDim2.fromOffset(15, 15), Position = UDim2.new(1, -15, 1, -15), BackgroundTransparency = 1, Text = "◢", TextColor3 = Theme.SubText, TextSize = 10, ZIndex = 10 }, main)
    local resizing, resizeStart, startSize = false, nil, nil
    connect(self, resizeHandle.InputBegan, function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            resizing = true; resizeStart = input.Position; startSize = main.Size 
        end 
    end)

    -- STAR LAYER (Inside main, strictly clipped)
    local starContainer = create("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }, main)
    startStarSystem(starContainer, function() return isAlive(main) and main.Visible and not self.Hidden and not self.Minimized end)

    -- HEADER
    local header = create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.CardBg, BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 5 }, main)
    create("TextLabel", { Name = "Title", Size = UDim2.new(0, 200, 1, 0), Position = UDim2.fromOffset(15, 0), BackgroundTransparency = 1, Text = options.Title or CONFIG.Name, TextColor3 = Theme.Text, TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5 }, header)

    local minBtn = create("TextButton", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -80, 0, 0), BackgroundTransparency = 1, Text = "−", TextColor3 = Theme.SubText, TextSize = 20, Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 5 }, header)
    connect(self, minBtn.MouseEnter, function() tween(minBtn, 0.1, { TextColor3 = Theme.Text }) end)
    connect(self, minBtn.MouseLeave, function() tween(minBtn, 0.1, { TextColor3 = Theme.SubText }) end)
    
    local closeBtn = create("TextButton", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -40, 0, 0), BackgroundTransparency = 1, Text = "×", TextColor3 = Theme.SubText, TextSize = 20, Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 5 }, header)
    connect(self, closeBtn.MouseEnter, function() tween(closeBtn, 0.1, { TextColor3 = Theme.Text }) end)
    connect(self, closeBtn.MouseLeave, function() tween(closeBtn, 0.1, { TextColor3 = Theme.SubText }) end)
    connect(self, closeBtn.Activated, function() self:ToggleWindow(false) end)

    -- TAB BAR (Horizontal Scrolling enabled to prevent overflow)
    local tabBar = create("ScrollingFrame", { Name = "TabBar", Size = UDim2.new(1, -50, 0, 40), Position = UDim2.fromOffset(0, 40), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 5, ScrollBarThickness = 0, CanvasSize = UDim2.new() }, main)
    self.TabHolder = tabBar
    create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, tabBar)
    padding(tabBar, 10, 10, 0, 0)
    
    -- ปุ่ม + สำหรับเพิ่มแท็บ (ลอยอยู่ขวาสุด)
    local plusBtn = create("TextButton", { Name = "PlusButton", Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -38, 0, 46), BackgroundColor3 = Theme.CardBg, Text = "+", TextColor3 = Theme.Text, TextSize = 16, Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 5 }, main)
    corner(plusBtn, 6); stroke(plusBtn, Theme.Stroke, 0.8)
    connect(self, plusBtn.MouseEnter, function() tween(plusBtn, 0.1, { BackgroundColor3 = Theme.Hover }) end)
    connect(self, plusBtn.MouseLeave, function() tween(plusBtn, 0.1, { BackgroundColor3 = Theme.CardBg }) end)
    connect(self, plusBtn.Activated, function()
        local newTabName = "Tab " .. (#self:GetTabNames() + 1)
        self:CreateTab({ Name = newTabName })
        self:SelectTab(newTabName)
    end)

    -- BODY (Strict Clipping)
    local body = create("Frame", { Name = "Body", Size = UDim2.new(1, 0, 1, -80), Position = UDim2.fromOffset(0, 80), BackgroundTransparency = 1, ZIndex = 3, ClipsDescendants = true }, main)
    self.Body = body
    
    local search = create("TextBox", { Name = "Search", Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 8), BackgroundColor3 = Theme.CardBg, BackgroundTransparency = 0.3, Text = "", PlaceholderText = "Search...", PlaceholderColor3 = Theme.SubText, TextColor3 = Theme.Text, TextSize = 12, Font = Enum.Font.Gotham, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4 }, body)
    corner(search, 10); stroke(search, Theme.Stroke, 0.7); padding(search, 12, 12, 0, 0)
    self.Search = search

    self.PageHolder = create("Frame", { Name = "Pages", Size = UDim2.new(1, -20, 1, -50), Position = UDim2.fromOffset(10, 48), BackgroundTransparency = 1, ZIndex = 4, ClipsDescendants = true }, body)
    create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, self.PageHolder)

    -- LAUNCHER (Floating, Draggable)
    local launcher = create("ImageButton", { Name = "Launcher", Size = UDim2.fromOffset(54, 54), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 20, 1, -20), BackgroundColor3 = Theme.CardBg, Image = options.Logo or CONFIG.Logo, ScaleType = Enum.ScaleType.Crop, Visible = false, AutoButtonColor = false, ZIndex = 50 }, screen)
    self.Launcher = launcher
    corner(launcher, 100); stroke(launcher, Theme.Accent)
    connect(self, launcher.MouseEnter, function() tween(launcher, 0.15, { Size = UDim2.fromOffset(60, 60) }, Enum.EasingStyle.Back) end)
    connect(self, launcher.MouseLeave, function() tween(launcher, 0.15, { Size = UDim2.fromOffset(54, 54) }, Enum.EasingStyle.Back) end)
    
    local launcherDragging, launcherDragStart, launcherStartPos, launcherMovedDist = false, nil, nil, 0
    connect(self, launcher.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            launcherDragging = true; launcherDragStart = input.Position; launcherStartPos = launcher.Position; launcherMovedDist = 0
        end
    end)
    connect(self, UserInputService.InputChanged, function(input)
        if launcherDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - launcherDragStart
            launcherMovedDist += math.abs(delta.X) + math.abs(delta.Y)
            local viewport = workspace.CurrentCamera.ViewportSize
            local size = launcher.AbsoluteSize
            local newX = launcherStartPos.X.Offset + delta.X
            local newY = launcherStartPos.Y.Offset + delta.Y
            newX = math.clamp(newX, 0, viewport.X - size.X)
            newY = math.clamp(newY, -viewport.Y + size.Y, -10)
            launcher.Position = UDim2.new(0, newX, 1, newY)
        end
    end)
    connect(self, UserInputService.InputEnded, function(input)
        if launcherDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            launcherDragging = false
            if launcherMovedDist < 10 then self:ToggleWindow(self.Hidden) end
        end
    end)

    -- SPLASH
    local splash = create("ImageLabel", { Name = "IntroLogo", Size = UDim2.fromOffset(90, 90), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Theme.CardBg, Image = options.Logo or CONFIG.Logo, ScaleType = Enum.ScaleType.Crop, ZIndex = 60, Rotation = -120 }, screen)
    corner(splash, 100); stroke(splash, Theme.Accent)

    local function getViewport() return workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600) end
    
    -- MINIMIZE
    local function setMinimized(state)
        self.Minimized = state
        body.Visible = not state
        tabBar.Visible = not state
        plusBtn.Visible = not state
        if state then
            tween(main, 0.25, { Size = UDim2.new(main.Size.X.Scale, main.Size.X.Offset, 0, 40) })
            minBtn.Text = "+"
        else
            tween(main, 0.25, { Size = self.NormalSize })
            minBtn.Text = "−"
        end
    end
    connect(self, minBtn.Activated, function() setMinimized(not self.Minimized) end)

    -- TOGGLE WINDOW
    function self:ToggleWindow(show)
        if self.Destroyed or self._transitioning or self.Hidden == not show then return end
        self._transitioning = true; self.Hidden = not show
        if show then
            main.Visible = true
            self.UIScale.Scale = 0.6
            main.Position = UDim2.new(self.NormalPosition.X.Scale, self.NormalPosition.X.Offset, self.NormalPosition.Y.Scale, self.NormalPosition.Y.Offset + 30)
            tween(self.UIScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
            local tw = tween(main, 0.4, { BackgroundTransparency = CONFIG.Effects.GlassTransparency, Position = self.NormalPosition }, Enum.EasingStyle.Quint)
            if tw then tw.Completed:Wait(); self._transitioning = false end
        else
            tween(self.UIScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            local tw = tween(main, 0.25, { BackgroundTransparency = 1, Position = UDim2.new(self.NormalPosition.X.Scale, self.NormalPosition.X.Offset, self.NormalPosition.Y.Scale, self.NormalPosition.Y.Offset - 20) }, Enum.EasingStyle.Quint)
            if tw then tw.Completed:Wait(); if not self.Destroyed then main.Visible = false; self.UIScale.Scale = 1; self._transitioning = false end end
        end
    end

    task.spawn(function()
        task.wait(0.1)
        local target = Vector2.new(20 + 27, getViewport().Y - 20 - 27)
        local t = tween(splash, CONFIG.Animation.Intro, { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(48, 48), Rotation = 360 })
        if t then t.Completed:Wait() end
        if self.Destroyed then return end
        splash:Destroy(); launcher.Visible = true; self:ToggleWindow(true)
    end)

    -- WINDOW DRAG & RESIZE
    local dragging, dragStart, startPosition = false, nil, nil
    connect(self, header.InputBegan, function(input)
        if self.Destroyed or self.Hidden then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPosition = main.Position end
    end)
    
    connect(self, UserInputService.InputChanged, function(input)
        if self.Destroyed then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not self.Minimized then
                local delta = input.Position - dragStart
                main.Position = UDim2.fromOffset(startPosition.X.Offset + delta.X, startPosition.Y.Offset + delta.Y)
                self.NormalPosition = main.Position
            end
            if resizing and not self.Minimized then
                local delta = input.Position - resizeStart
                local newWidth = math.max(CONFIG.Window.MinimumWidth, startSize.X.Offset + delta.X)
                local newHeight = math.max(CONFIG.Window.MinimumHeight, startSize.Y.Offset + delta.Y)
                main.Size = UDim2.fromOffset(newWidth, newHeight)
                self.NormalSize = main.Size
            end
        end
    end)
    
    connect(self, UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false; resizing = false end
    end)

    -- KEYBIND TOGGLE (RightShift)
    connect(self, UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            self:ToggleWindow(self.Hidden)
        end
    end)

    function self:Notify(data) return Window.Notify(self, data) end
    function self:Destroy() return Window.Destroy(self) end
    function self:ConnectSearch() return Window.ConnectSearch(self) end
    return self
end

-- TAB SYSTEM (Fixed & Works perfectly)
function Window:CreateTab(options)
    assert(not self.Destroyed, "Window destroyed")
    options = options or {}
    local name = options.Name or "Tab"
    assert(not self.Tabs[name], "Tab already exists: " .. name)

    local tab = setmetatable({ Window = self, Name = name, Connections = {}, Components = {} }, Tab)
    
    -- Page Container (Strict clipping)
    tab.Page = create("Frame", { Name = "Page_" .. name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ClipsDescendants = true }, self.PageHolder)
    
    tab.LeftCol = create("ScrollingFrame", { Name = "LeftCol", Size = UDim2.new(0.5, -5, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ClipsDescendants = true }, tab.Page)
    create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tab.LeftCol)

    tab.RightCol = create("ScrollingFrame", { Name = "RightCol", Size = UDim2.new(0.5, -5, 1, 0), Position = UDim2.new(0.5, 5, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ClipsDescendants = true }, tab.Page)
    create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tab.RightCol)

    -- Tab Button
    tab.Button = create("TextButton", { Name = "Tab_" .. name, Size = UDim2.new(0, 120, 0, 28), BackgroundColor3 = Theme.CardBg, BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, ZIndex = 5 }, self.TabHolder)
    corner(tab.Button, 6); stroke(tab.Button, Theme.Stroke, 0.8)
    
    create("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1, Text = name, TextColor3 = Theme.SubText, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5 }, tab.Button)

    local closeBtn = create("TextButton", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -24, 0.5, -10), BackgroundTransparency = 1, Text = "×", TextColor3 = Theme.SubText, TextSize = 14, Font = Enum.Font.GothamBold, AutoButtonColor = false, ZIndex = 5 }, tab.Button)
    
    tab.Glow = create("Frame", { Size = UDim2.new(0.8, 0, 0, 2), Position = UDim2.new(0.5, 0, 1, 0), AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, tab.Button)
    corner(tab.Glow, 2)

    self.Tabs[name] = tab
    connect(tab, tab.Button.Activated, function() self:SelectTab(name) end)
    connect(tab, closeBtn.Activated, function() self:RemoveTab(name) end)
    if not self.ActiveTab then self:SelectTab(name) end
    
    -- อัปเดต CanvasSize ของ TabBar ให้สกรอลล์ได้หากมีแท็บเยอะ
    task.defer(function()
        if self.TabHolder then
            local layout = self.TabHolder:FindFirstChildOfClass("UIListLayout")
            if layout then
                self.TabHolder.CanvasSize = UDim2.new(0, layout.AbsoluteContentSize.X + 20, 0, 0)
            end
        end
    end)
    
    return tab
end

function Window:RemoveTab(name)
    if not self.Tabs[name] then return end
    if #self:GetTabNames() <= 1 then
        self:Notify({ Title = "Warning", Content = "ต้องมีอย่างน้อย 1 แท็บ", Duration = 2 })
        return
    end
    local tab = self.Tabs[name]
    for _, c in ipairs(tab.Connections) do c:Disconnect() end
    tab.Page:Destroy(); tab.Button:Destroy()
    self.Tabs[name] = nil
    if self.ActiveTab == name then
        self.ActiveTab = nil
        for tabName, _ in pairs(self.Tabs) do self:SelectTab(tabName); break end
    end
    task.defer(function()
        if self.TabHolder then
            local layout = self.TabHolder:FindFirstChildOfClass("UIListLayout")
            if layout then
                self.TabHolder.CanvasSize = UDim2.new(0, layout.AbsoluteContentSize.X + 20, 0, 0)
            end
        end
    end)
end

function Window:GetTabNames()
    local names = {}
    for name, _ in pairs(self.Tabs) do table.insert(names, name) end
    return names
end

function Window:SelectTab(name)
    if self.Destroyed or not self.Tabs[name] then return false end
    self.ActiveTab = name
    for tabName, tab in pairs(self.Tabs) do
        local active = tabName == name
        tab.Page.Visible = active
        tween(tab.Button, 0.2, { BackgroundTransparency = active and 0 or 0.7, BackgroundColor3 = active and Theme.Background or Theme.CardBg, TextColor3 = active and Theme.Text or Theme.SubText }, Enum.EasingStyle.Quint)
        local textLabel = tab.Button:FindFirstChildOfClass("TextLabel")
        if textLabel then tween(textLabel, 0.2, { TextColor3 = active and Theme.Text or Theme.SubText }) end
        tween(tab.Glow, 0.2, { BackgroundTransparency = active and 0 or 1 })
    end
    return true
end

