function Window:SelectTab(name)
    if self.Destroyed or not self.Tabs[name] then return end
    self:CloseDropdown()
    self.ActiveTab = name
    for tabName, tab in pairs(self.Tabs) do
        local active = tabName == name
        tab.Page.Visible = active
        tween(tab.Button, 0.18, {
            BackgroundColor3 = active and self.Theme.Accent or self.Theme.Panel,
            BackgroundTransparency = active and 0.55 or 0.82
        })
        tween(tab.Indicator, 0.18, {BackgroundTransparency = active and 0 or 1})
        local label = tab.Button:FindFirstChildOfClass("TextLabel")
        if label then
            tween(label, 0.18, {TextColor3 = active and self.Theme.Text or self.Theme.SubText})
        end
    end
end

local function targetColumn(tab, options)
    return options and options.Column == "Right" and tab.RightCol or tab.LeftCol
end

local function registerComponent(tab, frame, name)
    tab.ComponentOrder = tab.ComponentOrder + 1
    frame.LayoutOrder = tab.ComponentOrder
    frame:SetAttribute("HelloHubSearchName", tostring(name or ""))
    table.insert(tab.Components, frame)
    table.insert(tab.Window.ComponentObjects, frame)
    return frame
end

