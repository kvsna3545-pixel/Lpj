    corner(btn, 6); stroke(btn, Theme.Stroke, 0.5)
    local listening = false
    local connection
    local function setKey(key)
        currentKey = key; btn.Text = tostring(key); self.Window.Flags[flag] = key
        safeCallback(options.Callback, key)
    end
    connect(self, btn.Activated, function()
        if listening then return end
        listening = true; btn.Text = "Listening..."; btn.TextColor3 = Theme.Accent
        connection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton1 then
                local keyName = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name or input.UserInputType.Name
                setKey(keyName); listening = false; btn.TextColor3 = Theme.Text; connection:Disconnect()
            end
        end)
    end)
    self.Window.Flags[flag] = currentKey
    return { Get = function() return currentKey end, Set = function(_, key) setKey(key) end }
end

