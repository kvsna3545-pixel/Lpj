Main:AddToggle({
    Name = "Bhop Keep Speed (ไม่ตกสปีดตอนลง)",
    Default = true,
    Flag = "Evade_BhopKeep",
    Callback = function(v) S.BhopKeepSpeed = v end
})

-- ============ BHOP CORE ============
local Bhop = {
    Holding = false,
    LastJump = 0,
    AirTime = 0,
    GroundSpeed = 0,
}
local function IsGrounded(h, hrp)
    if not h or not hrp then return false end
    local st = h:GetState()
    return st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.Landing
        or h.FloorMaterial ~= Enum.Material.Air
end

-- กด Space
Conn(UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Space then Bhop.Holding = true end
end))
Conn(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then Bhop.Holding = false end
end))

-- Auto Jump + Speed Loop
Conn(RunService.Heartbeat:Connect(function(dt)
    if not S.Bhop then return end
    local c = Char() local h = Hum() local hrp = HRP()
    if not c or not h or not hrp or h.Health <= 0 then return end

    local shouldHop = false
    if S.BhopMode == "Auto Hop" then shouldHop = true
    elseif S.BhopMode == "Hold Space" then shouldHop = Bhop.Holding end
    -- Legit = ต้องกดเอง แต่ระบบช่วยเรื่องสปีดอย่างเดียว

    -- 1. บังคับสปีดตอน Bhop
    if S.BhopKeepSpeed then
        -- ถ้าอยู่พื้น ให้ดัน WalkSpeed ไป BhopSpeed
        -- ถ้าอยู่กลางอากาศ ให้รักษาความเร็วไม่ให้ตก
        if h.WalkSpeed < S.BhopSpeed then
            h.WalkSpeed = S.BhopSpeed
        end
    else
        h.WalkSpeed = S.BhopSpeed
    end

    -- 2. Strafe Assist - เลี้ยวแล้วได้สปีดเพิ่ม
    if S.BhopStrafe and h.FloorMaterial == Enum.Material.Air then
        local move = h.MoveDirection
        if move.Magnitude > 0 then
            local look = Camera.CFrame.LookVector
            local right = Camera.CFrame.RightVector
            local wish = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then wish += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then wish -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then wish -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then wish += right end
            if wish.Magnitude > 0 then
                wish = Vector3.new(wish.X, 0, wish.Z).Unit
                -- ดันไปตามทิศที่หัน + เก็บ momentum
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X + wish.X * S.BhopAirControl * S.BhopBoost,
                    hrp.AssemblyLinearVelocity.Y,
                    hrp.AssemblyLinearVelocity.Z + wish.Z * S.BhopAirControl * S.BhopBoost
                )
                -- กันสปีดเกินจนบิน
                local flat = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
                local maxFlat = S.BhopSpeed * 1.6
                if flat.Magnitude > maxFlat then
                    local clamped = flat.Unit * maxFlat
                    hrp.AssemblyLinearVelocity = Vector3.new(clamped.X, hrp.AssemblyLinearVelocity.Y, clamped.Z)
                end
            end
        end
    end

    -- 3. Auto Hop - แตะพื้นปุ๊บโดดปั๊บ
    if shouldHop and IsGrounded(h, hrp) then
        if tick() - Bhop.LastJump > 0.03 then
            Bhop.LastJump = tick()
            h:ChangeState(Enum.HumanoidStateType.Jumping)
            -- Boost เล็กน้อยตอนกระโดด ให้รู้สึกพุ่ง
            if S.BhopBoost > 0 then
                local vel = hrp.AssemblyLinearVelocity
                local flat = Vector3.new(vel.X, 0, vel.Z)
                if flat.Magnitude > 1 then
                    local add = flat.Unit * (S.BhopBoost * 1.2)
                    hrp.AssemblyLinearVelocity = Vector3.new(vel.X + add.X, vel.Y, vel.Z + add.Z)
                end
            end
        end
    end
end))

-- กัน WalkSpeed โดน Evade Speed ทับ: ถ้าเปิด Bhop ให้ Bhop ชนะ
Conn(RunService.RenderStepped:Connect(function()
    if S.Bhop and Alive() then
        local h = Hum()
        if h and h.WalkSpeed ~= S.BhopSpeed and S.BhopKeepSpeed then
            h.WalkSpeed = S.BhopSpeed
        end
    end
end))

