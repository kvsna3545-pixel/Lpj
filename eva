            v.P = 1250 v.Velocity = Vector3.zero v.Parent = r
            velocity = v
            local lastJump = os.clock()
            local rayP = RaycastParams.new() rayP.FilterType = Enum.RaycastFilterType.Exclude rayP.FilterDescendantsInstances = {c}
            if jump then h.Jump = true h:ChangeState(Enum.HumanoidStateType.Jumping) end
