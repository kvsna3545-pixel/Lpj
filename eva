    local function FindMap() local g = Workspace:FindFirstChild("Game") local m = g and g:FindFirstChild("Map") return m or Workspace:FindFirstChild("Map", true) end
    local function RestoreMap() for part, o in pairs(MapOriginal) do if part and part.Parent then Safe(function() part.Size = o.Size part.CFrame = o.CFrame end) end end end
    local function CaptureMap()
        RestoreMap() MapTarget = FindMap() MapParts, MapOriginal = {}, {}
        if not MapTarget then return false, "ไม่พบ Map" end
        for _, o in ipairs(MapTarget:GetDescendants()) do
            if o:IsA("BasePart") then MapParts[#MapParts+1] = o MapOriginal[o] = {Size = o.Size, CFrame = o.CFrame} end
        end
