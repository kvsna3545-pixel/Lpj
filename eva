    local EventESP_Gui, LineHolder_ESP, BoxHolder, LabelHolder = nil, nil, nil, nil
    local function GetESPOverlayParent() if gethui then local ok, h = pcall(gethui) if ok and h then return h end end if pcall(function() return CoreGui.Name end) then return CoreGui end return PlayerGui end
