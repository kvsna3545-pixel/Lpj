    local RescueBusy = false
    local function RescueDowned()
        if RescueBusy or not Interact then return end
        local c, mr = GetChar(), GetRoot()
        if not c or not mr then return end
        local targets = {}
        if PlayerFolder then
            for _, m in ipairs(PlayerFolder:GetChildren()) do
                if m:IsA("Model") and m ~= c then
                    local h = m:FindFirstChildWhichIsA("Humanoid", true)
                    local r = m:FindFirstChild("HumanoidRootPart", true) or m.PrimaryPart
                    if h and h.Health <= 0 and r then table.insert(targets, {model = m, humanoid = h, root = r, tag = GetTag(m), dist = (r.Position - mr.Position).Magnitude}) end
                end
            end
            table.sort(targets, function(a, b) return a.dist < b.dist end)
        end
        if #targets == 0 then Notify("ไม่พบผู้เล่นที่ล้ม") return end
        local orig = mr.CFrame
        RescueBusy = true
        task.spawn(function()
            local carried = false
            for _, t in ipairs(targets) do
                if LocalPlayer.Character ~= c then break end
                if not t.model.Parent or not t.humanoid.Parent or not t.root.Parent or t.humanoid.Health > 0 then continue end
                if not t.tag then continue end
                pcall(function() mr.CFrame = t.root.CFrame * CFrame.new(0, 0, 3) end)
                task.wait(0.2)
                if LocalPlayer.Character ~= c then break end
                if not t.model.Parent or t.humanoid.Health > 0 then continue end
                Safe(function() Interact:FireServer("Carry", t.tag) end)
                task.wait(3)
                local linked = false
                for _, d in ipairs(c:GetDescendants()) do
                    if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint") then
                        local p0 = d.Part0 or (d.Attachment0 and d.Attachment0.Parent)
                        local p1 = d.Part1 or (d.Attachment1 and d.Attachment1.Parent)
                        if p0 and p1 and ((p0:IsDescendantOf(c) and p1:IsDescendantOf(t.model)) or (p1:IsDescendantOf(c) and p0:IsDescendantOf(t.model))) then linked = true break end
                    end
                end
                if linked then carried = true break end
            end
            if LocalPlayer.Character == c and mr.Parent then mr.CFrame = orig end
            RescueBusy = false
            Notify(carried and "อุ้มสำเร็จ" or "ไม่มีเป้าหมาย")
        end)
    end
