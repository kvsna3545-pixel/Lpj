    local function ScanGameTimer()
        local PreviousText, LastChanged, Candidates, SelectedTimer = {}, {}, {}, nil
        while Enabled and TimerGui and TimerGui.Parent do
            pcall(function()
                local Now = os.clock() local FoundNow = {}
                for _, Object in ipairs(PlayerGui:GetDescendants()) do
                    if Object:IsA("TextLabel") and Object.Name == "Timer" and typeof(Object.Text) == "string" then
                        FoundNow[Object] = true
                        if PreviousText[Object] == nil then PreviousText[Object] = Object.Text LastChanged[Object] = Now
                        elseif PreviousText[Object] ~= Object.Text then PreviousText[Object] = Object.Text LastChanged[Object] = Now Candidates[Object] = {ChangedAt = Now} end
                        if LastChanged[Object] and Now - LastChanged[Object] <= StableTime then Candidates[Object] = Candidates[Object] or {ChangedAt = LastChanged[Object]} end
                    end
                end
                local Best, BestTime = nil, nil
                for Object, Info in pairs(Candidates) do
                    if FoundNow[Object] and Now - Info.ChangedAt <= StableTime then if not BestTime or Info.ChangedAt > BestTime then Best = Object BestTime = Info.ChangedAt end else Candidates[Object] = nil end
                end
                if Best then SelectedTimer = Best end
                if SelectedTimer and FoundNow[SelectedTimer] then TimerText.Text = SelectedTimer.Text StatusText.Text = "GAME TIMER // LIVE"
                else SelectedTimer = nil TimerText.Text = "--:--" StatusText.Text = "SEARCHING FOR GAME TIMER" end
            end)
            task.wait(ScanInterval)
        end
    end
