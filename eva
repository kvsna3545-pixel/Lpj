--  📚 LOADER
-- ══════════════════════════════════════════════════════════════
local function LoadHelloHub()
    local lastErr
    for _, url in ipairs(CONFIG.HelloHubURLs) do
        for attempt = 1, CONFIG.RetryPerURL do
            local ok, r = pcall(function()
                local src = game:HttpGet(url, true)
                if not src or #src < 100 then error("ไฟล์ว่าง/เล็กเกิน") end
                local orig = src
                src = src:gsub("(_TEST_MODE%s*=%s*)true", "%1false")
                src = src:gsub("(_TEST_MODE%s*=%s*)[Tt][Rr][Uu][Ee]", "%1false")
                return loadstring(src)()
            end)
            if ok and r and type(r) == "table" and r.CreateWindow then
                return r
            end
            lastErr = ok and "API ไม่ครบ" or tostring(r)
            if attempt < CONFIG.RetryPerURL then task.wait(CONFIG.RetryDelay) end
        end
    end
    return nil, lastErr
end

local HelloHub, loadErr = LoadHelloHub()
if not HelloHub then
    warn("[Evade] ❌ โหลด HelloHub ล้มเหลว: " .. tostring(loadErr))
    return
