        local Box = Instance.new("Frame") Box.Name = "ClockBox" Box.Size = UDim2.fromOffset(190, 78) Box.Position = UDim2.new(0.5, -95, 0, 14) Box.BackgroundColor3 = Color3.fromRGB(18, 18, 20) Box.BorderSizePixel = 0 Box.ClipsDescendants = true Box.Parent = TimerGui
