    local farmEnabled, farmGuardThread, farmCharacterConnection, farmPlatform, farmOriginCFrame, farmPlatformCFrame, farmToken = false, nil, nil, nil, nil, nil, 0
    local FARM_HEIGHT, FARM_IMAGE_ID = 1200, "rbxassetid://72855254938167"
    local function FarmNotify(text) pcall(function() Win:Notify({Title = "KRYVEX HUB", Content = text, Duration = 3}) end) end
    local function GetFarmRoot(character) character = character or LocalPlayer.Character if not character then return nil end return character:FindFirstChild("HumanoidRootPart") end
    local function CreateFarmPlatform(platformCFrame)
        if farmPlatform then farmPlatform:Destroy() farmPlatform = nil end
        local part = Instance.new("Part") part.Name = "KRYVEX_FarmTimePart" part.Size = Vector3.new(12, 1, 12) part.CFrame = platformCFrame part.Anchored = true part.CanCollide = true part.CanTouch = false part.CanQuery = false part.CastShadow = false part.Material = Enum.Material.SmoothPlastic part.Color = Color3.fromRGB(235, 235, 235) part.Transparency = 0.05 part.Parent = workspace
        local image = Instance.new("Decal") image.Name = "KRYVEX_FarmPlatformImage" image.Texture = FARM_IMAGE_ID image.Face = Enum.NormalId.Top image.Transparency = 0 image.Parent = part
        farmPlatform = part
    end
    local function MoveCharacterToFarm(character) if not farmPlatformCFrame then return false end local root = GetFarmRoot(character) if not root then return false end root.CFrame = farmPlatformCFrame + Vector3.new(0, 4, 0) root.AssemblyLinearVelocity = Vector3.zero root.AssemblyAngularVelocity = Vector3.zero return true end
    local function StopFarmTime(restorePosition)
        farmEnabled = false farmToken += 1
        if farmGuardThread then pcall(task.cancel, farmGuardThread) farmGuardThread = nil end if farmCharacterConnection then farmCharacterConnection:Disconnect() farmCharacterConnection = nil end if farmPlatform then farmPlatform:Destroy() farmPlatform = nil end
        if restorePosition and farmOriginCFrame then local root = GetFarmRoot() if root then root.CFrame = farmOriginCFrame root.AssemblyLinearVelocity = Vector3.zero root.AssemblyAngularVelocity = Vector3.zero end end
        farmOriginCFrame = nil farmPlatformCFrame = nil
    end
    local function StartFarmTime()
        local character = LocalPlayer.Character local root = GetFarmRoot(character)
        if not root then FarmNotify("ยังไม่พบตัวละคร ลองเปิดอีกครั้งหลังเกิดใหม่") return false end if farmEnabled then return true end
        farmEnabled = true farmOriginCFrame = root.CFrame farmPlatformCFrame = farmOriginCFrame + Vector3.new(0, FARM_HEIGHT, 0)
        CreateFarmPlatform(farmPlatformCFrame) MoveCharacterToFarm(character)
        farmToken += 1 local myToken = farmToken
        farmGuardThread = task.spawn(function() while farmEnabled and myToken == farmToken do local currentCharacter = LocalPlayer.Character local currentRoot = GetFarmRoot(currentCharacter) if currentRoot and farmPlatformCFrame then local safePosition = farmPlatformCFrame.Position + Vector3.new(0, 4, 0) if (currentRoot.Position - safePosition).Magnitude > 18 then MoveCharacterToFarm(currentCharacter) end end task.wait(0.5) end end)
        farmCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(characterAdded) task.delay(0.6, function() if farmEnabled and characterAdded == LocalPlayer.Character then MoveCharacterToFarm(characterAdded) end end) end)
        return true
    end
