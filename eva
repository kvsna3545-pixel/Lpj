    local AutoCarryRange = 25 local FlexFloatingHandle = nil local IsFlexing = false
    local function DoFlexSpinAndReCarry()
        local Character = LocalPlayer.Character if not Character or IsFlexing then return end
        local MyRoot = GetCarryRoot(Character) if not MyRoot then return end
        local Target, Tag = FindNearestDowned() if not Target or not Tag then return end
        local TargetRoot = GetCarryRoot(Target) if not TargetRoot then return end
        IsFlexing = true local OriginalAnchored = MyRoot.Anchored MyRoot.Anchored = true
        pcall(function() Interact:FireServer("Carry", Tag) end) task.wait(0.15)
        local FlyHeight, Radius, SpinDuration, Steps = 7, 12, 0.85, 12
        for Index = 1, Steps do
            if not TargetRoot or not TargetRoot.Parent then break end
            local CenterPos = TargetRoot.Position local Angle = (Index / Steps) * math.rad(360)
            local OffsetX = math.cos(Angle) * Radius local OffsetZ = math.sin(Angle) * Radius
            local GoalPos = CenterPos + Vector3.new(OffsetX, FlyHeight, OffsetZ)
            local TweenInfoConfig = TweenInfo.new(SpinDuration / Steps, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
            local GoalCFrame = CFrame.new(GoalPos, CenterPos)
            local Tween = TweenService:Create(MyRoot, TweenInfoConfig, { CFrame = GoalCFrame })
            Tween:Play() Tween.Completed:Wait()
        end
        if TargetRoot and TargetRoot.Parent then MyRoot.CFrame = TargetRoot.CFrame + Vector3.new(0, 0.2, 0) end
        MyRoot.Anchored = OriginalAnchored task.wait(0.08)
