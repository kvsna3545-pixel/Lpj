    local FogEnabled, OriginalFogStart, OriginalFogEnd, OriginalAtmospheres, AtmosphereAddedConnection = false, nil, nil, {}, nil
    local function EnableFogRemoval()
        if FogEnabled then return end
        FogEnabled = true OriginalFogStart = Lighting.FogStart OriginalFogEnd = Lighting.FogEnd OriginalAtmospheres = {}
        Lighting.FogStart = 0 Lighting.FogEnd = 1000000
        for _, Object in ipairs(Lighting:GetDescendants()) do if Object:IsA("Atmosphere") then OriginalAtmospheres[Object] = {Density = Object.Density, Haze = Object.Haze, Glare = Object.Glare} Object.Density = 0 Object.Haze = 0 Object.Glare = 0 end end
        AtmosphereAddedConnection = Lighting.DescendantAdded:Connect(function(Object) if FogEnabled and Object:IsA("Atmosphere") then OriginalAtmospheres[Object] = {Density = Object.Density, Haze = Object.Haze, Glare = Object.Glare} Object.Density = 0 Object.Haze = 0 Object.Glare = 0 end end)
    end
    local function RestoreFog()
        if not FogEnabled then return end
        FogEnabled = false if AtmosphereAddedConnection then AtmosphereAddedConnection:Disconnect() AtmosphereAddedConnection = nil end
        if OriginalFogStart ~= nil then Lighting.FogStart = OriginalFogStart end if OriginalFogEnd ~= nil then Lighting.FogEnd = OriginalFogEnd end
        for AtmosphereObject, Original in pairs(OriginalAtmospheres) do if AtmosphereObject.Parent and AtmosphereObject:IsDescendantOf(Lighting) then pcall(function() AtmosphereObject.Density = Original.Density AtmosphereObject.Haze = Original.Haze AtmosphereObject.Glare = Original.Glare end) end end
        OriginalAtmospheres = {} OriginalFogStart = nil OriginalFogEnd = nil
    end
