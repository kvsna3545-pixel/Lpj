    local WarpBotActive, WarpBotConnection, SavedCFrame, IsEscaping = false, nil, nil, false
    local function StartWarpBot()
        if WarpBotConnection then return end
        local LastCheck = 0
        WarpBotConnection = RunService.Heartbeat:Connect(function()
            if not WarpBotActive then return end
            local Now = os.clock() if Now - LastCheck < 0.05 then return end LastCheck = Now
            local Character = LocalPlayer.Character if not Character then return end
            local Root = Character:FindFirstChild("HumanoidRootPart") if not Root then return end
            if not IsEscaping then
                local Folder = workspace:FindFirstChild("Rigs") if not Folder then return end
                local NearestBot, NearestDistance = nil, 10
                for _, Rig in ipairs(Folder:GetChildren()) do
                    local Hitbox = Rig:FindFirstChild("Hitbox")
                    if Hitbox and Hitbox:IsA("BasePart") then
                        local Distance = (Hitbox.Position - Root.Position).Magnitude
                        if Distance <= NearestDistance then NearestDistance = Distance NearestBot = Rig end
                    end
                end
                if NearestBot then
                    SavedCFrame = Root.CFrame IsEscaping = true
                    Root.CFrame = SavedCFrame + Vector3.new(0, 120, 0) Root.AssemblyLinearVelocity = Vector3.zero
                end
                return
            end
            Root.AssemblyLinearVelocity = Vector3.zero
            if not SavedCFrame then IsEscaping = false return end
            local Folder = workspace:FindFirstChild("Rigs") if not Folder then return end
            local BotNear = false
            for _, Rig in ipairs(Folder:GetChildren()) do
                local Hitbox = Rig:FindFirstChild("Hitbox")
                if Hitbox and Hitbox:IsA("BasePart") and (Hitbox.Position - SavedCFrame.Position).Magnitude <= 12 then BotNear = true break end
            end
            if not BotNear then Root.CFrame = SavedCFrame SavedCFrame = nil IsEscaping = false end
        end)
    end
    local function StopWarpBot() if WarpBotConnection then WarpBotConnection:Disconnect() WarpBotConnection = nil end SavedCFrame = nil IsEscaping = false end
