    local RescueBusy, RescueDelay, RescueFloatingHandle = false, 3, nil
    local function RescueDownedPlayers()
        if RescueBusy then Win:Notify({Title = "KRYVEX HUB", Content = "กำลังช่วยผู้เล่นอยู่", Duration = 3}) return end
        local Character = LocalPlayer.Character if not Character then return end
        local Root = Character:FindFirstChild("HumanoidRootPart") or Character.PrimaryPart if not Root then return end
        local OriginCFrame = Root.CFrame
        local Folder = workspace:FindFirstChild("Players") if not Folder then return end
        local Targets = {}
        for _, Model in ipairs(Folder:GetChildren()) do
            if Model:IsA("Model") and Model ~= LocalPlayer.Character then
                local Humanoid = Model:FindFirstChildWhichIsA("Humanoid", true) local TRoot = Model:FindFirstChild("HumanoidRootPart", true) or Model.PrimaryPart
                if Humanoid and Humanoid.Health <= 0 and TRoot then
                    local Tag = Model:GetAttribute("Tag") or Model:GetAttribute("ID") or Model.Name
                    table.insert(Targets, {Model = Model, Humanoid = Humanoid, Root = TRoot, Tag = tonumber(Tag) or Tag, Distance = (TRoot.Position - Root.Position).Magnitude})
                end
            end
        end
        table.sort(Targets, function(A, B) return A.Distance < B.Distance end)
        if #Targets == 0 then Win:Notify({Title = "KRYVEX HUB", Content = "ไม่พบผู้เล่นที่เลือดเหลือ 0", Duration = 3}) return end
        RescueBusy = true
        task.spawn(function()
            local Carried = false
            for _, Info in ipairs(Targets) do
                if LocalPlayer.Character ~= Character then break end
                if not Info.Model.Parent or not Info.Humanoid.Parent or not Info.Root.Parent or Info.Humanoid.Health > 0 then continue end
                if Info.Tag == nil then continue end
                Win:Notify({Title = "KRYVEX HUB", Content = "กำลังไปหา: " .. Info.Model.Name, Duration = 3})
                pcall(function() Root.CFrame = Info.Root.CFrame * CFrame.new(0, 0, 3) end)
                task.wait(0.2) if LocalPlayer.Character ~= Character then break end
                if not Info.Model.Parent or Info.Humanoid.Health > 0 then continue end
                pcall(function() Interact:FireServer("Carry", Info.Tag) end)
                local Started = os.clock()
                while os.clock() - Started < RescueDelay do
                    if LocalPlayer.Character ~= Character then break end
                    local linked = false
                    for _, d in ipairs(Character:GetDescendants()) do
                        if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                            if (d.Part0 and d.Part0:IsDescendantOf(Info.Model) and d.Part1 and d.Part1:IsDescendantOf(Character)) or (d.Part1 and d.Part1:IsDescendantOf(Info.Model) and d.Part0 and d.Part0:IsDescendantOf(Character)) then linked = true break end
                        end
                    end
                    if linked then Carried = true break end
                    task.wait(0.15)
                end
                if Carried then break end
            end
            if LocalPlayer.Character == Character then Root.CFrame = OriginCFrame end
            RescueBusy = false
            Win:Notify({Title = "KRYVEX HUB", Content = Carried and "อุ้มสำเร็จ กำลังกลับจุดเดิม" or "ไม่มีเป้าหมายที่อุ้มสำเร็จ", Duration = 3})
        end)
    end
