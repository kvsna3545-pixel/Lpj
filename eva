    local ESPPlayers, ESPPlayer, ESPRunService = Players, LocalPlayer, RunService
    local ShowAllPlayers, ShowDownedPlayers, ShowBots = false, false, false
    local Visuals, OverlayGui, LineHolder, ProxyHolder, RenderConnection, ScanElapsed, SCAN_INTERVAL = {}, nil, nil, nil, nil, 0, 0.4
    local ESPColors = { Player = Color3.fromRGB(220, 220, 220), Downed = Color3.fromRGB(255, 220, 45), Bot = Color3.fromRGB(255, 65, 65) }
    local BOX_SIZE = Vector3.new(4, 5.5, 2)
    local function AnyESPEnabled() return ShowAllPlayers or ShowDownedPlayers or ShowBots end
    local function GetOverlayParent() if type(gethui) == "function" then local OK, Parent = pcall(gethui) if OK and Parent then return Parent end end local OK, Parent = pcall(function() return game:GetService("CoreGui") end) if OK and Parent then return Parent end return ESPPlayer:WaitForChild("PlayerGui") end
    local function EnsureOverlay()
        if OverlayGui and OverlayGui.Parent then return end
        local Parent = GetOverlayParent() local Old = Parent:FindFirstChild("HelloHub_VisualESP") if Old then Old:Destroy() end
        OverlayGui = Instance.new("ScreenGui") OverlayGui.Name = "HelloHub_VisualESP" OverlayGui.ResetOnSpawn = false OverlayGui.IgnoreGuiInset = true OverlayGui.DisplayOrder = 999 OverlayGui.Parent = Parent
        LineHolder = Instance.new("Folder") LineHolder.Name = "Lines" LineHolder.Parent = OverlayGui
        ProxyHolder = Instance.new("Folder") ProxyHolder.Name = "Boxes" ProxyHolder.Parent = OverlayGui
    end
    local function GetRoot(Model) if not Model then return nil end local Root = Model:FindFirstChild("HumanoidRootPart", true) or Model:FindFirstChild("Hitbox", true) if Root and Root:IsA("BasePart") then return Root end if Model:IsA("Model") and Model.PrimaryPart then return Model.PrimaryPart end return nil end
    local function GetHumanoid(Model) return Model and Model:FindFirstChildWhichIsA("Humanoid", true) end
    local function IsDowned(Model) local Humanoid = GetHumanoid(Model) if Humanoid and Humanoid.Health <= 0 then return true end for _, AttributeName in ipairs({"Downed", "IsDowned", "Knocked", "IsKnocked"}) do if Model:GetAttribute(AttributeName) == true then return true end if Humanoid and Humanoid:GetAttribute(AttributeName) == true then return true end end return false end
    local function MakeVisual(Model, Root, Kind, Label)
        EnsureOverlay() local Camera = workspace.CurrentCamera if not Camera then return nil end
        local Proxy = Instance.new("Part") Proxy.Name = "HelloHub_ESP_Proxy" Proxy.Size = BOX_SIZE Proxy.Transparency = 1 Proxy.Anchored = true Proxy.CanCollide = false Proxy.CanTouch = false Proxy.CanQuery = false Proxy.CastShadow = false Proxy.CFrame = Root.CFrame Proxy.Parent = Camera
        local Color = ESPColors[Kind]
        local Box = Instance.new("BoxHandleAdornment") Box.Name = "HelloHub_ESP_Box" Box.Adornee = Proxy Box.Size = BOX_SIZE Box.Color3 = Color Box.Transparency = 0.55 Box.AlwaysOnTop = true Box.ZIndex = 5 Box.Parent = ProxyHolder
        local Outline = Instance.new("SelectionBox") Outline.Name = "HelloHub_ESP_Outline" Outline.Adornee = Proxy Outline.Color3 = Color Outline.LineThickness = 0.05 Outline.SurfaceTransparency = 1 Outline.Parent = ProxyHolder
        local Billboard = Instance.new("BillboardGui") Billboard.Name = "HelloHub_ESP_Label" Billboard.Adornee = Proxy Billboard.Size = UDim2.fromOffset(180, 32) Billboard.StudsOffset = Vector3.new(0, 3.7, 0) Billboard.AlwaysOnTop = true Billboard.Parent = ProxyHolder
        local Text = Instance.new("TextLabel") Text.Name = "Label" Text.BackgroundTransparency = 1 Text.Size = UDim2.fromScale(1, 1) Text.Font = Enum.Font.GothamBold Text.Text = Label Text.TextColor3 = Color Text.TextSize = 14 Text.TextStrokeColor3 = Color3.new(0, 0, 0) Text.TextStrokeTransparency = 0.2 Text.TextWrapped = true Text.Parent = Billboard
        local Line = Instance.new("Frame") Line.Name = "HelloHub_ESP_Line" Line.AnchorPoint = Vector2.new(0.5, 0.5) Line.BackgroundColor3 = Color Line.BorderSizePixel = 0 Line.Visible = false Line.Parent = LineHolder
        return { Model = Model, Root = Root, Kind = Kind, Label = Label, Proxy = Proxy, Box = Box, Outline = Outline, Billboard = Billboard, Text = Text, Line = Line }
    end
    local function RemoveVisual(Model) local Item = Visuals[Model] if not Item then return end for _, Object in ipairs({Item.Proxy, Item.Box, Item.Outline, Item.Billboard, Item.Line}) do if Object then pcall(function() Object:Destroy() end) end end Visuals[Model] = nil end
    local function ClearVisuals() local Models = {} for Model in pairs(Visuals) do Models[#Models + 1] = Model end for _, Model in ipairs(Models) do RemoveVisual(Model) end end
    local function BuildTargets()
        local Targets = {}
        if ShowAllPlayers then for _, Player in ipairs(ESPPlayers:GetPlayers()) do if Player ~= ESPPlayer then local Character = Player.Character local Root = GetRoot(Character) if Character and Root then Targets[Character] = {Root = Root, Kind = "Player", Label = Player.Name} end end end end
        if ShowDownedPlayers then
            local PlayerFolder = workspace:FindFirstChild("Players") if PlayerFolder then for _, Model in ipairs(PlayerFolder:GetChildren()) do if Model:IsA("Model") and Model ~= ESPPlayer.Character and IsDowned(Model) then local Root = GetRoot(Model) if Root then Targets[Model] = {Root = Root, Kind = "Downed", Label = "ล้ม"} end end end end
            for _, Player in ipairs(ESPPlayers:GetPlayers()) do if Player ~= ESPPlayer and Player.Character and IsDowned(Player.Character) then local Root = GetRoot(Player.Character) if Root then Targets[Player.Character] = {Root = Root, Kind = "Downed", Label = "ล้ม"} end end end
        end
        if ShowBots then local Rigs = workspace:FindFirstChild("Rigs") if Rigs then for _, Rig in ipairs(Rigs:GetChildren()) do if Rig:IsA("Model") or Rig:IsA("Folder") then local Root = GetRoot(Rig) if Root and Root:IsA("BasePart") then Targets[Rig] = {Root = Root, Kind = "Bot", Label = "บอท"} end end end end end
        return Targets
    end
    local function SyncTargets()
        local Targets = BuildTargets()
        for Model in pairs(Visuals) do if not Targets[Model] or not Model.Parent then RemoveVisual(Model) end end
        for Model, Data in pairs(Targets) do
            local Item = Visuals[Model]
            if not Item then Item = MakeVisual(Model, Data.Root, Data.Kind, Data.Label) if Item then Visuals[Model] = Item end
            else Item.Root = Data.Root Item.Kind = Data.Kind Item.Label = Data.Label local Color = ESPColors[Data.Kind] Item.Box.Color3 = Color Item.Outline.Color3 = Color Item.Text.TextColor3 = Color Item.Text.Text = Data.Label Item.Line.BackgroundColor3 = Color end
        end
    end
    local function StopVisuals() if RenderConnection then RenderConnection:Disconnect() RenderConnection = nil end ClearVisuals() if OverlayGui then OverlayGui:Destroy() OverlayGui = nil LineHolder = nil ProxyHolder = nil end end
    local function UpdateVisuals(DeltaTime)
        if not AnyESPEnabled() then StopVisuals() return end
        ScanElapsed += DeltaTime if ScanElapsed >= SCAN_INTERVAL then ScanElapsed = 0 SyncTargets() end
        local Camera = workspace.CurrentCamera if not Camera then return end local TopCenter = Vector2.new(Camera.ViewportSize.X / 2, 0)
        for Model, Item in pairs(Visuals) do
            local Root = Item.Root if not Model.Parent or not Root or not Root.Parent then RemoveVisual(Model)
            else
                if Item.Proxy.Parent ~= Camera then Item.Proxy.Parent = Camera end Item.Proxy.CFrame = Root.CFrame
                local Position, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                if OnScreen and Position.Z > 0 then
                    local Target = Vector2.new(Position.X, Position.Y) local Difference = Target - TopCenter
                    Item.Line.Size = UDim2.fromOffset(Difference.Magnitude, 2) Item.Line.Position = UDim2.fromOffset((TopCenter.X + Target.X) / 2, (TopCenter.Y + Target.Y) / 2) Item.Line.Rotation = math.deg(math.atan2(Difference.Y, Difference.X)) Item.Line.Visible = true
                else Item.Line.Visible = false end
            end
        end
    end
    local function SetESPMode(Mode, Value)
        if Mode == "Players" then ShowAllPlayers = Value elseif Mode == "Downed" then ShowDownedPlayers = Value elseif Mode == "Bots" then ShowBots = Value end
        if not AnyESPEnabled() then StopVisuals() ScanElapsed = 0 return end
        EnsureOverlay() SyncTargets() if not RenderConnection then ScanElapsed = 0 RenderConnection = ESPRunService.RenderStepped:Connect(UpdateVisuals) end
