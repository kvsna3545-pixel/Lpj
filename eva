    -- Boost FPS
    local BoostFPSEnabled, BoostFPSGeneration, SavedProperties, WorkspaceAddedConnection, LightingAddedConnection = false, 0, {}, nil, nil
    local function RememberAndSet(Object, Property, NewValue)
        local Success, OriginalValue = pcall(function() return Object[Property] end) if not Success then return end
        local Properties = SavedProperties[Object] if not Properties then Properties = {} SavedProperties[Object] = Properties end
        if Properties[Property] == nil then Properties[Property] = OriginalValue end
        pcall(function() Object[Property] = NewValue end)
    end
    TabScreen:AddToggle({ Name = "บูสFPS", Default = false, Callback = function(Value)
        if Value then
            if BoostFPSEnabled then return end
            BoostFPSEnabled = true BoostFPSGeneration += 1 local Generation = BoostFPSGeneration
            RememberAndSet(Lighting, "FogStart", 0) RememberAndSet(Lighting, "FogEnd", 1000000)
            LightingAddedConnection = Lighting.DescendantAdded:Connect(function(Object) if BoostFPSEnabled and Object:IsA("Atmosphere") then RememberAndSet(Object, "Density", 0) RememberAndSet(Object, "Haze", 0) RememberAndSet(Object, "Glare", 0) end end)
            WorkspaceAddedConnection = workspace.DescendantAdded:Connect(function(Object) task.defer(function() if BoostFPSEnabled and Generation == BoostFPSGeneration then pcall(function() if Object:IsA("BasePart") then RememberAndSet(Object, "Material", Enum.Material.SmoothPlastic) RememberAndSet(Object, "Reflectance", 0) end end) end end) end)
            task.spawn(function() local Queue = workspace:GetChildren() local Index = 1 while BoostFPSEnabled and Generation == BoostFPSGeneration and Index <= #Queue do local Object = Queue[Index] Index += 1 if Object then pcall(function() if Object:IsA("BasePart") then RememberAndSet(Object, "Material", Enum.Material.SmoothPlastic) RememberAndSet(Object, "Reflectance", 0) end end) for _, Child in ipairs(Object:GetChildren()) do Queue[#Queue + 1] = Child end end if Index % 80 == 0 then task.wait(0.03) end end end)
        else
            if not BoostFPSEnabled then return end
            BoostFPSEnabled = false BoostFPSGeneration += 1
            if WorkspaceAddedConnection then WorkspaceAddedConnection:Disconnect() WorkspaceAddedConnection = nil end if LightingAddedConnection then LightingAddedConnection:Disconnect() LightingAddedConnection = nil end
            for Object, Properties in pairs(SavedProperties) do if Object == Lighting or Object.Parent then for Property, OriginalValue in pairs(Properties) do pcall(function() Object[Property] = OriginalValue end) end end end
            SavedProperties = {}
        end
    end })
