    local IsCarrying, LastCarryTime, CARRY_COOLDOWN = false, 0, 1.5
    local function GetCarryRoot(Model) return Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart end
    local function GetCarryHumanoid(Model) return Model:FindFirstChildOfClass("Humanoid") end
    local function GetObjectTag(Object) local Tag = Object:GetAttribute("Tag") or Object:GetAttribute("ID") or Object.Name return tonumber(Tag) or Tag end
    local function FindNearestDowned()
        local Character = LocalPlayer.Character if not Character then return nil, nil end
        local MyRoot = GetCarryRoot(Character) if not MyRoot then return nil, nil end
        local Target, TargetTag, Distance = nil, nil, AutoCarryRange
        for _, Object in ipairs(PlayerFolder:GetChildren()) do
            if Object ~= Character and Object.Name ~= LocalPlayer.Name then
                local Humanoid = GetCarryHumanoid(Object) local Root = GetCarryRoot(Object) local Tag = GetObjectTag(Object)
                if Humanoid and Root and Tag and Humanoid.Health <= 0 then
                    local CurrentDistance = (MyRoot.Position - Root.Position).Magnitude
                    if CurrentDistance <= Distance then Distance = CurrentDistance Target = Object TargetTag = Tag end
                end
            end
        end
        return Target, TargetTag
    end
    local function DoAutoCarry()
        if IsCarrying then
            if AutoCarryTargetObject and AutoCarryTargetObject.Parent then local Humanoid = GetCarryHumanoid(AutoCarryTargetObject) if Humanoid and Humanoid.Health <= 0 then return end end
            IsCarrying = false AutoCarryTargetObject = nil
        end
        if tick() - LastCarryTime < CARRY_COOLDOWN then return end
        local Target, Tag = FindNearestDowned()
        if Target and Tag then IsCarrying = true AutoCarryTargetObject = Target LastCarryTime = tick() pcall(function() Interact:FireServer("Carry", Tag) end) end
    end
    local function StartAutoCarry() if AutoCarryConnection then AutoCarryConnection:Disconnect() AutoCarryConnection = nil end AutoCarryConnection = RunService.Heartbeat:Connect(function() if not AutoCarryEnabled then return end DoAutoCarry() end) end
    local function StopAutoCarry() if AutoCarryConnection then AutoCarryConnection:Disconnect() AutoCarryConnection = nil end AutoCarryTargetObject = nil IsCarrying = false end
