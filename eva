--  🧠 HELPERS
-- ══════════════════════════════════════════════════════════════
local function Safe(fn, ...)
    local ok, r = pcall(fn, ...)
    if not ok then warn("[Evade] Safe:", r) end
    return ok and r or nil
end
local function GetChar() return LocalPlayer.Character end
local function GetRoot() local c = GetChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHum()  local c = GetChar() return c and c:FindFirstChildOfClass("Humanoid") end
local function GetTag(o)
    if not o then return nil end
    local t = o:GetAttribute("Tag") or o:GetAttribute("ID") or o.Name
    return tonumber(t) or t
end
local function ObjPos(o)
    if not o or not o.Parent then return nil end
    if o:IsA("Model") then local ok, cf = pcall(o.GetPivot, o) return ok and cf.Position or nil
    elseif o:IsA("BasePart") then return o.Position end
    return nil
end

