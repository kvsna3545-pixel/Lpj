    EventESP_Gui = Instance.new("ScreenGui") EventESP_Gui.Name = "HelloHub_EventESP" EventESP_Gui.ResetOnSpawn = false EventESP_Gui.IgnoreGuiInset = true EventESP_Gui.DisplayOrder = 999 EventESP_Gui.Parent = espParent
    LineHolder_ESP = Instance.new("Folder", EventESP_Gui) BoxHolder = Instance.new("Folder", EventESP_Gui) LabelHolder = Instance.new("Folder", EventESP_Gui)
    local function newESP(opts)
        local M = {enabled = false, items = {}, lastScan = 0, scanning = false, addConn = nil}
        local wordSet = {} for _, w in ipairs(opts.words or {}) do wordSet[string.lower(w)] = true wordSet[string.lower(w) .. "s"] = true end
        local function isMatch(inst)
            if not inst:IsA("Model") then return false end
            local name = inst.Name local sp = string.gsub(name, "(%l)(%u)", "%1 %2") sp = string.gsub(sp, "(%u)(%u%l)", "%1 %2") sp = string.gsub(sp, "[^%a]", " ")
            local hasWord = false for word in string.gmatch(sp, "%S+") do if wordSet[string.lower(word)] then hasWord = true break end end
            if not hasWord then return false end
            if Players:GetPlayerFromCharacter(inst) then return false end
            if LocalPlayer.Character and inst:IsDescendantOf(LocalPlayer.Character) then return false end
            return inst:FindFirstChildWhichIsA("BasePart", true) ~= nil
        end
        local function removeObj(m) local it = M.items[m] if it then it.box:Destroy() it.line:Destroy() it.label:Destroy() M.items[m] = nil end end
        local function addObj(m)
            if M.items[m] then return end
            local p = m.Parent while p and p ~= Workspace do if M.items[p] then return end p = p.Parent end
            for other in pairs(M.items) do if other:IsDescendantOf(m) then removeObj(other) end end
            local box = Instance.new("BoxHandleAdornment") box.Color3 = BLUE box.Transparency = BOX_TRANSPARENCY box.AlwaysOnTop = true box.ZIndex = 5 box.Visible = false box.Parent = BoxHolder
            local line = Instance.new("Frame") line.AnchorPoint = Vector2.new(0.5, 0.5) line.BackgroundColor3 = BLUE line.BorderSizePixel = 0 line.Visible = false line.Parent = LineHolder_ESP
            local label = Instance.new("TextLabel") label.AnchorPoint = Vector2.new(0.5, 1) label.Size = UDim2.fromOffset(220, 36) label.BackgroundTransparency = 1 label.TextColor3 = BLUE label.TextStrokeTransparency = 0 label.TextStrokeColor3 = Color3.new(0,0,0) label.Font = Enum.Font.GothamBold label.TextSize = 14 label.TextYAlignment = Enum.TextYAlignment.Bottom label.Visible = false label.Parent = LabelHolder
            M.items[m] = {box = box, line = line, label = label, adornee = nil}
        end
        local function scan()
            if M.scanning then return end M.scanning = true M.lastScan = os.clock()
            task.spawn(function() local list = Workspace:GetDescendants() for i, d in ipairs(list) do if not M.enabled then break end if isMatch(d) then addObj(d) end if i % 3000 == 0 then task.wait() end end M.scanning = false end)
        end
        function M.start() if M.enabled then return end M.enabled = true if opts.finder then M.lastScan = 0 else scan() M.addConn = Workspace.DescendantAdded:Connect(function(d) if isMatch(d) then addObj(d) end end) end end
        function M.stop() M.enabled = false if M.addConn then M.addConn:Disconnect() M.addConn = nil end for m in pairs(M.items) do removeObj(m) end end
        function M.render(top, myPos)
            if not M.enabled then return end
            local now = os.clock()
            if opts.finder then if now - M.lastScan >= POLL_VISUAL then M.lastScan = now for _, inst in ipairs(opts.finder()) do addObj(inst) end end
            elseif now - M.lastScan > RESCAN_EVERY then scan() end
            for obj, it in pairs(M.items) do
                if not obj.Parent or not obj:IsDescendantOf(Workspace) then removeObj(obj)
                else
                    local ok, cf, size, ad
                    if obj:IsA("Model") then ok, cf, size = pcall(obj.GetBoundingBox, obj) if not it.adornee or not it.adornee:IsDescendantOf(obj) then it.adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end ad = it.adornee
                    else ok, cf, size = true, obj.CFrame, obj.Size ad = obj end
                    if ok and ad then
                        it.box.Adornee = ad it.box.Size = size it.box.CFrame = ad.CFrame:ToObjectSpace(cf) it.box.Visible = true
                        local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(cf.Position)
                        if onScreen and pos.Z > 0 then
                            local diff = Vector2.new(pos.X, pos.Y) - top
                            it.line.Size = UDim2.fromOffset(diff.Magnitude, LINE_THICKNESS) it.line.Position = UDim2.fromOffset((top.X + pos.X) / 2, (top.Y + pos.Y) / 2) it.line.Rotation = math.deg(math.atan2(diff.Y, diff.X)) it.line.Visible = true
                            local above = workspace.CurrentCamera:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y / 2 + 1, 0))
                            local dist = myPos and math.floor((cf.Position - myPos).Magnitude) or nil
                            it.label.Text = obj.Name .. "\n" .. (dist and (dist .. " studs") or "?") it.label.Position = UDim2.fromOffset(above.X, above.Y) it.label.Visible = true
                        else it.line.Visible = false it.label.Visible = false end
                    end
                end
            end
        end
        return M
    end
