    local Enabled, TimerGui, TimerText, StatusText, BorderGradient, RenderConnection, WorkerThread = false, nil, nil, nil, nil, nil, nil
    local ScanInterval, StableTime = 0.25, 2
    local function DestroyClock()
        if RenderConnection then RenderConnection:Disconnect() RenderConnection = nil end
        if WorkerThread then pcall(task.cancel, WorkerThread) WorkerThread = nil end
        if TimerGui then TimerGui:Destroy() TimerGui = nil end
        TimerText, StatusText, BorderGradient = nil, nil, nil
    end
    local function CreateClock()
        local OldGui = PlayerGui:FindFirstChild("HelloHub_RoundTimer") if OldGui then OldGui:Destroy() end
        TimerGui = Instance.new("ScreenGui") TimerGui.Name = "HelloHub_RoundTimer" TimerGui.ResetOnSpawn = false TimerGui.IgnoreGuiInset = true TimerGui.DisplayOrder = 100 TimerGui.Parent = PlayerGui
        local Box = Instance.new("Frame") Box.Name = "ClockBox" Box.Size = UDim2.fromOffset(190, 78) Box.Position = UDim2.new(0.5, -95, 0, 14) Box.BackgroundColor3 = Color3.fromRGB(18, 18, 20) Box.BorderSizePixel = 0 Box.ClipsDescendants = true Box.Parent = TimerGui
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 10)
